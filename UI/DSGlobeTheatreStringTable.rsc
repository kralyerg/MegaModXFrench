		{ String _name = "EnableWorkDSGlobeTheatreTip";	String _text = "Activer ou désactiver l'utilisation de ce théâtre."; }
		{ String _name = "DisableWorkDSGlobeTheatre";	String _text = "Le théâtre est fermé"; }
		{ String _name = "workPlaceDSGlobeTheatreTxt";	String _text = "Au Théâtre du Globe, les artistes divertissent et procurent du bonheur aux citoyens, gagnant une petite quantité d'argent."; }
		
		{ String _name = "ProfessionPerformer";				String _text = "Artiste"; }
