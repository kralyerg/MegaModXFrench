		{ String _name = "DSGlobeTheatreLwr";		String _text = "théâtre du globe"; }
		{ String _name = "DSGlobeTheatreTip";		String _text = "Inspiré du Globe Theatre de Shakespeare. Employez des artistes pour travailler au théâtre, ils procureront du bonheur aux citoyens et gagneront une petite quantité d'argent. La construction nécessite 610 de travail. Un seul Théâtre du Globe peut être construit dans une ville."; }
		
		
