	// ------------ New Egypt Starting Conditions ---------------------------
		{ String _name = "EgyptEasyName";		String _text = "Égypte - Facile"; }
		{ String _name = "EgyptEasyDesc";		String _text = "Une partie Facile standard avec uniquement des palmiers. Une partie facile commence avec six familles. Une grande quantité de vêtements, de nourriture, de bois de chauffage, de matériaux de construction et d'outils est fournie. Les maisons et les zones de stockage ont déjà été construites. Des graines pour les champs et les vergers sont disponibles, ainsi qu'un troupeau de bétail."; }

		{ String _name = "EgyptMediumName";		String _text = "Égypte - Moyen"; }
		{ String _name = "EgyptMediumDesc";		String _text = "Une partie Moyenne standard avec uniquement des palmiers. Une partie moyenne commence avec cinq familles. Des vêtements, de la nourriture, du bois de chauffage, des outils et des matériaux de construction sont fournis. Une grange de stockage a déjà été construite. Quelques graines pour les champs et les vergers sont disponibles."; }

		{ String _name = "EgyptHardName";		String _text = "Égypte - Difficile"; }
		{ String _name = "EgyptHardDesc";		String _text = "Une partie Difficile standard avec uniquement des palmiers. Une partie difficile commence avec quatre familles. Une petite quantité de vêtements, de nourriture, de bois de chauffage et d'outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

		{ String _name = "EgyptAEName";			String _text = "Égypte - Adam et Eve"; }
		{ String _name = "EgyptAEDesc";			String _text = "Une partie Adam et Eve standard avec uniquement des palmiers. Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucune graine ni aucun bétail n'est disponible au depart - vous devrez survivre et tout acquérir."; }

