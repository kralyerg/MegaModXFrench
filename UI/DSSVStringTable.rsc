	{ String _name = "DSSVGathererSingleLwr";	String _text = "cueillir avec un panier"; }
	{ String _name = "DSSVGathererSingleTip";	String _text = "Utilisez un panier de cueillette pour définir une zone où un cueilleur récoltera des aliments sauvages (racines, baies, champignons et oignons). Nécessite 0 travail pour être construit. Petit rayon (13)."; }
