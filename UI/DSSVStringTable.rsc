		{ String _name = "HardName";			String _text = "Difficile"; }
		{ String _name = "HardDesc";			String _text = "Une partie difficile commence avec quatre familles. Une petite quantité de vêtements, 
																de nourriture, de bois de chauffage et d'outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

		{ String _name = "MediumName";			String _text = "Moyen"; }
		{ String _name = "MediumDesc";			String _text = "Une partie moyenne commence avec cinq familles. Des vêtements, 
																de la nourriture, du bois de chauffage, des outils et des matériaux de construction sont fournis. Une grange de stockage a
																déjà été construite.	Quelques graines pour les champs et les vergers sont disponibles."; }

		{ String _name = "EasyName";			String _text = "Facile"; }
		{ String _name = "EasyDesc";			String _text = "Une partie facile commence avec six familles. Une grande quantité de vêtements, 
																de nourriture, de bois de chauffage, de matériaux de construction et d'outils est fournie. Les maisons et zones de stockage 
																ont déjà été construites. Des graines pour les champs et les vergers sont disponibles ainsi qu'un troupeau de bétail."; }

		{ String _name = "DSSVEasyCropsName";		String _text = "Facile-Cultures [DSSV]"; }
		{ String _name = "DSSVEasyCropsDesc";		String _text = "Une partie facile, avec toutes les graines de cultures. Commence avec six familles. 1600 nourriture, 30 vêtements, 30 outils, 220 bois de chauffage,
																	120 bois, 50 pierre, 30 fer. Une grange de stockage DSSV a déjà été construite. AUCUNE MAISON CONSTRUITE. Aucun bétail."; }
		
		{ String _name = "DSSVEasyOrchName";		String _text = "Facile-Vergers [DSSV]"; }
		{ String _name = "DSSVEasyOrchDesc";		String _text = "Une partie facile, avec toutes les graines de verger. Commence avec six familles. 1600 nourriture, 30 vêtements, 30 outils, 220 bois de chauffage,
																	120 bois, 50 pierre, 30 fer. Une grange de stockage DSSV a déjà été construite. AUCUNE MAISON CONSTRUITE. Aucun bétail."; }
		
		{ String _name = "DSSVEasyFarmersName";		String _text = "Facile-Fermiers [DSSV]"; }
		{ String _name = "DSSVEasyFarmersDesc";		String _text = "Une partie facile, avec quelques graines pour les cultures et les vergers, et éventuellement un ou deux grands troupeaux de bétail. Commence avec six familles. 1600 nourriture, 30 vêtements, 30 outils, 220 bois de chauffage,
																	120 bois, 50 pierre, 30 fer. Une grange de stockage DSSV a déjà été construite. AUCUNE MAISON CONSTRUITE."; }

		{ String _name = "DSSVEasyAnimalsName";		String _text = "Facile-Éleveur [DSSV]"; }
		{ String _name = "DSSVEasyAnimalsDesc";		String _text = "Une partie facile, avec la plupart du bétail. Commence avec six familles. 1600 nourriture, 30 vêtements, 30 outils, 220 bois de chauffage,
																	120 bois, 50 pierre, 30 fer. Une grange de stockage DSSV a déjà été construite. AUCUNE MAISON CONSTRUITE. Aucune graine."; }
		
		{ String _name = "DSSVEasyName";		String _text = "Facile [DSSV]"; }
		{ String _name = "DSSVEasyDesc";		String _text = "Une partie facile commence avec six familles. 2400 nourriture, 50 outils, 50 vêtements, 400 bois de chauffage,
																150 bois, 70 pierre, 50 fer. Les maisons et zones de stockage DSSV ont déjà été construites.
																jusqu'à 2 graines de cultures et 2 graines de verger sont disponibles ainsi qu'1 troupeau de bétail."; }
																
		{ String _name = "DSSVMediumName";		String _text = "Moyen [DSSV]"; }
		{ String _name = "DSSVMediumDesc";		String _text = "Une partie moyenne commence avec cinq familles. 1600 nourriture, 30 vêtements, 30 outils, 220 bois de chauffage,
																120 bois, 50 pierre, 30 fer. Une grange de stockage DSSV a déjà été construite.
																jusqu'à 2 graines de cultures et 1 graine de verger sont disponibles. Aucun bétail."; }
																
		{ String _name = "DSSVHardName";		String _text = "Très Difficile [DSSV]"; }
		{ String _name = "DSSVHardDesc";		String _text = "Une partie très difficile commence avec quatre familles. Un chariot de stockage, avec 750 nourriture, 10 vêtements,
																10 outils, 100 bois de chauffage. Aucune graine ni bétail n'est disponible."; }
	
		{ String _name = "DSSVStrandedSeedsName";	String _text = "Naufragés avec graines [DSSV]"; }
		{ String _name = "DSSVStrandedSeedsDesc";	String _text = "Une partie Naufragés commence avec une famille échouée dans les terres bannies. Les deux adultes sont éduqués. Un chariot de stockage avec 300 nourriture, 3 vêtements,
																	3 outils, 2 cuirs et 20 bois de chauffage est fourni. Un petit nombre de graines est disponible. Aucun bétail n'est disponible."; }
																	
		{ String _name = "DSSVStrandedName";		String _text = "Naufragés [DSSV]"; }
		{ String _name = "DSSVStrandedDesc";		String _text = "Une partie Naufragés commence avec une famille échouée dans les terres bannies. Les deux adultes sont éduqués. Un chariot de stockage avec 300 nourriture, 3 vêtements,
																	3 outils, 2 cuirs et 20 bois de chauffage est fourni. Aucune graine ni bétail n'est disponible."; }
	
		{ String _name = "DSSVStrandedHardName";	String _text = "Naufragés Difficile [DSSV]"; }
