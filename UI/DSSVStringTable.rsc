{
	Entry _strings
	[
	{ String _name = "Valleys";	String _text = "Vallées"; }
	{ String _name = "Mountains";	String _text = "Montagnes"; }
	{ String _name = "DSSVLake";	String _text = "Lac [DSSV]"; }
	{ String _name = "DSSVPlains";	String _text = "Plaine avec Lac[DSSV]"; }
	{ String _name = "DSSVPlainsNoLakes";	String _text = "Plaine sans Lac[DSSV]"; }
	{ String _name = "DSSVMountainLakes";	String _text = "Lacs de montagne [DSSV]"; }
	{ String _name = "DSSVTerrainDesc";	String _text = "[DSSV] = DS Small Village v2 - Nouvelles conditions de départ et infos sur les nouveaux types de terrain :
			Lac - Un grand lac central, avec une petite quantité de terre utilisable autour du bord.
			Plaine avec Lac - Une carte plate de type 'Plaines', avec une rivière, ainsi qu'un lac de taille modeste.
			Plaine sans lac -- comme ci-dessus - Une carte de plaines plate, mais cette fois, sans aucun lac.
			Lacs de montagne - Une carte difficile, presque inhabitable, dominée par de grandes chaînes de montagnes
			et de profonds lacs semblables à des 'lochs'."; }
	]
}

