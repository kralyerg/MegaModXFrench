	{ String _name = "DSSVWatersEdgeFishingLwr";	String _text = "pêche au bord de l'eau"; }
	{ String _name = "DSSVWatersEdgeFishingTip";	String _text = "Utilisez de l'équipement de pêche pour qu'un pêcheur attrape du poisson directement dans les lacs, rivières et ruisseaux. Placez sur un bord en pente, avec la case vide orientée vers l'eau. Nécessite 0 travail pour être construit."; }
	{ String _name = "DSSVGathererMenuTip";	String _text = "Cueillette de nourriture en forêt. Options de rayon petit, moyen et grand. Emploie des cueilleurs pour récolter des aliments sauvages (racines, baies, champignons et oignons)."; }
	{ String _name = "DSSVGathererSmall";	String _text = "Cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererSmallLwr";	String _text = "cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererSmallTip";	String _text = "Définissez une zone à petit rayon, et construisez un petit abri pour jusqu'à 3 cueilleurs qui récolteront des aliments sauvages (racines, baies, champignons et oignons). Nécessite 21 travail pour être construit. Petit rayon (21)."; }
	{ String _name = "DSSVGatherer";	String _text = "Cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererLwr";	String _text = "cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererTip";	String _text = "Définissez une zone, et construisez un petit abri pour jusqu'à 4 cueilleurs qui récolteront des aliments sauvages (racines, baies, champignons et oignons). Nécessite 34 travail pour être construit. Rayon moyen (27)."; }
	{ String _name = "DSSVGathererLarge";	String _text = "Gd cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererLargeLwr";	String _text = "grand cueilleur de nourriture en forêt"; }
	{ String _name = "DSSVGathererLargeTip";	String _text = "Définissez une zone à grand rayon, et construisez un petit abri pour jusqu'à 5 cueilleurs qui récolteront des aliments sauvages (racines, baies, champignons et oignons). Nécessite 55 travail pour être construit. Grand rayon (39)."; }
