		{ String _name = "HardName";			String _text = "Difficile"; }
		{ String _name = "HardDesc";			String _text = "Une partie difficile commence avec quatre familles. Une petite quantité de vêtements, 
																de nourriture, de bois de chauffage et d'outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

		{ String _name = "MediumName";			String _text = "Moyen"; }
		{ String _name = "MediumDesc";			String _text = "Une partie moyenne commence avec cinq familles. Des vêtements, 
