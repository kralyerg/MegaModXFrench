StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "Tours Styth - Tours de guet pour votre ville. Une fois pourvues en personnel, elles généreront une sélection aléatoire de biens en confisquant des objets volés à ce que l'on ne peut que supposer être des bandits ? ou des extraterrestres...."; }
	
		{ String _name = "DSStythTower";					String _text = "Tour Styth"; }
		{ String _name = "DSStythTowerLwr";					String _text = "tour styth"; }
		{ String _name = "DSStythTowerTip";					String _text = "Tour Styth, la tour de guet Styth originale qui génère un petit nombre aléatoire d'objets pour la ville (Alcool, Outils, Vêtements, Nourriture, Etc) en débarrassant la zone des bandits, la ville reçoit le butin. Emploie 1 à 2 Gardes du Village. Vous ne pouvez construire qu'1 Tour Styth par carte."; }
		
		{ String _name = "DSNewStythTower";					String _text = "Nouvelle Tour Styth"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "nouvelle tour styth"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "Nouvelle Tour Styth, une Tour Styth mise à jour, légèrement plus grande, cette tour de guet génère un meilleur nombre d'objets aléatoires pour la ville (Alcool, Outils, Vêtements, Nourriture, Précieux, Etc) en débarrassant la zone des bandits, la ville reçoit le butin. Emploie 2 à 3 Gardes du Village. Vous ne pouvez construire qu'1 Nouvelle Tour Styth par carte."; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "Garde du Village"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "Un Garde du Village est employé pour servir et protéger la ville. Ils sont employés dans les Tours de Guet. Il est admis que leur taux de mortalité est plus élevé que celui des autres métiers."; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "est mort de blessures graves, après avoir protégé la ville des bandits."; }
		
		
		{ String _name = "Gold";			String _text = "Or"; }
		{ String _name = "Silver";			String _text = "Argent"; }
		{ String _name = "Gems";			String _text = "Gemmes"; }
		
		{ String _name = "Lumber";			String _text = "Planches"; }
	]
