		{ String _name = "cc17Windmill";				String _text = "Moulin à vent urbain"; }
		{ String _name = "cc17WindmillLwr";				String _text = "moulin à vent urbain"; }
		{ String _name = "cc17WindmillTip";				String _text = "Le moulin à vent urbain est un grand bâtiment capable de fabriquer de la farine à partir de divers types de céréales. C'est le moulin à vent le plus rapide et le plus efficace disponible."; }

		{ String _name = "Watermill";					String _text = "Moulin à eau"; }
		{ String _name = "WatermillLwr";				String _text = "moulin à eau"; }
		{ String _name = "WatermillTip";				String _text = "Un moulin à eau fabrique de la farine à partir de céréales, et doit être construit sur une rive. La farine n'est pas comestible et doit soit aller à une boulangerie pour être préparée en nourriture, soit être échangée. Touche F pour changer d'apparence."; }

		{ String _name = "Windmill";					String _text = "Grand moulin à vent"; }
		{ String _name = "WindmillLwr";					String _text = "grand moulin à vent"; }
		{ String _name = "WindmillTip";					String _text = "Un grand moulin à vent fabrique de la farine à partir de céréales. La farine n'est pas comestible et doit soit aller à une boulangerie pour être préparée en nourriture, soit être échangée."; }

		{ String _name = "StoneWindmill";				String _text = "Petit moulin à vent"; }
		{ String _name = "StoneWindmillLwr";			String _text = "Petit moulin à vent"; }
		{ String _name = "StoneWindmillTip";			String _text = "Un petit moulin à vent fabrique de la farine à partir de céréales. La farine n'est pas comestible et doit soit aller à une boulangerie pour être préparée en nourriture, soit être échangée. Ce moulin produit la farine plus lentement que le grand moulin à vent."; }


		{ String _name = "ProfessionMiller";			String _text = "Meunier"; }
		{ String _name = "ProfessionMillerTip";			String _text = "Le meunier fait fonctionner le moulin et broie les céréales en farine."; }
		{ String _name = "ProfessionMillerDeath";		String _text = "a été écrasé dans la roue à eau en moulant."; }

		{ String _name = "WindmillItemsTip";					String _text = "Moulins à vent et moulins à eau"; }


