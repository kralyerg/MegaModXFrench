		{ String _name = "BackAlleyLwr";				String _text = "ruelle"; }
		{ String _name = "BackAlleyTip";				String _text = "Une ruelle ou des affaires peuvent se conclure et certains besoins être satisfaits. Fournit toutes sortes d'objets de contrebande."; }

