		{ String _name = "CCcustom1Name";					String _text = "Colonial Charter"; }
		{ String _name = "CCcustom1Desc";					String _text = "Description de Colonial Charter à insérer ici"; }

		{ String _name = "CCAdamEve";						String _text = "[CC] Adam et Ève"; }
		{ String _name = "CCAdamEveDesc";					String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucun outil, graine ou bétail n'est initialement disponible - vous devrez survivre et tout acquérir."; }

		{ String _name = "CCSilkRoad";						String _text = "[CC] Route de la Soie - Facile"; }
		{ String _name = "CCSilkRoadDesc";					String _text = "Commencez avec la capacité de nourrir et récolter des vers à soie pour leur précieuse soie. Débute avec six familles. Une grande quantité de vêtements, nourriture, bois de chauffage, matériaux de construction et outils sont fournis. Les maisons et zones de stockage sont déjà construites."; }
		
		{ String _name = "CCSilkRoadMed";					String _text = "[CC] Route de la Soie - Moyen"; }
		{ String _name = "CCSilkRoadMedDesc";					String _text = "Commencez avec la capacité de nourrir et récolter des vers à soie pour leur précieuse soie. Débute avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et matériaux de construction sont fournis. Une grange de stockage est déjà construite."; }
		
		{ String _name = "CCMine";							String _text = "[CC] Mine"; }
		{ String _name = "CCMineDesc";						String _text = "Extraction minière unique pour objets de valeur."; }

		{ String _name = "CCMediumPlus";					String _text = "[CC] Moyen+"; }
		{ String _name = "CCMediumPlusDesc";					String _text = "Ajoute du bétail. Une partie moyen+ commence avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et matériaux de construction sont fournis. Une grange de stockage est déjà construite. Quelques graines pour les champs et vergers sont disponibles ainsi qu'un troupeau de bétail."; }
		
		{ String _name = "CCMissionary";					String _text = "[CC] Missionnaire"; }
		{ String _name = "CCMissionaryDesc";					String _text = "Une partie missionnaire commence avec une Maison Paroissiale et trois familles, dont 2 sont non instruites. 2 maisons sont déjà construites et quelques fournitures de base sont fournies. Un chariot de stockage est disponible. Quelques graines pour les champs et vergers sont disponibles ainsi qu'un troupeau de bétail."; }

