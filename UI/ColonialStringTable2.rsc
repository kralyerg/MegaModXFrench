//buildings

		{ String _name = "StorageBarnStone";				String _text = "Entrepôt de Stockage"; }
		{ String _name = "StorageBarnStoneLwr";				String _text = "entrepôt de stockage"; }
		{ String _name = "StorageBarnStoneTip";				String _text = "Fournit une plus grande quantité de stockage pour toute la gamme de produits et ressources."; }
		
		{ String _name = "TradeWarehouse";					String _text = "Dépôt de Ressources"; }
		{ String _name = "TradeWarehouseLwr";				String _text = "dépôt de ressources"; }
		{ String _name = "TradeWarehouseTip";				String _text = "Stockage ajustable pour votre gamme disponible de produits et ressources. Vous devez avoir au moins 1 exemplaire d'un type de produit pour que son bouton de stockage apparaisse. Les objets stockés dans ce bâtiment ne seront libérés dans votre ville que lorsque vous diminuerez le nombre d'objets manuellement. Les objets stockés ne sont pas librement disponibles aux habitants sans votre intervention."; }

		{ String _name = "LargeSmithy";						String _text = "Grande Forge"; }
		{ String _name = "LargeSmithyLwr";					String _text = "grande forge"; }
		{ String _name = "LargeSmithyTip";					String _text = "Une Grande Forge fabrique des produits avancés comme les Outils en Acier et les Solives, requis pour certains bâtiments avancés."; }

		{ String _name = "KilnBuilding";					String _text = "Four à Piles"; }
		{ String _name = "KilnBuildingLwr";					String _text = "four à piles"; }
		{ String _name = "KilnBuildingTip";					String _text = "Le bois ou le charbon en couches est empilé en tas et brûlé en combustible de l'intérieur vers l'extérieur. Une bonne source de combustible léger pour chauffer les maisons ou travailler."; }
		
		{ String _name = "BrickBuilding";					String _text = "Briqueterie"; }
		{ String _name = "BrickBuildingLwr";				String _text = "briqueterie"; }
		{ String _name = "BrickBuildingTip";				String _text = "A l'aide d'un fourneau, la Briqueterie crée des briques moulées chauffées à blanc, requises pour certains bâtiments avancés et la route en briques."; }
		
		{ String _name = "Abbey";							String _text = "Abbaye"; }
		{ String _name = "AbbeyLwr";						String _text = "abbaye"; }
		{ String _name = "AbbeyTip";						String _text = "Une Abbaye abrite des moines qui récoltent des baies et des herbes, et brassent de la bière. Les moines sont ingénieux et fabriquent leurs produits à partir d'ingredients locaux, sans besoin d'assistance ou de livraisons de produits."; }

		{ String _name = "Ropery";							String _text = "Corderie"; }
		{ String _name = "RoperyLwr";						String _text = "corderie"; }
		{ String _name = "RoperyTip";						String _text = "Une Corderie est l'endroit ou le chanvre et le lin sont tressés en corde. Fabriquer de la corde à partir de chanvre nécessite légèrement moins de matières premières que le lin."; }
		
		{ String _name = "Tinyshack";						String _text = "Petite Cabane"; }
		{ String _name = "TinyshackLwr";					String _text = "petite cabane"; }
		{ String _name = "TinyshackTip";					String _text = "Une habitation petite et basique qui permettra aux nouvelles familles de grandir jusqu'à 3 personnes seulement. Cependant, une famille existante de n'importe quelle taille peut y emménager si elle est relogée."; }
		
		{ String _name = "Tinyhouse";						String _text = "Petite Maison"; }
		{ String _name = "TinyshackLwr";					String _text = "petite maison"; }
		{ String _name = "TinyhouseTip";					String _text = "Une habitation petite et basique qui permettra aux nouvelles familles de grandir jusqu'à 4 personnes seulement. Cependant, une famille existante de n'importe quelle taille peut y emménager si elle est relogée. Plus chaude et confortable qu'une petite cabane."; }
		
		{ String _name = "Townhouse";						String _text = "Grande Résidence"; }
		{ String _name = "TownhouseLwr";					String _text = "grande residence"; }
		{ String _name = "TownhouseTip";					String _text = "La Grande Résidence peut loger une famille de 6 avec une grande chaleur et un grand confort."; }
		
		{ String _name = "Townhouse2";						String _text = "Manoir"; }
		{ String _name = "Townhouse2Lwr";					String _text = "manoir"; }
		{ String _name = "Townhouse2Tip";					String _text = "Le Manoir peut loger une famille de 7 avec une grande chaleur et un grand confort."; }
		
		{ String _name = "Townhouse3";						String _text = "Demeure"; }
		{ String _name = "Townhouse3Lwr";					String _text = "demeure"; }
		{ String _name = "Townhouse3Tip";					String _text = "La Demeure peut loger une famille de 8 avec une grande chaleur et un grand confort."; }
		
		{ String _name = "Townhouse4";						String _text = "Domaine"; }
		{ String _name = "Townhouse4Lwr";					String _text = "domaine"; }
		{ String _name = "Townhouse4Tip";					String _text = "Le Domaine est un bâtiment d'élite et peut loger une famille de 8 dans le plus grand confort et la plus grande chaleur."; }

		{ String _name = "SmalltownhouseA";					String _text = "Demeure Urbaine"; }
		{ String _name = "SmalltownhouseALwr";				String _text = "demeure urbaine"; }
		{ String _name = "SmalltownhouseATip";				String _text = "Une Demeure Urbaine est une maison qui permettra aux nouvelles familles d'atteindre jusqu'à 4 personnes. Cependant, une famille existante de n'importe quelle taille peut y emménager si elle est relogée."; }
		
		{ String _name = "Smalltownhouse";					String _text = "Maison de Ville"; }
		{ String _name = "SmalltownhouseLwr";				String _text = "maison de ville"; }
		{ String _name = "SmalltownhouseTip";				String _text = "Une Maison de Ville est une demeure chaude et confortable pour une famille de 5."; }
		
		{ String _name = "SmalltownhouseC";					String _text = "Belle Maison de Ville"; }
		{ String _name = "SmalltownhouseCLwr";				String _text = "belle maison de ville"; }
		{ String _name = "SmalltownhouseCTip";				String _text = "Une Belle Maison de Ville est une demeure encore plus chaude et confortable pour une famille de 6."; }
		
		{ String _name = "SmalltownhouseD";					String _text = "Maison de Ville Chic"; }
		{ String _name = "SmalltownhouseDLwr";				String _text = "maison de ville chic"; }
		{ String _name = "SmalltownhouseDTip";				String _text = "Une Maison de Ville Chic est la demeure la plus chaude et la plus confortable pour une famille de 6."; }

		{ String _name = "Twarehouse";						String _text = "Stockage au Sec"; }
		{ String _name = "TwarehouseLwr";					String _text = "stockage au sec"; }
		{ String _name = "TwarehouseTip";					String _text = "Le bâtiment de Stockage au Sec stocké les textiles, comme le coton, le lin, le cuir, la laine, le tissu, la toile de lin et la feuille de tabac."; }		

		{ String _name = "Oilpress";						String _text = "Pressoir à Huile"; }
		{ String _name = "OilpressLwr";						String _text = "pressoir à huile"; }
		{ String _name = "OilpressTip";						String _text = "Un Pressoir à Huile extrait l'huile des olives et des graines récoltées de tournesol, de lin, de coton, et de la graisse de baleine."; }

		{ String _name = "Weavers";							String _text = "Tisserands"; }
		{ String _name = "WeaversLwr";						String _text = "tisserands"; }
		{ String _name = "WeaversTip";						String _text = "Un Tisserand fabrique du lin, du tissu et de la soie à partir de lin, de coton et de cocons de vers à soie."; }

		{ String _name = "Clothier";						String _text = "Confectionneur"; }
		{ String _name = "ClothierLwr";						String _text = "confectionneur"; }
		{ String _name = "ClothierTip";						String _text = "Un Confectionneur est un Tailleur amélioré qui fabrique des vêtements de meilleure qualité, plus chauds et de plus grande valeur marchande."; }

		{ String _name = "Silkwormhut";					String _text = "Hutte à Vers à Soie"; }
		{ String _name = "SilkwormhutLwr";				String _text = "hutte à vers à soie"; }
		{ String _name = "SilkwormhutTip";				String _text = "Une Hutte à Vers à Soie élève des vers à soie pour fabriquer de la soie et, en dernier recours, pour la nourriture. Les vers à soie ont besoin de feuilles de mûrier blanc comme nourriture. Cela peut être échangé ou provenir d'un verger."; }

		{ String _name = "Tobaccobarn";					String _text = "Grange de Séchage"; }
		{ String _name = "TobaccobarnLwr";				String _text = "grange de sechage"; }
		{ String _name = "TobaccobarnTip";				String _text = "C'est ici que le tabac est sèche à l'air pour devenir du tabac à pipe pour fumer. Les produits finis doivent être stockés dans un bâtiment Auberge et Jardin."; }

		{ String _name = "CCStatue1";					String _text = "Statue de la Charte"; }
		{ String _name = "CCStatue1Lwr";				String _text = "statue de la charte"; }
		{ String _name = "CCStatue1Tip";				String _text = "Une statue représentant le gouverneur de la colonie."; }
		{ String _name = "Quote1";						String _text = "Il se pourrait que le but de votre vie ne soit que de servir d'avertissement aux autres."; }

		{ String _name = "CCStatue2";					String _text = "Statue de la Charte"; }
		{ String _name = "CCStatue2Lwr";				String _text = "statue de la charte"; }
		{ String _name = "CCStatue2Tip";				String _text = "Une statue représentant le gouverneur de la colonie à califourchon sur un lama."; }
		{ String _name = "Quote2";						String _text = "Le plus sombre secret de cette colonie est que trop de ses citoyens s'imaginent encore appartenir à une civilisation bien supérieure, ailleurs."; }
		
		{ String _name = "Roadtriangle";				String _text = "Triangle de Place en Pierre"; }
		{ String _name = "RoadtriangleLwr";				String _text = "triangle de place en pierre"; }
		{ String _name = "RoadtriangleTip";				String _text = "Pour aplanir et décorer des zones avec des places esthétiques, les pièces triangulaires s'adaptent bien aux coins."; }
		
		{ String _name = "Roadstraight";				String _text = "Place en Pierre Droite"; }
		{ String _name = "RoadstraightLwr";				String _text = "place en pierre droite"; }
		{ String _name = "RoadstraightTip";				String _text = "Pour aplanir et décorer des zones avec des places esthétiques."; }

