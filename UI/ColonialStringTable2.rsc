		{ String _name = "WineryLwr";					String _text = "cave à vin"; }
		{ String _name = "WineryTip";					String _text = "Une Cave à Vin fabrique du vin à partir de raisins et d'autres fruits. Le vin produit doit être stocké dans un bâtiment Auberge et Jardin."; }

