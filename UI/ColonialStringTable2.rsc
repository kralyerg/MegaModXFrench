		{ String _name = "ApiaryLwr";					String _text = "rucher"; }
		{ String _name = "ApiaryTip";					String _text = "Un Rucher produit du miel comme aliment ou de la cire d'abeille qui peut être transformée en bougies dans une Chandellerie."; }

