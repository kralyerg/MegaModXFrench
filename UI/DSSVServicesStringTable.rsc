		{ String _name = "DSSVHerbalistTip";		String _text = "L'Herboriste du Village joue un rôle important pour maintenir vos citoyens en bonne santé. Il récoltera des herbes et fournira des soins simples aux citoyens. Emploie 1 à 2 Herboristes. Nécessite 34 travail à construire."; }	
		
		{ String _name = "DSSVHospital";			String _text = "Hôpital du Village"; }
		{ String _name = "DSSVHospitalLwr";			String _text = "hôpital du village"; }
		{ String _name = "DSSVHospitalTip";			String _text = "l'Hôpital du Village offrira un lieu où vos citoyens malades pourront se rendre et être soignés par un médecin. Construisez ceci pour obtenir l'hôpital de base, et une fois construit, l'hôpital peut être amélioré via un bouton dans le panneau d'informations du bâtiment. Nécessite 144 travail."; }
		{ String _name = "HospitalUpgrade1Tip";			String _text = "Améliorer l'Hôpital du Village, une capacité plus grande de 45 patients, employant 1 à 2 médecins avec une nouvelle aile ajoutée, un mur de pierre extérieur et une amélioration du petit jardin. Nécessite 55 travail."; }
				
		
		{ String _name = "DSSVVillageHall";				String _text = "Salle du Village"; }
