		{ String _name = "DSSVChapelLwr";				String _text = "chapelle du village"; }
		{ String _name = "DSSVChapelTip";				String _text = "Chapelle du Village. capacité 50 citoyens. Nécessite 89 travail à construire."; }
		
		{ String _name = "DSSVChurch";					String _text = "Église du Village"; }
