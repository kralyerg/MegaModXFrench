StringTable resource
{
	Entry _strings
	[
		{
			String _name = "DSVillageSquareMeadBrewer";
			String _text = "Brasseur d'hydromel de la place du village";
		}
		{
			String _name = "DSVillageSquareMeadBrewerLwr";
			String _text = "brasseur d'hydromel de la place du village";
		}
		{
			String _name = "DSVillageSquareMeadBrewerTip";
			String _text = "le brasseur d'hydromel de la place du village, un petit bâtiment pour brasser et servir de l'hydromel et de l'hydromel chaud épicé. L'hydromel est fabriqué à partir de miel et d'eau ou de miel sauvage et d'eau. L'hydromel chaud épicé utilise de l'hydromel et des herbes. Emploie 1 brasseur. Le brasseur d'hydromel peut stocker un total combiné de 250 poids. La construction nécessite 55 travail.";
		}
		{
			String _name = "DSVillageMeadery";
			String _text = "Hydromellerie du village";
		}
		{
			String _name = "DSVillageMeaderyLwr";
			String _text = "hydromellerie du village";
		}
		{
			String _name = "DSVillageMeaderyTip";
			String _text = "l'hydromellerie du village, une taverne qui brasse et sert de l'hydromel et de l'hydromel chaud épicé aux citoyens. L'hydromel est fabriqué à partir de miel et d'eau ou de miel sauvage et d'eau. L'hydromel chaud épicé utilise de l'hydromel et des herbes. Emploie 1 à 4 brasseurs. L'hydromellerie peut stocker un total combiné de 600 poids. La construction nécessite 144 travail.";
		}
		{
			String _name = "MeadWaterRequire";
			String _text = "Hydromel (40 Miel + 20 Eau)";
		}
		{
			String _name = "MeadWildHoneyWaterRequire";
			String _text = "Hydromel (40 Miel sauvage + 20 Eau)";
		}
		{
			String _name = "MulledMeadRequire";
			String _text = "Hydromel chaud épicé (1 Hydromel + 1 Herbe)";
		}
		{
			String _name = "DSVillageStorageShed2x2";
			String _text = "Hangar de stockage du village - 2x2";
		}
		{
			String _name = "DSVillageStorageShed2x2Lwr";
			String _text = "hangar de stockage du village";
		}
		{
			String _name = "DSVillageStorageShed2x2Tip";
			String _text = "Le hangar de stockage du village 2x2 est un simple appentis de stockage pour toutes les nourritures, herbes et médicaments, outils, vêtements, et biens artisanaux et ustensiles. Capacité de stockage totale de 900 poids. La construction nécessite 21 travail.";
		}
		{
			String _name = "DSVillageStorageShed2x3";
			String _text = "Hangar de stockage du village - 2x3";
		}
		{
			String _name = "DSVillageStorageShed2x3Lwr";
			String _text = "hangar de stockage du village";
		}
		{
			String _name = "DSVillageStorageShed2x3Tip";
			String _text = "Le hangar de stockage du village 2x3 est un simple appentis de stockage pour toutes les nourritures, herbes et médicaments, outils, vêtements, et biens artisanaux et ustensiles. Capacité de stockage totale de 1250 poids. La construction nécessite 29 travail.";
		}
		{
			String _name = "DSVillageBeehiveTrunks";
			String _text = "Ruches du village";
		}
		{
			String _name = "DSVillageBeehiveTrunksLwr";
			String _text = "ruches du village";
		}
		{
			String _name = "DSVillageBeehiveTrunksTip";
			String _text = "aux ruches du village, un apiculteur s'occupera des abeilles et récoltera aléatoirement du miel, de la cire d'abeille et du miel en rayon. Emploie 1 apiculteur. La construction nécessite 34 travail.";
		}
		{
			String _name = "DSVillageApiary";
			String _text = "Rucher du village";
		}
		{
			String _name = "DSVillageApiaryLwr";
			String _text = "rucher du village";
		}
		{
			String _name = "DSVillageApiaryTip";
			String _text = "le rucher du village, les apiculteurs s'occupent des abeilles et récoltent aléatoirement du miel, de la cire d'abeille, du miel en rayon et de la gelée royale. Emploie 1 à 2 apiculteurs. La construction nécessite 89 travail.";
		}
		{
			String _name = "DSVillageApiaryProduce";
			String _text = "Rucher du village";
		}
		{
			String _name = "DSVillageApiaryProduceLwr";
			String _text = "rucher du village";
		}
		{
			String _name = "DSVillageApiaryProduceTip";
			String _text = "le rucher du village, les apiculteurs s'occupent des abeilles et récoltent soit du miel, soit du miel en rayon, soit de la cire d'abeille. Emploie 1 à 2 apiculteurs. La construction nécessite 89 travail.";
		}
		{
			String _name = "HoneyRequire";
			String _text = "Miel";
		}
		{
