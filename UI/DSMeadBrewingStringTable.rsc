			String _text = "Puits d'eau du village";
		}
		{
			String _name = "DSVillageWaterWellLwr";
			String _text = "puits d'eau du village";
		}
		{
			String _name = "DSVillageWaterWellTip";
			String _text = "le puits d'eau du village, un ouvrier fera fonctionner le puits et collectera de l'eau pour la consommation (comestible) par les citoyens ou pour l'utiliser comme ingrédient. Emploie 1 ouvrier. La construction nécessite 55 travail.";
		}
		{
