StringTable resource
{
	Entry _strings
	[ 

		{ String _name = "PalmsOnlyEasyName";		String _text = "Palmiers - Facile"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Une partie Facile standard avec uniquement des palmiers et des arbres tropicaux. Une partie facile commence avec six familles. Une grande quantité de vêtements, de nourriture, de bois de chauffage, de matériaux de construction et d'outils est fournie. Les maisons et les zones de stockage sont déjà construites. Des graines pour les champs et les vergers sont disponibles, ainsi qu'un troupeau de bétail."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palmiers - Moyen"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Une partie Moyenne standard avec uniquement des palmiers et des arbres tropicaux. Une partie moyenne commence avec cinq familles. Des vêtements, de la nourriture, du bois de chauffage, des outils et des matériaux de construction sont fournis. Une grange de stockage est déjà construite. Quelques graines pour les champs et les vergers sont disponibles."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palmiers - Difficile"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Une partie Difficile standard avec uniquement des palmiers et des arbres tropicaux. Une partie difficile commence avec quatre familles. Une petite quantité de vêtements, de nourriture, de bois de chauffage et d'outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palmiers - Adam et Ève"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Une partie Adam et Ève standard avec uniquement des palmiers et des arbres tropicaux. Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans une petite charrette de stockage. Aucune structure n'est construite, aucune graine ni bétail n'est disponible au départ - vous devrez survivre et tout acquérir."; }

	]
}

