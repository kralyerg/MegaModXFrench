		{ String _name = "DSJaBJettyDriftWoodCollectorTip";		String _text = "collecte des rondins et du bois de chauffage dans les voies navigables. emploie un minimum de 2 travailleurs. Nécessite 34 travail pour construire. Ce bâtiment n'a qu'une durée de production limitée (environ 5 ans) et finira par épuiser ses ressources disponibles, après quoi il deviendra un bâtiment de jetée à l'abandon. Le bâtiment peut alors etre configuré pour commencer sa démolition, générant alors une petite quantité de rondins et de bois de chauffage, après quoi il pourra etre entièrement démoli avec l'outil de suppression de structures."; }
		
		{ String _name = "DSJaBJettyDriftWoodCollectorSLCT";		String _text = "Chercheur de Bois Flotté"; }
		{ String _name = "DSJaBJettyDriftWoodCollectorSLCTLwr";		String _text = "chercheur de bois flotté"; }
		{ String _name = "DSJaBJettyDriftWoodCollectorSLCTTip";		String _text = "recherche et collecte des rondins ou du bois de chauffage dans les voies navigables, ce qui le rend plus lent que le collecteur. emploie un minimum de 2 travailleurs. Nécessite 34 travail pour construire. Ce bâtiment n'a qu'une durée de production limitée (environ 5 ans) et finira par épuiser ses ressources disponibles, après quoi il deviendra un bâtiment de jetée à l'abandon. Le bâtiment peut alors etre configuré pour commencer sa démolition, générant alors une petite quantité de rondins et de bois de chauffage, après quoi il pourra etre entièrement démoli avec l'outil de suppression de structures."; }
			{ String _name = "DriftWoodCollectorRequire1";		String _text = "Rondins"; }
