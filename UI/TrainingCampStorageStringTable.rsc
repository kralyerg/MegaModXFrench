		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Vous êtes les arcs à partir desquels vos enfants, comme des flèches vivantes, sont envoyés. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Chaque nation a un drapeau. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "L'attaque est le secret de la défense ; la défense est la planification d'une attaque. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "Je ne pense pas que l'architecture ne concerne que l'abri, un simple enclos. Elle devrait pouvoir vous exciter, vous calmer, vous faire réfléchir. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "La race humaine ne possède qu'une seule arme vraiment efficace : le rire. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "L'arme la plus puissante sur terre est l'âme humaine en feu. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "La non-violence est une arme puissante et juste. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Une vie bien ordonnée est comme l'ascension d'une tour ; la vue à mi-chemin est meilleure que la vue depuis la base, et elle s'améliore sans cesse à mesure que l'horizon s'élargit. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "Je ne peux pas vous montrer exactement en quoi les soins de santé sont un droit humain fondamental. Mais je peux affirmer que personne ne devrait mourir d'une maladie qui se soigne. - Paul Farmer."; }

