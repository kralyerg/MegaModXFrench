		}
		{
			String _name = "DSIndustryMineSecondTip";
			String _text = "La grande, deuxième mine industrielle, Thadd Surrel et famille. Capable d'extraire du minerai de fer, du minerai de cuivre, du minerai d'étain ou du charbon, nécessite du bois de construction et soit de l'huile de lampe, soit des bougies pour fonctionner. Emploie 1-72 mineurs. La mine a une production quasi à vie de 5 000 000 sur la durée de sa vie. Nécessite 512 travail pour construire.";
		}
		{
			String _name = "DSClarenceSilverMine01";
