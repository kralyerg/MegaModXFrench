StringTable startConditions
{
	Entry _strings
	[
		{
			String _name = "Easy0Name";
			String _text = "Industrie : Outils";
		}
		{
			String _name = "Easy0Desc";
			String _text = "Une partie facile, débutant avec cinq familles et leurs maisons. Une grande quantité de vêtements, nourriture, bois de chauffage, charbon de bois, outils, rondins, fer et pierre sont fournis. Les granges de stockage Thadd Surrel ont déjà été construites, ainsi que la forge Thadd Surrel, l'âtre du forgeron et la meule. Quelques graines pour les champs et vergers sont disponibles, ainsi qu'un troupeau de bétail.";
		}
		{
			String _name = "Easy2Name";
			String _text = "Industrie : Lin, toile de lin et huile à lampe";
		}
		{
			String _name = "Easy2Desc";
			String _text = "Une partie facile, débutant avec cinq familles et leurs maisons. Une grande quantité de vêtements, nourriture, bois de chauffage, charbon de bois, outils, rondins, fer et pierre sont fournis. Les granges de stockage Thadd Surrel ont déjà été construites, ainsi que le tisserand de lin Thadd Surrel, le four à huile et le hangar de pressage. Des graines de lin pour le champ et une graine de verger sont disponibles, ainsi qu'un troupeau de bétail.";
		}
		{
			String _name = "Medium0Name";
			String _text = "Industrie : Stockage Thadd Surrel";
		}
		{
			String _name = "Medium0Desc";
			String _text = "Une partie moyenne, débutant avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et quelques rondins, fer et pierre sont fournis. Les granges de stockage Thadd Surrel ont déjà été construites. Quelques graines pour les champs et vergers sont disponibles.";
		}
		{
			String _name = "Hard0Name";
			String _text = "Industrie : Charbonniers";
		}
		{
			String _name = "Hard0Desc";
			String _text = "Une partie difficile, débutant avec quatre familles. Quelques vêtements, nourriture, outils, pierre et une grande quantité de rondins sont fournis. Vous disposez de quelques tonneaux et boîtes de stockage contenant vos biens, ainsi que deux meules à charbon déjà construites.";
		}
		{
			String _name = "Hard1Name";
			String _text = "Industrie : Fondeurs de minerai";
		}
		{
			String _name = "Hard1Desc";
			String _text = "Une partie difficile, débutant avec quatre familles. Quelques vêtements, nourriture, outils, pierre, charbon de bois et rondins sont fournis. Vous disposez de quelques tonneaux et boîtes de stockage contenant vos biens, ainsi que deux bas fourneaux (cuivre et fer) et une petite meule à charbon déjà construits.";
		}
	]

}
