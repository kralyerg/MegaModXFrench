		}
		{
			String _name = "ImprovedMineTip";
			String _text = "Le modèle de mine améliorée, réalisé en collaboration avec Yandersen. C'est une mine de montagne qui emploie 1-30 mineurs qui extrairont soit du minerai de fer, du minerai de cuivre, soit du charbon. Elle a une production limitée de 21 000. Nécessite 144 travail pour construire.";
		}
		{
			String _name = "DSThaddSurrelMineOilLamps";
			String _text = "Thadd Surrel et famille : mine industrielle";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsLwr";
			String _text = "mine industrielle";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsTip";
			String _text = "La mine industrielle, Thadd Surrel et famille. Capable d'extraire du minerai de fer, du minerai de cuivre, du minerai d'étain ou du charbon, nécessite du bois de construction et soit de l'huile de lampe, soit des bougies pour fonctionner. Emploie 1-55 mineurs. La mine a une grande production de 250 000 sur la durée de sa vie. Nécessite 233 travail pour construire.";
		}
		{
			String _name = "DSIndustryMineSecond";
