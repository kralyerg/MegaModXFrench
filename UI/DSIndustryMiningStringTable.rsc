		}
		{
			String _name = "DSCoalBellPit1Tip";
			String _text = "Une mine de charbon primitive, construite sur un terrain plat, nécessite 3-8 mineurs qui extrairont uniquement du charbon d'une fosse en forme de 'cloche' dans le sol. Elle a une production limitée de 600 et devra être améliorée une fois épuisée pour continuer l'exploitation. Nécessite 34 travail pour construire.";
		}
		{
			String _name = "DSCoalBellPit1Upgrade";
			String _text = "Mine à fosse en cloche à charbon";
		}
		{
			String _name = "DSCoalBellPit1UpgradeLwr";
			String _text = "mine à fosse en cloche à charbon";
		}
		{
			String _name = "DSCoalBellPit1UpgradeTip";
			String _text = "Améliorez la fosse en cloche pour permettre une production supplémentaire de 5 400, et une extraction légèrement plus rapide du charbon grâce à l'ajout d'un système de poulies pour aider les mineurs (jusqu'à 13 mineurs). Nécessite 89 travail pour améliorer.";
		}
		{
