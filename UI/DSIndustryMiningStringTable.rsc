		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsTip";
			String _text = "Améliorez pour permettre une durée de vie plus longue de 24 800, et une extraction légèrement plus rapide du minerai de fer avec jusqu'à 21 mineurs pouvant être employés. Nécessite 89 travail pour améliorer";
		}
