		}
		{
			String _name = "DSClarenceSilverMine01Tip";
			String _text = "La mine d'argent de Clarence, une grande mine de minerai d'argent, construite d'abord au niveau 1re étoile, la mine emploie 1-8 mineurs, et nécessitera du bois de construction et 2 huile de lampe pour fonctionner. La mine a une production limitée avant de devoir être améliorée pour continuer l'extraction du minerai d'argent. Nécessite 89 travail pour construire.";
		}
		{
			String _name = "DSClarenceSilverMine02";
			String _text = "Mine d'argent de Clarence, 2e étoile";
		}
		{
			String _name = "DSClarenceSilverMine02Lwr";
			String _text = "mine d'argent de clarence";
		}
		{
			String _name = "DSClarenceSilverMine02Tip";
			String _text = "Améliorez la mine, en étendant la salle de tri arrière pour faire place à une ouverture de mine plus grande. Les tunnels existants seront renforcés pour faire face à une main-d'œuvre de mine légèrement plus grande de 13. La mine améliorée aura une production totale de 610 avant qu'une autre amélioration ne soit nécessaire. Nécessite 144 travail pour construire.";
		}
		{
			String _name = "DSClarenceSilverMine03";
			String _text = "Mine d'argent de Clarence, 3e étoile";
		}
		{
			String _name = "DSClarenceSilverMine03Lwr";
			String _text = "mine d'argent de clarence";
		}
		{
			String _name = "DSClarenceSilverMine03Tip";
			String _text = "En améliorant la mine, vous ajouterez un grand système de poulies en hauteur, qui permettra une mine plus profonde, et une extraction plus rapide grâce aux poulies qui facilitent le transport des minerais lourds vers la surface. La mine peut employer jusqu'à 21 mineurs. La mine améliorée aura une production totale de 1 597 avant qu'une autre amélioration ne soit nécessaire. Nécessite 233 travail pour construire.";
		}
		{
			String _name = "DSClarenceSilverMine04";
			String _text = "Mine d'argent de Clarence, 4e étoile";
		}
		{
			String _name = "DSClarenceSilverMine04Lwr";
			String _text = "mine d'argent de clarence";
		}
		{
			String _name = "DSClarenceSilverMine04Tip";
			String _text = "Améliorez et renforcez davantage le système de poulies en ajoutant une autre poulie ! Extraction encore plus rapide, et maintenant la mine peut employer jusqu'à 34 mineurs. Mais ce n'est pas tout, l'éclairage de la mine est amélioré, le rendement de production est augmenté, les mineurs n'ayant désormais besoin que d'1 huile de lampe. La mine améliorée aura une production totale de 4 181 avant qu'une autre amélioration ne soit nécessaire. Nécessite 377 travail pour construire.";
		}
		{
			String _name = "DSClarenceSilverMine05";
			String _text = "Mine d'argent de Clarence, 5e étoile";
		}
		{
			String _name = "DSClarenceSilverMine05Lwr";
			String _text = "mine d'argent de clarence";
		}
		{
			String _name = "DSClarenceSilverMine05Tip";
			String _text = "En améliorant la mine, l'installation de rails de chemin de fer permettra l'utilisation de chariots plus rapides, augmentant le taux de production. C'est la profondeur finale de la mine, après quoi elle sera épuisée de tout son minerai d'argent. Elle a une capacité totale de 10 946. Nécessite 610 travail pour construire.";
		}
