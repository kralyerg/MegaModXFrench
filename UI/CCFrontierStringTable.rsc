		{ String _name = "Forwardpost";				String _text = "Poste Avance"; }
		{ String _name = "ForwardpostLwr";			String _text = "poste avance"; }
		{ String _name = "ForwardpostTip";			String _text = "Ce poste represente l'une des incursions de votre force militaire en territoire ennemi. La guerre reussie à cette epoque exige des fusils et de fiers uniformes colores, mais en vainquant vos ennemis, le poste generera de nombreux objets utiles pour votre colonie - notamment diverses fournitures de construction lucratives, des artefacts precieux, ou de rares marchandises capturees sur les vaincus."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Nécessite : Fourniture militaire.  Produit : Un assortiment aleatoire de vin, spiritueux, mousquet, canon, poterie, pierres précieuses, manteau de peau, artefact amerindien."; }

		{ String _name = "MusketRange";				String _text = "Champ de Tir"; }
		{ String _name = "MusketRangeLwr";			String _text = "champ de tir"; }
		{ String _name = "MusketRangeTip";			String _text = "C'est ici que les soldats de votre colonie s'entrainent pour etre les meilleurs et les plus prets à affronter tout ce que ce monde leur réserve. Pendant l'entrainement nécessaire, des ressources vitales à la survie de votre colonie (comme des outils et des vêtements) seront produites."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Nécessite : Pfennig. Produit : Un assortiment aleatoire d'outil en acier, mousquet, uniforme, biere, tabac à pipe."; }

