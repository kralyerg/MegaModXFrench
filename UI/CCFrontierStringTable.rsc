StringTable resource
{
	Entry _strings
	[ 


	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{ String _name = "CCAdamEve";			String _text = "[CC] Adam et Eve"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucune graine ni bétail n'est disponible au depart - vous devrez survivre et tout acquerir."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Missionnaire"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Une partie Missionnaire commence avec une maison paroissiale et trois familles, dont 2 sont non instruites. 2 maisons sont deja construites et quelques fournitures de base sont offertes. Un chariot de stockage est disponible. Quelques graines pour champs et vergers sont disponibles ainsi qu'un troupeau de bétail."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nouvelle Frontiere"; }
		{ String _name = "CCFortDesc";			String _text = "La Nouvelle Frontiere vous fait demarrer dans un avant-poste frontalier pres d'un village amerindien amical. Defendez et nourrissez vos citoyens et votre legende sera racontee dans l'ouest pour toujours. Cette partie commence avec 3 familles et un petit fort avec quelques fournitures a deja été construit. Inclut l'option de decouvrir des tresors sur un terrain ceremoniel."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Village Amerindien - Difficile"; }
		{ String _name = "CCFortHardDesc";		String _text = "Le demarrage Village Amerindien exige de bonnes relations avec la tribu amerindienne de la region et constitue un debut assez difficile. Le village exigera des ressources (ameliorations) pour signaler votre amitie, et vous aurez ensuite le choix de la maniere d'interagir avec les bâtiments. En tant qu'etrangers sur cette terre, vous avez beaucoup à apprendre et à gagner en recherchant des allies plutot que des ennemis."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Village Amerindien - Adam et Eve"; }
		{ String _name = "CCFortAEDesc";		String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Le demarrage Village Amerindien exige de bonnes relations avec la tribu amerindienne de la region et constitue un debut assez difficile. Le village exigera des ressources (ameliorations) pour signaler votre amitie, et vous aurez ensuite le choix de la maniere d'interagir avec les bâtiments. En tant qu'etrangers sur cette terre, vous avez beaucoup à apprendre et à gagner en recherchant des allies plutot que des ennemis."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] La Malediction du Lama d'Or - Facile"; }
		{ String _name = "LlamaEasyDesc";		String _text = "La Malediction du Lama d'Or est ce qui se rapproche le plus d'un mystere dans le monde de Banished. Qu'est-ce que le Lama d'Or ? Quels mysteres recele-t-il ? Oserez-vous explorer son interieur trouble ? Ceci est une partie qui commence selon les parametres Facile habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un tresor. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] La Malediction du Lama d'Or - Moyen"; }
		{ String _name = "LlamaMediumDesc";		String _text = "La Malediction du Lama d'Or est ce qui se rapproche le plus d'un mystere dans le monde de Banished. Qu'est-ce que le Lama d'Or ? Quels mysteres recele-t-il ? Oserez-vous explorer son interieur trouble ? Ceci est une partie qui commence selon les parametres Moyen habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un tresor."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] La Malediction du Lama d'Or - Difficile"; }
		{ String _name = "LlamaHardDesc";		String _text = "La Malediction du Lama d'Or est ce qui se rapproche le plus d'un mystere dans le monde de Banished. Qu'est-ce que le Lama d'Or ? Quels mysteres recele-t-il ? Oserez-vous explorer son interieur trouble ? Ceci est une partie qui commence selon les parametres Difficile habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un tresor. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] La Malediction du Lama d'Or - Adam et Eve"; }
		{ String _name = "LlamaAEDesc";			String _text = "La Malediction du Lama d'Or est ce qui se rapproche le plus d'un mystere dans le monde de Banished. Qu'est-ce que le Lama d'Or ? Quels mysteres recele-t-il ? Oserez-vous explorer son interieur trouble ? Ceci est une partie qui commence selon les parametres Adam et Eve, mais inclut l'option de partir à l'aventure pour tenter de trouver un tresor. "; }


