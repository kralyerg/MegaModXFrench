	//STARTING CONDITIONS
		{ String _name = "CCcustom1Name";		String _text = "Colonial Charter"; }
		{ String _name = "CCcustom1Desc";		String _text = "Description de Colonial Charter à venir"; }

		{ String _name = "CCAdamEve";			String _text = "[CC] Adam et Ève"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucune graine ni bétail n'est initialement disponible - vous devrez tout survivre et acquérir par vous-même."; }

		{ String _name = "CCSilkRoad";			String _text = "[CC] Route de la Soie - Facile"; }
		{ String _name = "CCSilkRoadDesc";		String _text = "Commencez avec la capacité de nourrir et récolter des vers à soie pour leur précieuse soie. Débute avec six familles. Une grande quantité de vêtements, nourriture, bois de chauffage, matériaux de construction et outils est fournie. Les maisons et les zones de stockage ont déjà été construites."; }
		
		{ String _name = "CCSilkRoadMed";		String _text = "[CC] Route de la Soie - Moyen"; }
		{ String _name = "CCSilkRoadMedDesc";		String _text = "Commencez avec la capacité de nourrir et récolter des vers à soie pour leur précieuse soie. Débute avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et matériaux de construction sont fournis. Une grange de stockage a déjà été construite."; }

		{ String _name = "CCSilkRoadHard";		String _text = "[CC] Route de la Soie - Difficile"; }
		{ String _name = "CCSilkRoadHardDesc";		String _text = "Commencez avec la capacité de nourrir et récolter des vers à soie pour leur précieuse soie. Une partie difficile débute avec quatre familles. Une petite quantité de vêtements, nourriture, bois de chauffage et outils est fournie. Les graines de mûrier blanc sont les seules graines disponibles."; }
		
		{ String _name = "CCMine";			String _text = "[CC] Mine"; }

		{ String _name = "CCMineDesc";			String _text = "Exploitation minière unique pour des objets précieux."; }

		{ String _name = "CCMediumPlus";		String _text = "[CC] Moyen+"; }
		{ String _name = "CCMediumPlusDesc";		String _text = "Ajoute du bétail. Une partie moyen+ débute avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et matériaux de construction sont fournis. Une grange de stockage a déjà été construite. Quelques graines pour les champs et les vergers sont disponibles ainsi qu'un troupeau de bétail."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Mission"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Une partie Mission débute avec une maison paroissiale et trois familles, dont 2 sont sans éducation. 2 maisons sont déjà construites et quelques fournitures de base sont fournies. Un chariot de stockage est disponible. Quelques graines pour les champs et les vergers sont disponibles ainsi qu'un troupeau de bétail."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nouvelle Frontière"; }
		{ String _name = "CCFortDesc";		String _text = "La Nouvelle Frontière vous place dans un avant-poste frontalier près d'un village amérindien amical. Défendez et développez vos citoyens et votre légende sera racontée dans l'ouest pour toujours. Cette partie débute avec 3 familles et un petit fort avec quelques fournitures a déjà été construit. Inclut l'option de découvrir des trésors sur un terrain cérémoniel."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Village Autochtone - Difficile"; }
		{ String _name = "CCFortHardDesc";		String _text = "Le départ Village Autochtone exige de bonnes relations avec la tribu autochtone de la région et constitue un départ assez difficile. Le village nécessitera des ressources (améliorations) pour signaler votre amitié, puis vous aurez le choix de la façon d'interagir avec les bâtiments. En tant qu'étrangers sur cette terre, vous avez beaucoup à apprendre et à gagner en cherchant des alliés plutôt que des ennemis."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Village Autochtone - Adam et Ève"; }
		{ String _name = "CCFortAEDesc";		String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Le départ Village Autochtone exige de bonnes relations avec la tribu autochtone de la région et constitue un départ assez difficile. Le village nécessitera des ressources (améliorations) pour signaler votre amitié, puis vous aurez le choix de la façon d'interagir avec les bâtiments. En tant qu'étrangers sur cette terre, vous avez beaucoup à apprendre et à gagner en cherchant des alliés plutôt que des ennemis."; }

		{ String _name = "PalmsOnlyEasyName";		String _text = "[CC] Antilles - Facile"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Une partie Facile standard avec uniquement des palmiers et des arbres tropicaux. Une partie facile débute avec six familles. Une grande quantité de vêtements, nourriture, bois de chauffage, matériaux de construction et outils est fournie. Les maisons et les zones de stockage ont déjà été construites. Des graines pour les champs et les vergers sont disponibles ainsi qu'un troupeau de bétail."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "[CC] Antilles - Moyen"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Une partie Moyenne standard avec uniquement des palmiers et des arbres tropicaux. Une partie moyenne débute avec cinq familles. Vêtements, nourriture, bois de chauffage, outils et matériaux de construction sont fournis. Une grange de stockage a déjà été construite. Quelques graines pour les champs et les vergers sont disponibles."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "[CC] Antilles - Difficile"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Une partie Difficile standard avec uniquement des palmiers et des arbres tropicaux. Une partie difficile débute avec quatre familles. Une petite quantité de vêtements, nourriture, bois de chauffage et outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }
		
		{ String _name = "PalmsOnlyHardFewName";		String _text = "[CC] Antilles Clairsemé - Difficile"; }
		{ String _name = "PalmsOnlyHardFewDesc";		String _text = "Une partie Difficile standard avec des quantités clairsemées de palmiers et d'arbres tropicaux uniquement, et peu de pierre et de minerais en surface. Une partie difficile débute avec quatre familles. Une petite quantité de vêtements, nourriture, bois de chauffage et outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

