		{ String _name = "ProfessionBakerDeath";		String _text = "a été gravement brûlé sur un four en cuisant et en est mort."; }

		{ String _name = "ProfessionRefiner";			String _text = "Chaudronnier de Sucre"; }
		{ String _name = "ProfessionRefinerTip";		String _text = "Un chaudronnier de sucre fait bouillir la canne à sucre, l'érable ou les betteraves pour en faire du sucre cristallisé."; }
		{ String _name = "ProfessionRefinerDeath";		String _text = "a été bouilli à mort après s'être endormi dans un chaudron de sucre."; }
		
		{ String _name = "ProfessionSaltworks";			String _text = "Chaudronnier de Sel"; }
		{ String _name = "ProfessionSaltworksTip";		String _text = "Un chaudronnier de saline fait bouillir l'eau de mer pompée dans une saline, la transformant en sel."; }
		{ String _name = "ProfessionSaltworksDeath";	String _text = "a été bouilli à mort dans le bassin d'ébullition."; }

		{ String _name = "ProfessionFirebundler";		String _text = "Fagoteur"; }
		{ String _name = "ProfessionFirebundlerTip";	String _text = "Un fagoteur fabrique du combustible à partir d'une gamme de produits organiques ensuite utiles pour chauffer les maisons ou pour être convertis en combustible pour fourneau à une Raffinerie de Combustible."; }
		{ String _name = "ProfessionFirebundlerDeath";	String _text = "est tombé sur sa propre scie."; }

		{ String _name = "ProfessionSailor";			String _text = "Marin"; }
		{ String _name = "ProfessionSailorTip";			String _text = "Un marin s'embarque pour de dangereux voyages en haute mer pour se procurer les richesses que l'océan a à offrir."; }
		{ String _name = "ProfessionSailorDeath";		String _text = "a été mis à la cale pour mutinerie."; }

		{ String _name = "ProfessionPitdigger";			String _text = "Homme de Rivage"; }
		{ String _name = "ProfessionPitdiggerTip";		String _text = "Un Homme de Rivage extrait le sable et l'argile à une Maison de Rivage, et chasse les grenouilles et les tortues."; }
		{ String _name = "ProfessionPitdiggerDeath";	String _text = "s'est retrouvé coincé dans un trou creusé et s'est noyé."; }

		{ String _name = "ProfessionChandler";			String _text = "Chandelier"; }
		{ String _name = "ProfessionChandlerTip";		String _text = "Un chandelier fabrique des bougies à une Chandellerie à l'ancienne."; }
		{ String _name = "ProfessionChandlerDeath";		String _text = "a suffoqué, on l'a retrouvé enfermé dans de la cire de bougie."; }

		{ String _name = "ProfessionGlassmaker";		String _text = "Verrier"; }
		{ String _name = "ProfessionGlassmakerTip";		String _text = "Un Verrier utilise des fours et de l'équipement pour fondre le sable en verre."; }
		{ String _name = "ProfessionGlassmakerDeath";	String _text = "a été enfermé dans du verre. Il devrait être plutôt bien conservé, à condition qu'il résiste au processus."; }

		{ String _name = "ProfessionDistiller";			String _text = "Distillateur"; }
		{ String _name = "ProfessionDistillerTip";		String _text = "Un Distillateur fabrique des spiritueux plus forts à la Distillerie et les met en bouteille pour la consommation."; }
		{ String _name = "ProfessionDistillerDeath";	String _text = "est mort d'avoir inhalé des vapeurs d'alcool."; }

		{ String _name = "ProfessionGrovetender";		String _text = "Gardien de Bosquet"; }
		{ String _name = "ProfessionGrovetenderTip";	String _text = "Un Gardien de Bosquet s'occupe des mûriers blancs."; }
		{ String _name = "ProfessionGrovetenderDeath";	String _text = "a été tué par une branche tombante."; }

		{ String _name = "ProfessionAlewench";			String _text = "Servante de Taverne"; }
		{ String _name = "ProfessionAlewenchTip";		String _text = "Une Servante de Taverne s'occupe des clients à l'Auberge et Jardin publique."; }
		{ String _name = "ProfessionAlewenchDeath";		String _text = "a reçu une bouteille cassée sur la tête par un ivrogne derrière l'Auberge."; }

		{ String _name = "ProfessionBrewer";			String _text = "Brasseur"; }
		{ String _name = "ProfessionBrewerTip";			String _text = "Les Brasseurs brassent la bière et l'hydromel à la Brasserie."; }
		{ String _name = "ProfessionBrewerDeath";		String _text = "a bu une mauvaise cuvée."; }

		{ String _name = "ProfessionKilnMan";			String _text = "Homme de Four"; }
		{ String _name = "ProfessionKilnManTip";		String _text = "Travaille à la fois aux Fours à Charbon et à la Briqueterie. Crée un tas historiquement connu sous le nom de Meule, qui brûle le Charbon de Bois ou cuit les Briques."; }
		{ String _name = "ProfessionKilnManDeath";		String _text = "est mort d'une pneumoconiose pour avoir inhalé trop de fumée épaisse."; }

//		{ String _name = "ProfessionBrickMan";			String _text = "Briquetier"; }
//		{ String _name = "ProfessionBrickManTip";		String _text = "Fabrique des briques à l'aide de fours à meule au bâtiment du Briquetier."; }
//		{ String _name = "ProfessionBrickManDeath";		String _text = "a été consumé par le feu et la poussière de brique, il n'est rien resté."; }

		{ String _name = "ProfessionButcher";			String _text = "Boucher"; }
		{ String _name = "ProfessionButcherTip";		String _text = "Un boucher découpe les animaux en différentes coupes de viande pour la consommation."; }
		{ String _name = "ProfessionButcherDeath";		String _text = "est tombé sur le couperet."; }

		{ String _name = "ProfessionStallvendor";		String _text = "Vendeur (Étal)"; }
		{ String _name = "ProfessionStallvendorTip";	String _text = "Gère un étal de marché individuel, tout comme un vendeur de marché ordinaire."; }
		{ String _name = "ProfessionStallvendorDeath";	String _text = "a été poignardé à mort lorsqu'un accord commercial a mal tourné."; }

		{ String _name = "ProfessionPreservist";		String _text = "conservateur"; }
		{ String _name = "ProfessionPreservistTip";		String _text = "Un Conservateur fabrique des conserves à partir d'une variété de viandes, de fruits ou de légumes."; }
		{ String _name = "ProfessionPreservistDeath";	String _text = "a été conservé à mort."; }

		{ String _name = "ProfessionDredger";			String _text = "Dragueur"; }
		{ String _name = "ProfessionDredgerTip";		String _text = "Un Dragueur récolte des Moules, des Huîtres, des Écrevisses et des Algues au bâtiment du Bassin de Marée."; }
		{ String _name = "ProfessionDredgerDeath";		String _text = "est mort paisiblement dans son sommeil avec de nombreux souvenirs heureux."; }

		{ String _name = "ProfessionSmoker";			String _text = "Fumeur"; }
		{ String _name = "ProfessionSmokerTip";			String _text = "Un Fumeur fabrique des viandes fumées au Fumoir."; }
		{ String _name = "ProfessionSmokerDeath";		String _text = "a contracté la maladie du poumon noir."; }

		{ String _name = "ProfessionCarpenter";			String _text = "Menuisier"; }
		{ String _name = "ProfessionCarpenterTip";		String _text = "Un Menuisier peut fabriquer une variété de produits en bois."; }
		{ String _name = "ProfessionCarpenterDeath";	String _text = "est tombé sur son marteau et sa scie."; }
		
		{ String _name = "ProfessionFurnitureMaker";	String _text = "Menuisier"; }
		{ String _name = "ProfessionFurnitureMakerTip";	String _text = "Un Menuisier fabrique des meubles à partir de bois au bâtiment du Fabricant de Meubles, nécessaire pour construire certains bâtiments avancés."; }
		{ String _name = "ProfessionFurnitureMakerDeath";	String _text = "est tombé sur son marteau et sa scie."; }

		{ String _name = "ProfessionBoatMan";			String _text = "Charpentier de Marine"; }
		{ String _name = "ProfessionBoatManTip";		String _text = "Un Charpentier de Marine construit des Composants de Coque au Chantier Naval. Les composants de coque sont nécessaires principalement pour la construction de bâtiments de navires avancés et de navires marchands."; }
		{ String _name = "ProfessionBoatManDeath";		String _text = "est tombé d'un endroit élevé et s'est brisé le cou."; }

		{ String _name = "ProfessionPotter";			String _text = "Potier"; }
		{ String _name = "ProfessionPotterTip";			String _text = "Travaille au bâtiment du Potier pour créer de la Poterie. La Poterie est un article nécessaire pour la construction de certains bâtiments avancés."; }
		{ String _name = "ProfessionPotterDeath";		String _text = "a été enfermé dans l'argile."; }

		{ String _name = "ProfessionCharterTrader";		String _text = "Adjoint de Charte"; }
		{ String _name = "ProfessionCharterTraderTip";	String _text = "Un marchand qui aide à l'échange de biens et de ressources au bâtiment du Marchand Chartré."; }
		{ String _name = "ProfessionCharterTraderDeath";String _text = "est tombé dans l'escalier du quai et s'est noyé dans l'eau."; }
		
		{ String _name = "ProfessionQuartermaster";		String _text = "Intendant"; }
		{ String _name = "ProfessionQuartermasterTip";	String _text = "Responsable de l'approvisionnement en biens et ressources militaires au bâtiment de l'Intendant."; }
		{ String _name = "ProfessionQuartermasterDeath";String _text = "est tombé dans l'escalier du quai et s'est noyé dans l'eau."; }
		
		{ String _name = "ProfessionPacker";			String _text = "Emballeur"; }
		{ String _name = "ProfessionPackerTip";			String _text = "Emballe divers biens pour leur distribution vers les chantiers de construction de nouveaux bâtiments avancés. Travaille au Fournisseur de Construction et au Fournisseur d'Articles Ménagers."; }
		{ String _name = "ProfessionPackerDeath";		String _text = "a été accidentellement emballé dans une caisse, oublié pendant des jours, mort de faim."; }

		{ String _name = "ProfessionApothecary";		String _text = "Apothicaire"; }
		{ String _name = "ProfessionApothecaryTip";		String _text = "Crée des mixtures médicales que les personnes malades prennent chez un Herboriste pour consommation."; }
		{ String _name = "ProfessionApothecaryDeath";	String _text = "a expérimenté une mixture de trop."; }

		
		{ String _name = "ProfessionSoldier";			String _text = "Soldat"; }
		{ String _name = "ProfessionSoldierTip";		String _text = "Effectue des tâches militaires en première ligne et aux postes avancés."; }
		{ String _name = "ProfessionSoldierDeath";		String _text = "est mort au service de notre grande nation."; }

		{ String _name = "ProfessionGarrison";			String _text = "Garnison"; }
		{ String _name = "ProfessionGarrisonTip";		String _text = "Effectue des tâches militaires aux postes défensifs et d'approvisionnement."; }
		{ String _name = "ProfessionGarrisonDeath";		String _text = "est mort en défendant la colonie."; }

		{ String _name = "ProfessionGemSmith";			String _text = "Tailleur de Gemmes"; }
		{ String _name = "ProfessionGemSmithTip";		String _text = "Taille et polit les Pierres Précieuses Brutes."; }
		{ String _name = "ProfessionGemSmithDeath";		String _text = "a fui la colonie avec une poche pleine de gemmes."; }

		{ String _name = "ProfessionSmelter";			String _text = "Fondeur"; }
		{ String _name = "ProfessionSmelterTip";		String _text = "Convertit le Minerai d'Or et d'Argent en Florin d'Or ou Pfennig d'Argent, une monnaie utilisée pour acheter des biens ou pour le commerce."; }
		{ String _name = "ProfessionSmelterDeath";		String _text = "est tombé dans la presse de fonte."; }

		{ String _name = "ProfessionCarver";			String _text = "Sculpteur"; }
		{ String _name = "ProfessionCarverTip";			String _text = "Sculpte des statues en Bois et en Pierre au bâtiment du Sculpteur de Statues."; }
		{ String _name = "ProfessionCarverDeath";		String _text = "s'est accidentellement ouvert le poignet en sculptant et a saigné à mort sur ses outils."; }
		
		{ String _name = "ProfessionQuest";				String _text = "Aventurier"; }
		{ String _name = "ProfessionQuestTip";			String _text = "Envoie un brave aventurier à la recherche d'artéfacts dans de dangereuses ruines de temple"; }
		{ String _name = "ProfessionQuestDeath";		String _text = "a reçu une flèche empoisonnée dans le genou."; }

		{ String _name = "ProfessionTanner";			String _text = "Tanneur"; }
		{ String _name = "ProfessionTannerTip";			String _text = "Le Tanneur convertit les peaux animales brutes en cuir et autres textiles."; }
		{ String _name = "ProfessionTannerDeath";		String _text = "a été écorché vif."; }

		{ String _name = "ProfessionFuelRefiner";		String _text = "Raffineur de Combustible"; }
		{ String _name = "ProfessionFuelRefinerTip";	String _text = "Travaille à la Raffinerie de Combustible. Prend des combustibles domestiques comme le bois de chauffage ou le charbon de bois et les convertit en Combustible pour Fourneau pour usage industriel."; }
		{ String _name = "ProfessionFuelRefinerDeath";	String _text = "a brûlé complètement."; }

		{ String _name = "ProfessionTaxMan";			String _text = "Adjoint des Impôts"; }
		{ String _name = "ProfessionTaxManTip";			String _text = "Travaille au Bureau du Gouverneur. Collecte les impôts sous forme de Pfennig d'Argent pour l'usage de votre ville."; }
		{ String _name = "ProfessionTaxManDeath";		String _text = "est mort à cause des impôts."; }
		
		{ String _name = "ProfessionOfficial";			String _text = "Officiel"; }
		{ String _name = "ProfessionOfficialTip";		String _text = "Travaille dans certains bâtiments civiques tels que le Bureau du Gouverneur."; }
		{ String _name = "ProfessionOfficialDeath";		String _text = "a été tué par un Officiel ambitieux."; }

		{ String _name = "ProfessionWetworker";			String _text = "Ouvrier de Quai"; }
		{ String _name = "ProfessionWetworkerTip";		String _text = "Un ouvrier de quai effectue une gamme de travaux simples dans divers bâtiments de quai."; }
		{ String _name = "ProfessionWetworkerDeath";	String _text = "s'est noyé."; }
		
		{ String _name = "ProfessionTinneryworker";			String _text = "Ouvrier de Conserverie"; }
		{ String _name = "ProfessionTinneryworkerTip";		String _text = "Un Ouvrier de Conserverie est un ouvrier qui effectue la tâche de plier des feuilles d'étain en boîtes de conserve et de les remplir de nourriture. Les boîtes de conserve sont soudées pour préserver la fraîcheur."; }
		{ String _name = "ProfessionTinneryworkerDeath";	String _text = "a été pressé dans des boîtes de conserve (puis distribué !)."; }

