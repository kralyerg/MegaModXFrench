		{ String _name = "StitcherTip";					String _text = "Le Fabricant d'Uniformes est un spécialiste militaire concentré sur la production de fiers uniformes militaires. Ces uniformes sont essentiels au moral des soldats au combat et sont une composante importante de votre force militaire. Ne fabrique que la Livrée Complète."; }
		
		{ String _name = "Quartermaster";				String _text = "Intendant"; }
