		{ String _name = "ccGoldLlamaTip";				String _text = "Un Monument Autochtone."; }
		
		{ String _name = "CCPond1";						String _text = "Étang"; }
		{ String _name = "CCPond1Lwr";					String _text = "étang"; }
		{ String _name = "CCPond1Tip";					String _text = "Un Étang."; }
		{ String _name = "PondQuote1";					String _text = "Quand avez-vous passé pour la dernière fois un moment tranquille à ne rien faire ?"; }
		
		{ String _name = "CCPond2";						String _text = "Grand Étang"; }
		{ String _name = "CCPond2Lwr";					String _text = "grand étang"; }
		{ String _name = "CCPond2Tip";					String _text = "Un Grand Étang."; }
		{ String _name = "PondQuote2";					String _text = "Quand avez-vous passé pour la dernière fois un moment tranquille à ne rien faire près d'un grand étang ?"; }

		{ String _name = "SmugglersChest";				String _text = "Coffre de Contrebandiers"; }
		{ String _name = "SmugglersChestLwr";			String _text = "coffre de contrebandiers"; }
		{ String _name = "SmugglersChestTip";			String _text = "Coffre de Contrebandiers"; }

		{ String _name = "HealingBox";					String _text = "Boîte de Soins"; }
		{ String _name = "HealingBoxLwr";				String _text = "boîte de soins"; }
		{ String _name = "HealingBoxTip";				String _text = "Boîte de Soins"; }
		
		{ String _name = "ccSign1";						String _text = "Panneau de Quête"; }
		{ String _name = "ccSign1Lwr";					String _text = "panneau de quête"; }
		{ String _name = "ccSign11Tip";					String _text = "Fournit des informations."; }
		{ String _name = "QuoteSign1";					String _text = "Quête : La Malédiction du Lama Doré. Bienvenue dans la quête de la Malédiction du Lama Doré de Colonial Charter. Ce panneau peut être démoli mais ne peut pas être reconstruit. Des centaines d'années se sont écoulées depuis que l'ancienne civilisation vivant ici a été anéantie par une combinaison de maladies de l'ancien monde, de guerre et de famine. Des explorateurs avides, affluant ici en masse, ont disparu un par un dans les bois denses sans laisser de trace, pour ne plus jamais être revus. Ceux qui sont revenus ont vécu leur vie en hommes très riches. Maintenant vous êtes ici pour une raison totalement différente : survivre. Succomberez-vous au même sort que ces braves (peut-être stupides) hommes et femmes morts ? Ou paierez-vous les anciens dieux en sang pour votre richesse ?"; }
		{ String _name = "QuoteSign2";					String _text = "Quête : Il est temps pour une nouvelle frontière - l'ouest inexploré et inconnu, rempli d'animaux étranges, de tribus avancées d'Amérindiens et d'aventure. Vous disposez de nouvelles ressources et de nouveaux défis à relever - pourrez-vous vous lier d'amitié avec la tribu locale ou votre avant-poste naissant échouera-t-il à protéger vos citoyens des rigueurs de la vie aux confins du monde ?"; }
		
