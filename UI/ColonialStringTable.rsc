		{ String _name = "StreetLamp";					String _text = "Lanterne de Rue"; }
		{ String _name = "StreetLampLwr";				String _text = "lanterne de rue"; }
		{ String _name = "StreetLampTip";				String _text = "Une Lanterne de Rue décorative pour votre colonie."; }
		{ String _name = "QuoteLamp";					String _text = "Il vaut mieux allumer une lanterne que maudire l'obscurité."; }
		
		{ String _name = "CCStatue1";					String _text = "Statue de Charte en Pierre"; }
		{ String _name = "CCStatue1Lwr";				String _text = "statue de charte en pierre"; }
		{ String _name = "CCStatue1Tip";				String _text = "Une statue représentant le gouverneur de la colonie."; }
		{ String _name = "Quote1";						String _text = "Il se pourrait que le but de votre vie soit seulement de servir d'avertissement aux autres."; }

		{ String _name = "CCStatue2";					String _text = "Statue de Charte en Pierre"; }
		{ String _name = "CCStatue2Lwr";				String _text = "statue de charte en pierre"; }
		{ String _name = "CCStatue2Tip";				String _text = "Une statue représentant le gouverneur de la colonie à califourchon sur un lama."; }
		{ String _name = "Quote2";						String _text = "Le secret le plus sombre de cette colonie est que trop de ses citoyens s'imaginent encore appartenir à une civilisation bien supérieure, ailleurs."; }
		
		{ String _name = "CCStatue3";					String _text = "Statue de Cheval en Bois"; }
		{ String _name = "CCStatue3Lwr";				String _text = "statue de cheval en bois"; }
		{ String _name = "CCStatue3Tip";				String _text = "Une statue d'un cheval cabré."; }
		{ String _name = "Quote3";						String _text = "C'est un cheval, bien sûr !"; }
		
		{ String _name = "CCStatueJade1";				String _text = "Statue de Jade"; }
		{ String _name = "CCStatueJade1Lwr";			String _text = "statue de jade"; }
		{ String _name = "CCStatueJade1Tip";			String _text = "Une statue sculptée avec des influences venues d'une terre lointaine."; }
		{ String _name = "QuoteJade1";					String _text = "La Voie n'est pas dans le ciel ; la Voie est dans le cœur. - Gautama Bouddha"; }
		
		{ String _name = "CCStatueMarble1";				String _text = "Statue de Marbre"; }
		{ String _name = "CCStatueMarble1Lwr";			String _text = "statue de marbre"; }
		{ String _name = "CCStatueMarble1Tip";			String _text = "Une statue sculptée avec des influences venues d'une terre lointaine. Utilisez F pour changer l'apparence."; }
		{ String _name = "QuoteMarble1";				String _text = "J'ai vu l'ange dans le marbre et j'ai sculpté jusqu'à le libérer - Michel-Ange."; }
		
		{ String _name = "CCStatueIron1";				String _text = "Statue de Fer"; }
		{ String _name = "CCStatueIron1Lwr";			String _text = "Statue en Fer"; }
		{ String _name = "CCStatueIron1Tip";			String _text = "Une statue de la cloche du palais de justice représentant la justice pour le peuple de la colonie."; }
		{ String _name = "QuoteIron1";					String _text = "Car nous devons considérer que nous serons comme une ville sur une colline. Les yeux de tous les peuples sont fixés sur nous. - John Winthrop."; }
		
		{ String _name = "LionStatue";					String _text = "Statue de Bronze"; }
		{ String _name = "LionStatueLwr";				String _text = "statue de bronze"; }
		{ String _name = "LionStatueTip";				String _text = "Une série de statues en Bronze élégantes et puissantes. Nécessite de la pierre et une statue de bronze pour être construite. Utilisez F pour changer l'apparence."; }
		
		{ String _name = "ccGoldLlama";					String _text = "Monument Autochtone"; }
