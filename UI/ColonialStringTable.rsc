		{ String _name = "ForwardpostTip";				String _text = "Cet avant-poste représente l'une des incursions de votre force militaire en territoire ennemi. Une guerre réussie à cette époque nécessite des fusils et de fiers uniformes colorés, mais à mesure que vous vainquez vos ennemis, l'avant-poste générera de nombreux objets utiles pour votre colonie - y compris diverses fournitures de construction lucratives, des artéfacts précieux ou des marchandises rares capturées sur les vaincus."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Nécessite : Mousquets et Livrée Complète et Fournitures Militaires. Produit : Assortiment aléatoire de Florins d'Or, Composant de Coque, Articles Ménagers, Meubles Élégants, Fournitures de Construction, Solive, Jade, Marbre, Soie, Huile de Lampe, Statue de Marbre, Statue de Jade, Statue de Pierre, Statue de Bois, Artéfact Autochtone."; }

		{ String _name = "MusketRange";					String _text = "Champ de Tir aux Mousquets"; }
		{ String _name = "MusketRangeLwr";				String _text = "champ de tir aux mousquets"; }
		{ String _name = "MusketRangeTip";				String _text = "C'est là que les soldats de votre colonie s'entraînent pour être les meilleurs et les plus prêts à affronter tout ce que ce monde leur réserve. Pendant l'entraînement nécessaire, des ressources vitales pour la survie de votre colonie (telles que des outils, des vêtements et du combustible) seront produites."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Nécessite : Pfennig et Biscuit de Mer. Produit : Assortiment aléatoire d'Outil en Acier, Bois de Chauffage, Manteau en Pois, Combustible pour Fourneau, Charbon de Bois."; }

