		{ String _name = "NewTrees2LiteHardDesc";	String _text = "Version allégée pour la performance. Une partie Difficile standard avec uniquement de nouveaux arbres du mod - à l'exclusion des palmiers. Une partie difficile débute avec quatre familles. Une petite quantité de vêtements, nourriture, bois de chauffage et outils est fournie. Aucune graine pour l'agriculture n'est disponible."; }

		{ String _name = "NewTrees2LiteAEName";		String _text = "[CC] Nuevo Arbol Lite - Adam et Ève"; }
		{ String _name = "NewTrees2LiteAEDesc";		String _text = "Version allégée pour la performance. Une partie Adam et Ève standard avec uniquement de nouveaux arbres du mod - à l'exclusion des palmiers. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucune graine ni bétail n'est initialement disponible - vous devrez tout survivre et acquérir par vous-même."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] La Malédiction du Lama Doré - Facile"; }
		{ String _name = "LlamaEasyDesc";		String _text = "La Malédiction du Lama Doré est ce qui se rapproche le plus d'un mystère dans le monde de Banished. Qu'est-ce que le Lama Doré ? Quels mystères recèle-t-il ? Oserez-vous explorer son intérieur obscur ? Cette partie débute selon les paramètres Facile habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un trésor."; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] La Malédiction du Lama Doré - Moyen"; }
		{ String _name = "LlamaMediumDesc";		String _text = "La Malédiction du Lama Doré est ce qui se rapproche le plus d'un mystère dans le monde de Banished. Qu'est-ce que le Lama Doré ? Quels mystères recèle-t-il ? Oserez-vous explorer son intérieur obscur ? Cette partie débute selon les paramètres Moyen habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un trésor."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] La Malédiction du Lama Doré - Difficile"; }
		{ String _name = "LlamaHardDesc";		String _text = "La Malédiction du Lama Doré est ce qui se rapproche le plus d'un mystère dans le monde de Banished. Qu'est-ce que le Lama Doré ? Quels mystères recèle-t-il ? Oserez-vous explorer son intérieur obscur ? Cette partie débute selon les paramètres Difficile habituels, mais inclut l'option de partir à l'aventure pour tenter de trouver un trésor."; }

		{ String _name = "LlamaAEName";			String _text = "[CC] La Malédiction du Lama Doré - Adam et Ève"; }
		{ String _name = "LlamaAEDesc";			String _text = "La Malédiction du Lama Doré est ce qui se rapproche le plus d'un mystère dans le monde de Banished. Qu'est-ce que le Lama Doré ? Quels mystères recèle-t-il ? Oserez-vous explorer son intérieur obscur ? Cette partie débute selon les paramètres Adam et Ève, mais inclut l'option de partir à l'aventure pour tenter de trouver un trésor."; }

		{ String _name = "OldCastleHardName";		String _text = "[CC] Vieux Château - Difficile"; }
		{ String _name = "OldCastleHardDesc";		String _text = "Débutez sur le site d'un Vieux Château offrant un immense potentiel de stockage. Des vivres conservées et une petite quantité de vêtements, outils et bois de chauffage ont été découverts. Aucune graine ni bétail n'est présent."; }

		{ String _name = "BayouEasyName";		String _text = "[CC] Bayou - Facile"; }
		{ String _name = "BayouEasyDesc";		String _text = "Le Bayou fournit tout ce qu'il faut pour lancer une ville portuaire. Un peu de riz, d'outils, de vêtements et de bois de chauffage est fourni. Des poulets se trouvent également à proximité."; }

		{ String _name = "PlainsEasyName";		String _text = "Plaines - Facile"; }
		{ String _name = "PlainsEasyDesc";		String _text = "Test"; }

		{ String _name = "FantasyEasyName";		String _text = "[CC] Toutes les Merveilles Sauvages - Facile"; }
		{ String _name = "FantasyEasyDesc";		String _text = "La terre est couverte de toutes sortes de ressources alimentaires naturelles, prêtes à être récoltées dans la nature. Les roches et le fer se régénèrent également. Cette carte est extrêmement facile et irréaliste en raison de l'abondance de ressources non naturelles poussant constamment dans la nature. Il s'agit sinon d'un départ facile typique."; }

		{ String _name = "FantasyAEName";		String _text = "[CC] Toutes les Merveilles Sauvages - Adam et Ève"; }
		{ String _name = "FantasyAEDesc";		String _text = "La terre est couverte de toutes sortes de ressources alimentaires naturelles, prêtes à être récoltées dans la nature. Les roches et le fer se régénèrent également. Cette carte est extrêmement facile et irréaliste en raison de l'abondance de ressources non naturelles poussant constamment dans la nature. Il s'agit sinon d'un départ Adam et Ève typique."; }

		{ String _name = "ShipwreckHardName";		String _text = "[CC] Naufrage - Difficile"; }
		{ String _name = "ShipwreckHardDesc";		String _text = "Naufragés dans une terre inconnue, votre peuple n'a que son ingéniosité et ce qu'il peut récupérer de l'épave."; }

		{ String _name = "ShipwreckElDoradoHardName";	String _text = "[CC] Naufrage - El Dorado - Difficile"; }
		{ String _name = "ShipwreckElDoradoHardDesc";	String _text = "Naufragés dans une terre inconnue, votre peuple n'a que son ingéniosité et ce qu'il peut récupérer de l'épave. Une partie avec uniquement de nouveaux arbres du mod."; }

		{ String _name = "ShipwreckJungleHardName";	String _text = "[CC] Naufrage - Jungle - Difficile"; }
		{ String _name = "ShipwreckJungleHardDesc";	String _text = "Naufragés dans une terre inconnue, votre peuple n'a que son ingéniosité et ce qu'il peut récupérer de l'épave. Une partie avec uniquement des arbres de jungle du mod."; }

		{ String _name = "ShipwreckPinesHardName";	String _text = "[CC] Naufrage - Pins du Nord - Difficile"; }
		{ String _name = "ShipwreckPinesHardDesc";	String _text = "Naufragés dans une terre inconnue, votre peuple n'a que son ingéniosité et ce qu'il peut récupérer de l'épave. Une partie avec uniquement des pins du mod."; }

		{ String _name = "ShipwreckMediumName";		String _text = "[CC] Naufrage - Moyen+"; }
		{ String _name = "ShipwreckMediumDesc";		String _text = "Naufragés dans une terre inconnue, une petite quantité de bois et de pierre, ainsi qu'une graine et du bétail, ont été récupérés de l'épave."; }

		{ String _name = "ShipwreckElDoradoMediumName";	String _text = "[CC] Naufrage - El Dorado - Moyen+"; }
		{ String _name = "ShipwreckElDoradoMediumDesc";	String _text = "Naufragés dans une terre inconnue, une petite quantité de bois et de pierre, ainsi qu'une graine et du bétail, ont été récupérés de l'épave."; }

		{ String _name = "ShipwreckJungleMediumName";	String _text = "[CC] Naufrage - Jungle - Moyen+"; }
		{ String _name = "ShipwreckJungleMediumDesc";	String _text = "Naufragés dans une terre inconnue, une petite quantité de bois et de pierre, ainsi qu'une graine et du bétail, ont été récupérés de l'épave."; }

		{ String _name = "ShipwreckPinesMediumName";	String _text = "[CC] Naufrage - Pins du Nord - Moyen+"; }
		{ String _name = "ShipwreckPinesMediumDesc";	String _text = "Naufragés dans une terre inconnue, une petite quantité de bois et de pierre, ainsi qu'une graine et du bétail, ont été récupérés de l'épave."; }

		{ String _name = "AbandonedJungleHardName";	String _text = "[CC] Village Abandonné - Jungle"; }
		{ String _name = "AbandonedJungleHardDesc";	String _text = "Au cœur de la jungle, votre peuple découvre les vestiges d'une ancienne colonie indépendante. Vous disposez de la même quantité de ressources qu'un départ Difficile standard, mais certaines maisons sont déjà construites ou partiellement construites."; }

		{ String _name = "AbandonedPinesHardName";	String _text = "[CC] Village Abandonné - Pins du Nord"; }
