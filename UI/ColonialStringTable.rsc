		{ String _name = "FuelRefinery";				String _text = "Raffinerie de Combustible"; }
		{ String _name = "FuelRefineryLwr";				String _text = "raffinerie de combustible"; }
		{ String _name = "FuelRefineryTip";				String _text = "Une Raffinerie de Combustible prend des ressources naturelles combustibles et les transforme en une forme plus chaude, plus désirable pour les fonderies industrielles (plus chaude, brûlant plus longtemps)."; }
		
		{ String _name = "IndustrySmall2";				String _text = "Petite Raffinerie de Combustible"; }
		{ String _name = "IndustrySmall2Lwr";			String _text = "petite raffinerie de combustible"; }
		{ String _name = "IndustrySmall2Tip";			String _text = "Fabrique du Combustible pour Fourneau. Un seul ouvrier peut y travailler, et elle est légèrement moins efficace que la plus grande Raffinerie de Combustible (par homme)."; }
		
		{ String _name = "IndustrySmall";				String _text = "Petite Fonderie de Fer"; }
		{ String _name = "IndustrySmallLwr";			String _text = "petite fonderie de fer"; }
		{ String _name = "IndustrySmallTip";			String _text = "Une Petite Fonderie de Fer ne produit que du Fer en prenant du Minerai de Fer et du Combustible pour Fourneau. Un seul ouvrier peut y travailler, et elle est moins efficace que les plus grands bâtiments de Fonderie et de Forge."; }

		{ String _name = "Forge";						String _text = "Forge"; }
		{ String _name = "ForgeLwr";					String _text = "forge"; }
		{ String _name = "ForgeTip";					String _text = "Crée du Fer à partir du Minerai de Fer. Crée aussi de l'Étain, du Cuivre, du Bronze et de l'Étain Blanc. Peut fabriquer des Canons, des Solives, des Statues de Fer et des Statues de Bronze ainsi que des Outils en Bronze. Ne nécessite pas d'emplacement en bord d'eau."; }
		
		{ String _name = "SWShack";						String _text = "Pêcherie de Quai"; }
		{ String _name = "SWShackLwr";					String _text = "pêcherie de quai"; }
		{ String _name = "SWShackTip";					String _text = "Une Pêcherie construite sur un Mur de Quai. Plus il y a d'eau à proximité, plus il y a de poissons capturés."; }
		
		{ String _name = "Tannery";						String _text = "Tannerie"; }
		{ String _name = "TanneryLwr";					String _text = "tannerie"; }
		{ String _name = "TanneryTip";					String _text = "Utilise du sel et du cuir pour créer du Cuir (Tanné) qui est nécessaire pour certains vêtements avancés et améliore la valeur commerciale."; }

		{ String _name = "Foundry";						String _text = "Fonderie"; }
		{ String _name = "FoundryLwr";					String _text = "fonderie"; }
		{ String _name = "FoundryTip";					String _text = "Crée du Fer à partir du Minerai de Fer. Crée aussi de l'Étain, du Cuivre, du Bronze et de l'Étain Blanc. Peut fabriquer des Canons, des Solives, des Statues de Fer et des Statues de Bronze ainsi que des Outils en Bronze. Ceci est fait en versant des métaux en fusion dans des moules. Alimentée par une roue à eau et légèrement plus efficace que la Forge."; }


	// ##################################################
	// ##    Alcohol & tobacco production buildings    ##
	// ##################################################
		{ String _name = "Kitchen";						String _text = "Cuisine de Pub"; }
		{ String _name = "KitchenLwr";					String _text = "cuisine de pub"; }
		{ String _name = "KitchenTip";					String _text = "Une Cuisine de Pub prendra une gamme d'aliments ordinaires et les préparera en une variété de repas de luxe populaires dans les Tavernes."; }
		
		{ String _name = "Alegarden";					String _text = "Auberge et Jardin"; }
		{ String _name = "AlegardenLwr";				String _text = "auberge et jardin"; }
		{ String _name = "AlegardenTip";				String _text = "Une auberge et un jardin publics sont un lieu où les gens se rassemblent pour toutes sortes de réjouissances sociales. C'est un grand lieu de stockage pour tout l'alcool, les produits de luxe et de tabagisme (comme le tabac à pipe). Un ouvrier n'est pas requis mais aidera à déplacer les Luxes vers le stockage pour la consommation."; }
		
		{ String _name = "Taverna";						String _text = "Petite Taverne"; }
		{ String _name = "TavernaLwr";					String _text = "petite taverne"; }
		{ String _name = "TavernaTip";					String _text = "Fournit un stockage et une consommation de luxe pour votre peuple. C'est un petit lieu de stockage et de consommation pour tout l'alcool, les produits de luxe et de tabagisme (comme le tabac à pipe). Un ouvrier n'est pas requis mais aidera à déplacer les Luxes vers le stockage pour la consommation."; }
		
		{ String _name = "TavernMedium";				String _text = "Taverne"; }
		{ String _name = "TavernMediumLwr";				String _text = "taverne"; }
		{ String _name = "TavernMediumTip";				String _text = "Un lieu où les gens se rassemblent pour toutes sortes de réjouissances sociales. C'est un lieu de stockage et de consommation pour tout l'alcool, les produits de luxe et de tabagisme (comme le tabac à pipe). Un ouvrier n'est pas requis mais aidera à déplacer les Luxes vers le stockage pour la consommation."; }
		
		{ String _name = "coffeehouse";					String _text = "Café"; }
		{ String _name = "coffeehouseLwr";				String _text = "café"; }
		{ String _name = "coffeehouseTip";				String _text = "Le café peut y être fraîchement infusé pour satisfaire les goûts de la clientèle. C'est aussi un lieu de stockage et de consommation pour tout l'alcool, les produits de luxe et de tabagisme (comme le tabac à pipe). Un ouvrier n'est pas requis mais pourra y infuser du café à partir de grains de café."; }

		{ String _name = "Tavern";						String _text = "Brasserie"; }
		{ String _name = "TavernLwr";					String _text = "brasserie"; }
		{ String _name = "TavernTip";					String _text = "Brasse de l'alcool et rend les citoyens heureux. Les produits créés doivent aller à une Auberge et Jardin, une Taverne ou un Alambic pour la consommation."; }

		{ String _name = "SWBrewery";					String _text = "Brasserie de Quai"; }
		{ String _name = "SWBreweryLwr";				String _text = "brasserie de quai"; }
		{ String _name = "SWBreweryTip";				String _text = "Brasse de l'alcool et rend les citoyens heureux. Les produits créés doivent aller à une Auberge et Jardin, une Taverne ou un Alambic pour la consommation."; }

		{ String _name = "Winery";						String _text = "Cave à Vin"; }
		{ String _name = "WineryLwr";					String _text = "cave à vin"; }
		{ String _name = "WineryTip";					String _text = "Une Cave à Vin fabrique du vin à partir de raisins et d'autres fruits. Le vin produit doit être stocké dans une Auberge et Jardin, une Taverne ou un Alambic pour la consommation."; }

		{ String _name = "Distillery";					String _text = "Distillerie"; }
		{ String _name = "DistilleryLwr";				String _text = "Distillerie"; }
		{ String _name = "DistilleryTip";				String _text = "Une Distillerie est l'endroit où les céréales et autres matières organiques sont distillées et mises en bouteille sous forme de spiritueux. Les produits finis doivent être stockés dans une Auberge et Jardin, une Taverne ou un Alambic pour la consommation."; }

		{ String _name = "Tobaccobarn";					String _text = "Grange de Séchage"; }
		{ String _name = "TobaccobarnLwr";				String _text = "grange de séchage"; }
		{ String _name = "TobaccobarnTip";				String _text = "C'est ici que le tabac est séché à l'air pour devenir du tabac à pipe destiné au fumage. Les produits finis doivent être stockés dans une Auberge et Jardin, une Taverne ou un Alambic pour la consommation."; }

