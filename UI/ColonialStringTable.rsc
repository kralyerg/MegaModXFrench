		{ String _name = "StoneWindmillTip";			String _text = "Pressoir à Huile"; }

		{ String _name = "Oilpress";					String _text = "pressoir à huile"; }
		{ String _name = "OilpressLwr";					String _text = "Un Pressoir à Huile extrait l'huile des olives et des graines de tournesol, de lin et de coton récoltées, ainsi que de la graisse de baleine. L'Huile de Lampe est mieux pressée à partir d'huile de baleine, mais peut être fabriquée à partir d'autres matières organiques à un certain coût."; }
