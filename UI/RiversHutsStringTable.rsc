			String _text = "récolter la nourriture sauvage";
		}
		{
			String _name = "ClearWildFoodTip";
			String _text = "Collecte et récolte les apparitions de nourriture sauvage dans la zone sélectionnée. Astuce : la nourriture sauvage apparaît à partir des arbres et beaucoup de nouvelle nourriture apparaît à partir des fleurs.";
		}
		{
			String _name = "ClearFodder";
			String _text = "Récolter le fourrage";
		}
		{
			String _name = "ClearFodderLwr";
			String _text = "récolter le fourrage";
		}
		{
			String _name = "ClearFodderTip";
			String _text = "Collecte et récolte les parcelles de fourrage-chaume dans la zone sélectionnée. Astuce : le fourrage-chaume est le matériau obtenu en récoltant les parcelles d'herbe visibles au sol. Le fourrage peut être utilisé dans les étables, transformé en fagots (bois de chauffage par les bûcherons), ou utilisé comme matériau de construction (rucher, pâturage sans clôture, grange à fourrage...). Chaque parcelle d'herbe produit 4-6 fourrage-chaume (valeur 1). Ceux-ci sont stockés dans une réserve de construction.";
		}
		{
			String _name = "ClearFlower";
			String _text = "Récolter les fleurs";
		}
		{
			String _name = "ClearFlowerLwr";
			String _text = "récolter les fleurs";
		}
		{
			String _name = "ClearFlowerTip";
			String _text = "Collecte et récolte les apparitions de fleurs dans la zone sélectionnée. Astuce : les fleurs ont le statut divers. Chaque parcelle de fleurs produit 3-5 fleurs (valeur 1). Assurez-vous d'avoir des granges acceptant les objets divers.";
		}
		{
			String _name = "ClearHerb";
			String _text = "Récolter les herbes";
		}
		{
			String _name = "ClearHerbLwr";
			String _text = "récolter les herbes";
		}
		{
			String _name = "ClearHerbTip";
			String _text = "Collecte et récolte les apparitions d'herbes dans la zone sélectionnée. Astuce : les herbes sont utilisées chez l'herboriste (ou aux bains) pour récupérer 1/2 cœur par utilisation. Chaque parcelle d'herbes produit 2-3 herbes (valeur 4). Les herbes nécessitent un stockage de type grange.";
		}
		{
			String _name = "ClearCopper";
			String _text = "Récolter le cuivre et l'étain";
		}
		{
			String _name = "ClearCopperLwr";
			String _text = "récolter le cuivre";
		}
		{
			String _name = "ClearCopperTip";
			String _text = "Collecte tout le cuivre, l'étain et les autres minéraux rares (or et argent) dans la zone sélectionnée. Astuce : le cuivre est utilisé pour fabriquer certains outils et aussi comme matériau de construction. Le cuivre et les autres minerais rares sont des minéraux. Assurez-vous d'avoir une réserve de matériaux disponible. 2-3 minerais de cuivre sont extraits (valeur 4), 1-2 minerais d'argent (valeur 11) ou 1-2 minerais d'or (valeur 22). Assurez-vous d'avoir une réserve de minéraux disponible pour les stocker. ";
		}
		{
			String _name = "ClearAlmostAll";
			String _text = "Récolter presque tout";
		}
		{
			String _name = "ClearAlmostAllLwr";
			String _text = "récolter presque tout";
		}
		{
			String _name = "ClearAlmostAllTip";
			String _text = "Collecte tous les minerais et pierres dans la zone sélectionnée. Astuce : cet outil spécial rassemblera tous les minerais et toutes les pierres. Il ne retirera pas les arbres, l'herbe et les autres ressources sauvages précieuses. Très utile pour nettoyer rapidement tous les terrains autour des forestiers.";
		}
		{
			String _name = "ClearFirewood";
			String _text = "Récolter le bois mort";
		}
		{
			String _name = "ClearFirewoodLwr";
			String _text = "récolter le bois mort";
		}
		{
			String _name = "ClearFirewoodTip";
			String _text = "Collecte tout le bois mort dans la zone sélectionnée pour en faire du bois de chauffage. Astuce : le bois mort provient des arbres morts tombés. La récolte du bois mort produit 5-8 bois de chauffage par arbre mort.";
		}
		{
			String _name = "ClearIron";
			String _text = "Récolter le minerai de fer";
		}
		{
