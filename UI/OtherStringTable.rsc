		{ String _name = "NoTreeEasy";			String _text = "Sans Arbres - Facile"; }
		{ String _name = "NoTreeEasyDesc";		String _text = "Sans arbres. Une partie facile commence avec six familles. Une grande quantité de vêtements, 
