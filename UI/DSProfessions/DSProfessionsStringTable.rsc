StringTable Chandler
{
	Entry _strings
	[
		{
			String _name = "ProfessionChandler";
			String _text = "Chandelier";
		}
		{
			String _name = "ProfessionChandlerTip";
			String _text = "Un chandelier est un maître dans la fabrication de chandelles.";
		}
		{
			String _name = "ProfessionChandlerDeath";
			String _text = "est mort.";
		}
	]

}

StringTable CharcoalBurner
{
