			String _name = "ProfessionCharcoalBurner";
			String _text = "Charbonnier";
		}
		{
			String _name = "ProfessionCharcoalBurnerTip";
			String _text = "Un charbonnier produit du charbon de bois en carbonisant des rondins, et est également employé pour faire fonctionner les fours à coke.";
		}
		{
			String _name = "ProfessionCharcoalBurnerDeath";
			String _text = "est mort d'une inhalation de fumée.";
		}
	]

}

