		{ String _name = "DSNormalStoneBridgeLTip";		String _text = "côté gauche du pont de construction normale, à placer de rive à rive. avec la carte orientée vers le nord, ce pont sera à gauche lors de la traversée dans une direction nord-sud. avec une direction est-ouest, ce pont sera sur le côté supérieur ou nord du pont. ce pont n'inclut pas les rampes/escaliers d'extremite, vous devez les construire séparément. nécessite 5 travail par case"; }
		
		{ String _name = "DSNormalStoneBridgeR";		String _text = "Pont de pierre droit"; }
		{ String _name = "DSNormalStoneBridgeRLwr";		String _text = "pont de pierre droit"; }
		{ String _name = "DSNormalStoneBridgeRTip";		String _text = "côté droit du pont de construction normale, à placer de rive à rive. avec la carte orientée vers le nord, ce pont sera à droite lors de la traversée dans une direction nord-sud. avec une direction est-ouest, ce pont sera en dessous ou du côté sud du pont. ce pont n'inclut pas les rampes/escaliers d'extremite, vous devez les construire séparément. nécessite 5 travail par case"; }
		
		
