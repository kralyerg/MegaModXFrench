	Entry _strings
	[
		{
			String _name = "Huoshan";
			String _text = "[IC]Saint-Volcan-Astor Yao";
		}
		{
			String _name = "HuoshanLwr";
			String _text = "[IC]Saint-Volcan-Astor Yao";
		}
		{
			String _name = "HuoshanTip";
			String _text = "Un continent des temps anciens. Veuillez choisir le meilleur terrain, avec le plus de plaines possible. Comme on vit près du Saint-Volcan, les habitants de cette région vivent jusqu'à 60 ans et ont des enfants entre 10 et 50 ans, mais ils se déplacent plus vite et travaillent plus efficacement ; n'introduisez donc pas de réfugiés. La partie commence aux abords du Saint-Volcan, qui peut bénir l'outil maudit pour en faire un outil sacré (utilisable indéfiniment par quelqu'un).";
		}
		{
			String _name = "Dachengbao";
			String _text = "L'immense château";
		}
		{
			String _name = "DachengbaoLwr";
			String _text = "L'immense château";
		}
		{
			String _name = "DachengbaoTip";
			String _text = "L'un des bâtiments miraculeux. Il peut activer le mode triche (le Mode Divin), mais son coût est élevé.";
		}
		{
			String _name = "Jingzhimianfen";
			String _text = "Farine raffinée";
		}
		{
			String _name = "Bukejianzhishi";
			String _text = "Pierre invisible";
		}
		{
			String _name = "UpStoneHouse";
			String _text = "*Maison en pierre bénie";
		}
		{
			String _name = "UpStoneHouseLwr";
			String _text = "*Maison en pierre bénie";
		}
		{
			String _name = "UpStoneHouseTip";
			String _text = "Obtenez la Bénédiction de Sainte-Belle. La maison en pierre bénie ne sera plus affectée par les incendies ni les tornades. La reconstruction de ce bâtiment nécessite la Larme de Sainte-Belle. Vous pouvez obtenir la Larme de Sainte-Belle en élevant la Poule Sainte-Belle.";
		}
		{
			String _name = "UpChapel";
			String _text = "*Chapelle bénie";
		}
		{
			String _name = "UpChapelLwr";
			String _text = "*Chapelle bénie";
		}
		{
			String _name = "UpChapelTip";
			String _text = "Obtenez la Bénédiction de Sainte-Belle et l'Âme de la Pluie Triste. La chapelle bénie ne sera plus affectée par les incendies ni les tornades, et sa capacité sera doublée. La reconstruction de ce bâtiment nécessite la Larme de Sainte-Belle. L'Âme de la Pluie Triste peut améliorer la fonction du bâtiment. Vous pouvez obtenir la Larme de Sainte-Belle en élevant la Poule Sainte-Belle. Vous pouvez obtenir l'Âme de la Pluie Triste en creusant une tombe, mais vous devez d'abord démanteler la pierre tombale.";
		}
