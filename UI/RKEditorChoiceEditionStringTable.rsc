		{ String _name = "NMT20AleStand";			String _text = "Ale Stand"; }
		{ String _name = "NMT20AleStandLwr";			String _text = "ale stand"; }
		{ String _name = "NMT20AleStandTip";			String _text = "Ale Stand est taking tout votre alcohols et offer ces à votre citoyens. Taille : 4x3. Cout : 16 rondins. Capacite : 3000 poids. Rayon : 20 cases. Emplois : 1-2 brasseurs. Astuces : Le brasseurs va go around et grab tout alcohols dans le town et fill leur stand. citoyens peut pickup alcohols et obtenir (0.05%) happiness de il."; }

		{ String _name = "NMT30CharcoalKiln";			String _text = "charbon de bois Kiln"; }
		{ String _name = "NMT30CharcoalKilnLwr";		String _text = "charbon de bois kiln"; }
		{ String _name = "NMT30CharcoalKilnTip";		String _text = "charbon de bois Kiln est taking bois de chauffage et do charbon de bois avec ces. Taille : 6x6. Cout : 12 rondins, 32 pierre. Peut fabriquer : 18-24 charbon de bois de 12 bois de chauffage. Emplois : 1-2 ouvriers. Astuces : Double votre amount de Combustible et fournit enough Combustible pour double housing à compare avec bois de chauffage."; }

		{ String _name = "NMT30FurnitureMaker";			String _text = "Furniture Maker"; }
		{ String _name = "NMT30FurnitureMakerLwr";		String _text = "furniture maker"; }
		{ String _name = "NMT30FurnitureMakerTip";		String _text = "Furniture Maker est taking bois de charpente, Bois, et certains expensive metals et do nice furnitures. Taille : 8x9. Cout : 34 rondins, 48 bois de charpente, 32 stones, 24 fer, 8 verre. Peut fabriquer : furniture, fine furniture, silvered furniture, gilded furniture. Emplois : 1-2 ouvriers. Astuces : Fabrique certains de le meilleur endgame selling resources."; }

		{ String _name = "NMT30WeaponMaker";			String _text = "Weapon Maker"; }
		{ String _name = "NMT30WeaponMakerLwr";			String _text = "weapon maker"; }
		{ String _name = "NMT30WeaponMakerTip";			String _text = "Weapon Maker est taking fer, Bois, et certains expensive metal et do deadly weapons. Taille : 7x9. Cout : 28 rondins, 42 bois de charpente, 38 stones, 36 fer, 4 verre. Peut fabriquer : weapon, fine weapon, noble weapon, royal weapon. Emplois : 1-2 toolmakers. Astuces : Fabrique certains de le meilleur endgame selling resources."; }

		{ String _name = "NMT30ArmorMaker";			String _text = "Armor Maker"; }
		{ String _name = "NMT30ArmorMakerLwr";			String _text = "armor maker"; }
		{ String _name = "NMT30ArmorMakerTip";			String _text = "Armor Maker est taking fer, Bois, et certains expensive metal et do sheilds et armor pieces. Taille : 8x9. Cout : 32 rondins, 40 bois de charpente, 32 stones, 36 fer, 6 verre. Peut fabriquer : shield, fine armor, noble armor, royal armor. Emplois : 1-2 toolmakers. Astuces : Fabrique certains de le meilleur endgame selling resources."; }


		{ String _name = "ForesterLodge2";		String _text = "forestiers Lodge 2"; }
		{ String _name = "ForesterLodge2Lwr";		String _text = "forestiers lodge 2"; }
