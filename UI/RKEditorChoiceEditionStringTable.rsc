		{ String _name = "OrchardLodgesToolbarLwr";		String _text = "orchard lodges barre d outils"; }
		{ String _name = "OrchardLodgesToolbarTip";		String _text = "Orchard Lodges Barre d outils. Ouvrir ce barre d outils à obtenir Orchard Lodges options. (Utilise à define un area à selectively cut bas trees et plant new Fruit trees seedlings. Cout : 32 Bois, 12 pierre. Rayon : 24 cases. Emplois : 1-2 forestiers.)"; }

		{ String _name = "OrchardLodges2Toolbar";		String _text = "Tropical Lodges Barre d outils"; }
		{ String _name = "OrchardLodges2ToolbarLwr";		String _text = "tropical lodges barre d outils"; }
		{ String _name = "OrchardLodges2ToolbarTip";		String _text = "Tropical Lodges Barre d outils. Ouvrir ce barre d outils à obtenir Tropical Orchard Lodges options. (Utilise à define un area à selectively cut bas trees et plant new tropical Fruit trees seedlings. Cout : 32 Bois, 12 pierre. Rayon : 24 cases. Emplois : 1-2 forestiers.)"; }

		{ String _name = "OrchardLodgeAppleTree";		String _text = "Apple Lodge"; }
		{ String _name = "OrchardLodgeAppleTreeLwr";		String _text = "apple lodge"; }
		{ String _name = "OrchardLodgeAppleTreeTip";		String _text = "Utilise à define un area à selectively cut bas trees et plant new apple trees seedlings. Taille : 5x6. Cout : 32 rondins, 12 pierre. Rayon : 24 cases. Emplois : 1-2 forestiers. Astuces : De tout va etre removed et replaced par un apple tree qui va spawn buckets de apples au fil du temps. Il est comme un orchard mais set haut comme un forestiers lodge."; }

