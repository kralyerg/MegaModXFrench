		{ String _name = "CountryLittleHouseToolbarLwr";		String _text = "country petit house 1 barre d outils"; }
		{ String _name = "CountryLittleHouseToolbarTip";		String _text = "Country Petit House 1 Barre d outils. Ouvrir ce barre d outils à obtenir Country Petit House options. Ce est un set de 3 batiments: un house (center), un pantry (droite), un stockage (gauche). Couleurs : 5 variantes."; }

		{ String _name = "CountryLittleStock";			String _text = "Petit Entrepot de Campagne"; }
		{ String _name = "CountryLittleStockLwr";		String _text = "petit Entrepot de Campagne"; }
		{ String _name = "CountryLittleStockTip";		String _text = "Country Petit Stockage peut etre utilise pour un petit stockage. Taille : 2x4. Cout : 16 bois de charpente. Capacite : 2000 poids. Accepte : Combustible, Minerals, Tool, Herbes, Vetements, Textile, Artisanal, Forge, Tissus, Industriel, Materiaux, Construction, Precieux, Divers. Astuces : Le stockage goes à le gauche de le house et fabrique sure à align ces arriere walls. Appuyez sur F pour changer de couleur."; }

