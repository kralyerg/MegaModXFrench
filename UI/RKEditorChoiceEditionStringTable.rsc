		{ String _name = "PastureFenceless";			String _text = "Paturage Sans Cloture"; }
		{ String _name = "PastureFencelessLwr";			String _text = "paturage Sans Cloture"; }
		{ String _name = "PastureFencelessTip";			String _text = "Un Pasture Fenceless fournit une zone de paturage pour le betail. Taille : de 7x7 à 30x30. Cout : 1 Fodder-Thatch par case. Emplois : 1-4 eleveurs. Astuces : Utiliser R ou T à rotate le pasture pour making sure le animal abriter est closest à barns et dans un mountain slope."; }

		{ String _name = "MarketMed";				String _text = "Marche"; }
		{ String _name = "MarketMedLwr";			String _text = "marche"; }
		{ String _name = "MarketMedTip";			String _text = "Utilise à fournit un localized area pour citoyens à collect food, tools, et Combustible. Taille : 10x10. Cout : 32 bois de charpente, 30 pierre, 22 fer. Capacite : 12000 poids. Rayon : 36 cases. Stockage : Comestibles, Combustible, Tool, Sante, Vetements. Emplois : 1-8 vendeurs. Astuces : One de le meilleur à fournit goods à citizen homes. Smaller que grand one."; }

		{ String _name = "RKFCLumbermill";			String _text = "Scierie"; }
		{ String _name = "RKFCLumbermillLwr";			String _text = "scierie"; }
		{ String _name = "RKFCLumbermillTip";			String _text = "Lumbermill est utilise à fabrique bois de charpente de rondins. Taille : 5x6. Cout : 48 rondins, 6 pierre. Peut fabrique : bois de charpente, bois de chauffage. Emplois : 1-3 woodcutters. Astuces : Le Lumbermill est un early settlement batiment, tout tier 2+ batiments va necessite bois de charpente. Il peut aussi fabrique bois de chauffage si necessaire. Appuyez sur F pour changer la couleur du toit."; }

		{ String _name = "RKFCForestBarn";			String _text = "Grange Forestiere"; }
		{ String _name = "RKFCForestBarnLwr";			String _text = "grange Forestiere"; }
		{ String _name = "RKFCForestBarnTip";			String _text = "Un Forest Barn peut store de tout que peut come de forest outposts. Taille : 5x6. Cout : 48 rondins, 12 pierre. Capacite : 12000 poids. Accepte : Comestibles, Tool, Sante, Combustible, Bois, Textile, Cereale, Legume, Fruit, Proteine. Astuces : Tres usefull à store simple goods disponibles de forest outposts."; }

		{ String _name = "TradingPostSeeds";			String _text = "CP Graines et Betail"; }
		{ String _name = "TradingPostSeedsLwr";			String _text = "cP Graines et Betail"; }
		{ String _name = "TradingPostSeedsTip";			String _text = "Permet pour le trade de resources avec seulement seeds/livestock merchants. Taille : 8x11. Cout : 48 rondins, 32 pierre, 12 fer. Capacite : 30000 poids. Accepte : Bois, pierre, fer, Combustible, Tool, Textile, Vetements, Minerals, Artisanal, Forge, Tissus, Industriel, Materiaux, Construction, Precieux, Divers.  Emplois : 1-10 marchands. Astuces : Livestocks et Seeds merchants ne...pas accepte Herbes et food."; }

		{ String _name = "RKWoodBakery";				String _text = "Boulangerie"; }
		{ String _name = "RKWoodBakeryLwr";				String _text = "boulangerie"; }
		{ String _name = "RKWoodBakeryTip";				String _text = "Medieval bakery prend de la farine et fabrique du pain, des gateaux et des tartes. Taille : 5x6. Cout : 32 bois de charpente, 16 pierre, 24 charbon de bois, 6 verre. Peut fabriquer : bread, cake, pies, quiche, omelette.  Emplois : 1-2 boulangers. Astuces : Great pour making tier 2 food. Bakeries va prend certains various amount de food, de flour et va try à donne vous (+100% educated +50% uneducated) plus food overall. Et certains food ont plus que 1 diet."; }

		{ String _name = "NMT30Windmill";				String _text = "Moulin a Vent"; }
		{ String _name = "NMT30WindmillLwr";				String _text = "moulin a Vent"; }
		{ String _name = "NMT30WindmillTip";				String _text = "Medieval windmill fabrique de la farine à partir de cereales. Taille : 6x6. Cout : 48 bois de charpente, 42 pierre, 32 fer. Peut fabriquer : flour de wheat, corn, barley, sorghum, oat, rye, rice. Emplois : 1-2 meuniers. Astuces : Appuyez sur F pour changer de modele. Ils prend 16 grains et fabrique 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Watermill";				String _text = "Moulin a Eau"; }
		{ String _name = "NMT30WatermillLwr";				String _text = "moulin a Eau"; }
		{ String _name = "NMT30WatermillTip";				String _text = "Medieval watermill fabrique de la farine à partir de cereales. Taille : 9x7. Cout : 48 bois de charpente, 42 pierre, 32 fer. Peut fabriquer : flour de wheat, corn, barley, sorghum, oat, rye, rice. Emplois : 1-3 meuniers. Astuces : Ce batiment necessite certains water cases. Travail faster que windmill. Ils prend 16 grains et fabrique 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Apiary";					String _text = "Rucher"; }
		{ String _name = "NMT30ApiaryLwr";				String _text = "rucher"; }
		{ String _name = "NMT30ApiaryTip";				String _text = "Medieval Apiary sert à garder des abeilles et à produire du miel et de la cire d'abeille. Taille : 6x6. Cout : 16 rondins, 24 fodder-thatch. Peut fabriquer : honey (food), beeswax (candles). Emplois : 1-2 apiculteurs. Astuces : Ce food batiment fournit early dans le jeu, un tres bon steady source de food. Vous va aussi a besoin il pour beeswax à fabrique candle à upgrade votre deplecated mines et quarries."; }

		{ String _name = "WoodButcher";					String _text = "Boucherie"; }
		{ String _name = "WoodButcherLwr";				String _text = "boucherie"; }
		{ String _name = "WoodButcherTip";				String _text = "bouchers decoupe les viandes et fabrique de la nourriture de niveau 2. Taille : 4x6. Cout : 48 bois de charpente, 42 pierre, 32 fer. Peut fabriquer : Tier 2 prepared meats (steaks roasts chops et poultries). Emplois : 1-2 bouchers. Astuces : Tres bon batiment à prend votre raw meats et raw poultry meats et process les à double votre Proteine quantities. De 12 meat vous obtenir 18-24 steak (educated = +100%) (Uneducated = +50% seulement)."; }

		{ String _name = "NMT30LightHouse";				String _text = "Phare"; }
		{ String _name = "NMT30LightHouseLwr";				String _text = "lightHouse"; }
		{ String _name = "NMT30LightHouseTip";				String _text = "Un LightHouse offrira des statistiques de ville et attirera des nomades venus de loin. Taille : 11x8. Cout : 58 bois de charpente, 98 pierre, 14 fer, 16 cuivre, 24 verre, 32 bois de chauffage. Emplois : 1 fireworker. Astuces : Le pyrotechnicien s'occupera du feu au sommet afin d'attirer des nomades. Le Lighthouse offer tout le services un townhall peut fournit."; }

		{ String _name = "NMT30Watertower";				String _text = "Chateau d'Eau"; }
		{ String _name = "NMT30WatertowerLwr";				String _text = "chateau d'Eau"; }
		{ String _name = "NMT30WatertowerTip";				String _text = "Un Watertower fournit de l'eau fraiche à vos citoyens. Taille : 4x5. Cout : 34 rondins, 8 fer. Peut fabriquer : 12-15 water de le watertower.  Emplois : 1-2 ouvriers. Astuces : L'eau sert de nourriture mais n'a aucune valeur nutritive. Certains batiments necessitent de l'eau au fil du temps (comme les serres) en tant qu'intrant."; }

		{ String _name = "NMT30Cathedral";				String _text = "Cathedrale"; }
		{ String _name = "NMT30CathedralLwr";				String _text = "cathedrale"; }
		{ String _name = "NMT30CathedralTip";				String _text = "Le Medieval Cathedral apporte du bonheur aux fideles et un lieu de rencontre et de culte. Taille : 12x20. Cout : 90 bois de charpente, 160 pierre, 64 verre, 18 argent, 12 ou, 80 tuile. Capacite 800 souls. Rayon : 60 cases. Emplois : 1 clerc. Astuces : Beaucoup de saves devrait ont un magnificient Chathedral ! Mais pas tout de les."; }

		{ String _name = "NMT30SaltMine";				String _text = "Mine de Sel"; }
		{ String _name = "NMT30SaltMineLwr";				String _text = "mine de Sel"; }
		{ String _name = "NMT30SaltMineTip";				String _text = "Le Salt Mine est un lieu de travail qui fournit salt. Taille : 6x6. Cout : 24 rondins, 32 bois de charpente, 12 fer. Peut extraire : 4-6 salt de le ground. Detraction : 20 cases. Capacite 4000 Pas renewable. Emplois : 1-5 mineurs. Astuces : Faster maniere à obtenir salt. Salt est un Mineral. Quand deplecated, destroy et build another one."; }

		{ String _name = "NMT30OldSmokery";				String _text = "Vieux Fumoir"; }
		{ String _name = "NMT30OldSmokeryLwr";				String _text = "vieux Fumoir"; }
		{ String _name = "NMT30OldSmokeryTip";				String _text = "Le Old Smokery est un lieu de travail qui prend meats et smokes ces pour preservation. Taille : 6x6. Cout : 18 bois de charpente, 48 pierre, 12 fer, 4 verre. Peut fabriquer : Tier 2 prepared meats (smoked meats fish et poultries). Emplois : 1-2 boulangers. Astuces : Ce batiment a besoin +1 bois de chauffage pour chaque smoke process. Mais le production valeur stay à 3 (pas 2). Fish à 2 valeur. Ils prend 12 intrant et ils fabrique 18-24 production. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30OldSaltery";				String _text = "Vieille Salaison"; }
		{ String _name = "NMT30OldSalteryLwr";				String _text = "vieille Salaison"; }
		{ String _name = "NMT30OldSalteryTip";				String _text = "Le Old Saltery est un lieu de travail qui prend meats et salts ces pour preservation. Taille : 6x6. Cout : 36 bois de charpente, 16 pierre, 8 fer. Peut fabriquer : Tier 2 prepared meats (cured meats fish et poultries). Emplois : 1-2 boulangers. Astuces : Ce batiment a besoin +3 salt pour chaque cured process. Mais le production valeur stay à 3 (pas 2). Fish à 2 valeur. Ils prend 12 intrant et ils fabrique 18-24 production. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30DryShack";				String _text = "Vieille Cabane de Sechage"; }
		{ String _name = "NMT30DryShackLwr";				String _text = "vieille Cabane de Sechage"; }
		{ String _name = "NMT30DryShackTip";				String _text = "Le Old Dry Shack est un lieu de travail qui prend meats et dries ces pour preservation. Taille : 6x6. Cout : 28 bois de charpente, 6 Bois, 4 pierre. Peut fabriquer : Tier 2 prepared meats (dried meats fish et poultries). Emplois : 1-2 boulangers. Astuces : Ce batiment seulement a besoin meats. Aucun autres intrant mais le valeur de le meats lost 1 valeur. Ils prend 12 intrant et ils fabrique 18-24 production. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Creamery";				String _text = "Vieille Cremerie"; }
		{ String _name = "NMT30CreameryLwr";				String _text = "vieille Cremerie"; }
		{ String _name = "NMT30CreameryTip";				String _text = "Le Old Creamery est un lieu de travail qui prend milk et fabrique cheese, butter, cream et yogurt. Taille : 8x8. Cout : 36 bois de charpente, 24 pierre, 8 verre, 6 fer. Peut fabriquer : Tier 2 prepared meats (cheese butter cream yogurt). Emplois : 1-2 laitiers. Astuces : Ce batiment necessite principalement du lait. Vous pouvez y ajouter des fruits. Les productions varient selon les recettes. L'education influence beaucoup les quantites produites."; }

		{ String _name = "RKRedCreamery";				String _text = "Cremerie Rouge"; }
		{ String _name = "RKRedCreameryLwr";				String _text = "cremerie Rouge"; }
		{ String _name = "RKRedCreameryTip";				String _text = "Red Creamery est un lieu de travail qui prend milk et fabrique cheese, butter, cream et yogurt. Taille : 9x10. Cout : 68 bois de charpente, 12 pierre, 16 cuivre, 8 verre, 16 glassware. Peut fabriquer : Tier 2 prepared meats (cheese butter cream yogurt). Emplois : 1-3 laitiers. Astuces : Ce batiment necessite principalement du lait. Vous pouvez y ajouter des fruits. Les productions varient selon les recettes. L'education influence beaucoup les quantites produites. Le red creamery est un lot faster que le old creamery."; }

		{ String _name = "NMT30MaltHouse";				String _text = "Malterie"; }
		{ String _name = "NMT30MaltHouseLwr";				String _text = "malterie"; }
		{ String _name = "NMT30MaltHouseTip";				String _text = "Le Malt House est un lieu de travail qui prend des cereales et les convertit en malt. Taille : 6x8. Cout : 12 rondins, 24 bois de charpente, 48 pierre, 24 brique, 8 fer, 12 verre. Peut fabriquer : 18-24 Malt de 12 Cereale (barley corn oat rye sorghum wheat). Emplois : 1-2 brasseurs. Astuces : Old ale a un valeur de 6 now. Beer a replaced Ale à 8 valeur mais beer a besoin malt. So now, vous a besoin à convert le Cereale dans malt, et taverns va brew le malt."; }

		{ String _name = "NMT30Pond";					String _text = "Etang Medieval"; }
		{ String _name = "NMT30PondLwr";				String _text = "etang Medieval"; }
		{ String _name = "NMT30PondTip";				String _text = "Un Medieval Pond fournit du poisson à vos citoyens. Taille : 8x9. Cout : 4 rondins, 12 pierre. Capacite : Unlimited. Astuces : Tres independant du quai de peche traditionnel, l'etang aura un rendement equivalent. Si vous decidez de le retirer, vous devrez utiliser l'outil d'aplanissement pour remettre le sol à plat."; }

		{ String _name = "StorageBarn";					String _text = "Grange de Stockage"; }
		{ String _name = "StorageBarnLwr";				String _text = "grange de Stockage"; }
		{ String _name = "StorageBarnTip";				String _text = "Utilise à store goods such comme food, clothes, textiles, et tools. Taille : 5x8. Cout : 48 rondins, 16 pierre. Capacite : 8000 poids. Accepte : Comestibles, Tool, Herbes, Vetements, Textile, Cereale, Legume, Fruit, Proteine, Artisanal, Forge, Tissus, Precieux, Divers. Astuces : Fabrique sure vous toujours ont certains barn space disponible à store votre food et autres things."; }

		{ String _name = "NMT30StorageBarnNorm";			String _text = "Grange Normale"; }
		{ String _name = "NMT30StorageBarnNormLwr";			String _text = "grange Normale"; }
		{ String _name = "NMT30StorageBarnNormTip";			String _text = "Un Normal Barn sert à stocker des biens tels que food, clothes, textiles, et tools. Taille : 5x8. Cout : 48 rondins, 16 pierre. Capacite : 10000 poids. Accepte : Comestibles, Tool, Herbes, Vetements, Textile, Cereale, Legume, Fruit, Proteine, Artisanal, Forge, Tissus, Precieux, Divers. Astuces : Ce grenier est exactement le meme que celui de la barre d'outils de stockage du jeu."; }

		{ String _name = "NMT30StorageBarnMed";				String _text = "Grange Moyenne"; }
		{ String _name = "NMT30StorageBarnMedLwr";			String _text = "grange Moyenne"; }
		{ String _name = "NMT30StorageBarnMedTip";			String _text = "Un Medium Barn sert à stocker des biens tels que food, clothes, textiles, et tools. Taille : 4x6. Cout : 32 rondins, 12 pierre. Capacite : 6000 poids. Accepte : Comestibles, Tool, Herbes, Vetements, Textile, Cereale, Legume, Fruit, Proteine, Artisanal, Forge, Tissus, Precieux, Divers. Astuces : Ce grenier est une version plus petite du grenier standard. Moins cher et de taille moyenne, il à une capacite moyenne."; }

		{ String _name = "NMT30StorageBarnSmall";			String _text = "Petite Grange"; }
		{ String _name = "NMT30StorageBarnSmallLwr";			String _text = "petite Grange"; }
		{ String _name = "NMT30StorageBarnSmallTip";			String _text = "Un Small Barn sert à stocker des biens tels que food, clothes, textiles, et tools. Taille : 3x5. Cout : 24 rondins, 8 pierre. Capacite : 3800 poids. Accepte : Comestibles, Tool, Herbes, Vetements, Textile, Cereale, Legume, Fruit, Proteine, Artisanal, Forge, Tissus, Precieux, Divers. Astuces : Ce grenier est une version plus petite du grenier moyen. Encore moins cher et de petite taille, il à une petite capacite."; }

		{ String _name = "NMT30StorageBarnTiny";			String _text = "Grange Minuscule"; }
		{ String _name = "NMT30StorageBarnTinyLwr";			String _text = "grange Minuscule"; }
		{ String _name = "NMT30StorageBarnTinyTip";			String _text = "Un Tiny Barn sert à stocker des biens tels que food, clothes, textiles, et tools. Taille : 2x3. Cout : 16 rondins, 4 pierre. Capacite : 1600 poids. Accepte : Comestibles, Tool, Herbes, Vetements, Textile, Cereale, Legume, Fruit, Proteine, Artisanal, Forge, Tissus, Precieux, Divers. Astuces : Ce grenier est une version minuscule du petit grenier. Bien moins cher et de taille minuscule, il à une capacite minuscule."; }

		{ String _name = "NMT30Granary";				String _text = "Grenier"; }
		{ String _name = "NMT30GranaryLwr";				String _text = "grenier"; }
		{ String _name = "NMT30GranaryTip";				String _text = "Un Granary est un stockage specialise servant uniquement à stocker food (Comestibles et non-Comestibles). Taille : 5x8. Cout : 58 rondins, 16 pierre. Capacite : 12000 poids. Accepte : Comestibles, Cereale, Legume, Fruit, Proteine. Astuces : Ce grenier est une sorte de grange mais il ne stocke que de la nourriture (comestible et non comestible) et à une capacite superieure par case. Coute un peu plus cher qu'une grange standard."; }

		{ String _name = "NMT30RootCellar";				String _text = "Cellier"; }
		{ String _name = "NMT30RootCellarLwr";				String _text = "cellier"; }
		{ String _name = "NMT30RootCellarTip";				String _text = "Un Root Cellar est un stockage souterrain specialise servant uniquement à stocker Fruit/Legume. Taille : 4x5. Cout : 6 rondins, 26 pierre. Capacite : 8000 poids. Accepte : Legume, Fruit. Astuces : Ce cellier est une sorte de grange souterraine mais ne stocke que des fruits et legumes et à une capacite bien plus elevee par case. Coute plus de pierre que de rondins."; }

		{ String _name = "RKmeatLocker";				String _text = "Glaciere à Viande"; }
		{ String _name = "RKmeatLockerLwr";				String _text = "glaciere à Viande"; }
		{ String _name = "RKmeatLockerTip";				String _text = "Un Meat Locker est un stockage semi-souterrain specialise servant uniquement à stocker Meat/Proteins. Taille : 3x3 cases. Cout : 5 rondins, 12 pierre. Capacite : 3600 poids. Accepte : Proteine. Astuces : Cette glaciere à viande est une sorte de grange semi-souterraine mais ne stocke que des viandes et des proteines et à une capacite bien plus elevee par case. Coute plus de pierre que de rondins."; }

		{ String _name = "NMT30BarberShop";				String _text = "Barbier"; }
		{ String _name = "NMT30BarberShopLwr";				String _text = "barbier"; }
		{ String _name = "NMT30BarberShopTip";				String _text = "Le BarberShop est un lieu tenu par un medecin qui aidera à garder vos citoyens en bonne sante. Taille : 4x5 cases. Cout : 8 rondins, 24 bois de charpente, 32 pierre, 8 verre, 12 perfum, 1 argent. Frequentation : 10. Emplois : 1 medecins. Astuces : Il s'agit d'une version plus petite de l'hopital et il fonctionne de la meme maniere. Accepte seulement 10 patients. Le design est concu pour s'integrer sous des etages à niveaux multiples. N'attirera pas les oisifs."; }

		{ String _name = "NMT30Dentist";				String _text = "Dentiste"; }
		{ String _name = "NMT30DentistLwr";				String _text = "dentiste"; }
		{ String _name = "NMT30DentistTip";				String _text = "Le Dentist est un lieu tenu par un medecin qui aidera à garder vos citoyens en bonne sante. Taille : 4x5 cases. Cout : 8 rondins, 24 bois de charpente, 32 pierre, 8 verre, 6 cuivre, 1 ou. Frequentation : 10. Emplois : 1 medecins. Astuces : Il s'agit d'une version plus petite de l'hopital et il fonctionne de la meme maniere. Accepte seulement 10 patients. Le design est concu pour s'integrer sous des etages à niveaux multiples. N'attirera pas les oisifs."; }

		{ String _name = "NMT30Clinic";					String _text = "Clinique"; }
		{ String _name = "NMT30ClinicLwr";				String _text = "clinique"; }
		{ String _name = "NMT30ClinicTip";				String _text = "Le Clinic est un lieu tenu par un medecin qui aidera à garder vos citoyens en bonne sante. Taille : 4x5 cases. Cout : 8 rondins, 24 bois de charpente, 32 pierre, 8 verre, 18 glassware, 24 Herbes. Frequentation : 20. Emplois : 1 medecins. Astuces : Il s'agit d'une version plus petite de l'hopital et il fonctionne de la meme maniere. Accepte seulement 10 patients. Le design est concu pour s'integrer sous des etages à niveaux multiples. N'attirera pas les oisifs."; }

		{ String _name = "NMT30BathHouse";				String _text = "Bath House"; }
		{ String _name = "NMT30BathHouseLwr";				String _text = "bath house"; }
		{ String _name = "NMT30BathHouseTip";				String _text = "Le Bath House est un essential place pour hygiene qui aide à keep votre citoyens healthy.  Taille : 8x6 cases. Cout : 24 bois de charpente, 56 pierre, 24 verre, 8 cuivre, 24 perfums, 36 Herbes. Bonheur : Sante. Rayon : 60. Frequentation : 200. Emplois : 1 ouvriers. Astuces : Ce est grand batiment avec un large rayon. Il fournit Bonheur : Sante et va attract idlers. Le design est concu pour s'integrer sous des etages à niveaux multiples."; }

		{ String _name = "NMT30SchoolHouse";				String _text = "Medieval School"; }
		{ String _name = "NMT30SchoolHouseLwr";				String _text = "Medieval School"; }
		{ String _name = "NMT30SchoolHouseTip";				String _text = "Le Medieval School est utilise à educate citoyens à etre plus productive. Taille : 5x5 cases. Cout : 48 bois de charpente, 26 pierre, 12 fer, 8 cuivre, 24 verre. Frequentation : 40. Emplois : 1 teacher. Astuces : Ce est un education batiment avec double students Capacite à compare le regular school. Education est extremly essential dans ce mod. Non-Education increase largely le difficulty de le jeu."; }

		{ String _name = "RKShopHardware";				String _text = "Raw Materiaux"; }
		{ String _name = "RKShopHardwareLwr";				String _text = "raw materiaux"; }
		{ String _name = "RKShopHardwareTip";				String _text = "Le Raw Materiaux Store est un petit marche que seulement vend raw materiaux (Bois, Minerals, fer). Taille : 4x5 cases. Cout : 24 rondins, 36 pierre. Vend : (30%)rondins (40%)Minerals (30%)fer. Capacite : 10000 poids. Emplois : 1-6 vendeurs. Astuces : Il Est un bon marche à fournit un forgerons, un foundry, et any production batiment que utiliser rondins+fer et/ou Minerals. Il fit sous Multi-niveau floors."; }

		{ String _name = "RKShopBuilding";				String _text = "Batiment Materiaux"; }
		{ String _name = "RKShopBuildingLwr";				String _text = "batiment materiaux"; }
		{ String _name = "RKShopBuildingTip";				String _text = "Le Batiment Materiaux Store est un petit marche que seulement vend Tier2 batiment materiaux (pierre, Construction: bois de charpente, verre, Bricks, Rooftiles...). Taille : 4x5 cases. Cout : 24 rondins, 36 pierre. Vend : (20%)pierre (80%)Construction. Capacite : 10000 poids. Emplois : 1-6 vendeurs. Astuces : Il Est un bon marche à fournit batiment materiaux à un area dans developpement. Il fit sous Multi-niveau floors."; }

		{ String _name = "RKShopGrocery";				String _text = "Grocery Store"; }
		{ String _name = "RKShopGroceryLwr";				String _text = "grocery store"; }
		{ String _name = "RKShopGroceryTip";				String _text = "Le Grocery Store est un petit marche que seulement vend food (Proteins, Cereale, Vegetables et Fruits). Taille : 4x5 cases. Cout : 24 rondins, 36 pierre. Vend : Food (25%)Cereale (25%)Fruit (25%)Legume (25%)Proteine. Capacite : 10000 poids. Emplois : 1-6 vendeurs. Astuces : Il Est un bon marche à fournit food à un housing district. Va grab Comestibles et non-Comestibles food. Il fit sous Multi-niveau floors."; }

		{ String _name = "RKShopDelicate";				String _text = "Supplies & Goods"; }
		{ String _name = "RKShopDelicateLwr";				String _text = "supplies & goods"; }
		{ String _name = "RKShopDelicateTip";				String _text = "Le Supplies & Goods est un petit marche que seulement vend certains various goods. Taille : 4x5 cases. Cout : 24 rondins, 36 pierre. Vend : (25%)Tool (25%)Combustible (25%)Vetements (25%)Sante. Capacite : 10000 poids. Emplois : 1-6 vendeurs. Astuces : Il Est un bon marche à fournit de tout else que est pas food à un housing district. Devrait fournit de tout else que food pour tout votre housing. Il fit sous Multi-niveau floors."; }

		{ String _name = "RKShopFabrics";				String _text = "Tissus & Cie"; }
		{ String _name = "RKShopFabricsLwr";				String _text = "tissus & Cie"; }
		{ String _name = "RKShopFabricsTip";				String _text = "Le Tissus & Co. est un petit marche que seulement vend Tissus materiaux à fabriquer vetements (Textiles et Tissus). Taille : 4x5 cases. Cout : 24 rondins, 36 pierre. Vend : (50%)Textile (50%)Fabric. Capacite : 10000 poids. Emplois : 1-6 vendeurs. Astuces : Il Est un bon marche à fournit tailors et de tout que a besoin textiles. Il fit sous Multi-niveau floors."; }

		{ String _name = "NewMedievalFlatTool";			String _text = "Outil d'Aplanissement"; }
		{ String _name = "NewMedievalFlatToolLwr";		String _text = "outil d'Aplanissement"; }
		{ String _name = "NewMedievalFlatToolTip";		String _text = "Flat Tool sert à aplanir le sol apres la suppression d'une piece de Canal, d'un Etang ou d'une Mine à ciel ouvert... Egalement tres utile pour raser les collines. Il posera des X orange sur le sol. Une fois la tache terminee, vous devrez utiliser l'outil de suppression de batiment pour vous debarrasser du X orange."; }

		{ String _name = "NMTMCsandpit";			String _text = "Sabliere"; }
		{ String _name = "NMTMCsandpitLWR";			String _text = "sabliere"; }
		{ String _name = "NMTMCsandpitTip";			String _text = "Un Sand pit est une zone de travail ou vous pouvez gather sand. Taille : 9x9 cases. Cout : 12 rondins. Peut produire : 6-9 Sand. Capacite : Unlimited. Emplois : 1-6 tailleurs de pierre. Astuces : Il va create 6-9 sand par job done. Sand est un materiau avec un valeur de 1. Prend care à pas block le entrance. Please permet un road dans devant."; }

		{ String _name = "NMTMCclaypit";			String _text = "Carriere d'Argile"; }
		{ String _name = "NMTMCclaypitLWR";			String _text = "carriere d'Argile"; }
		{ String _name = "NMTMCclaypitTip";			String _text = "Un Clay pit est une zone de travail ou vous pouvez gather clay. Taille : 9x9 cases. Cout : 12 rondins. Peut produire : 1-2 Clay. Capacite : Unlimited. Emplois : 1-6 tailleurs de pierre. Astuces : Il va create 1-2 clay par job done. Clay est un materiau avec un valeur de 3. Prend care à pas block le entrance. Please permet un road dans devant."; }

		{ String _name = "NMTMCkiln";				String _text = "Four"; }
		{ String _name = "NMTMCkilnLWR";			String _text = "four"; }
		{ String _name = "NMTMCkilnTip";			String _text = "Un kiln est une zone de travail ou vous pouvez fabrique bricks et rooftiles de clay. Taille : 6x6 cases. Cout : 26 pierre. Peut fabriquer : 6-10 brique(10 clay) ou 6-10 tuile(10 clay). Emplois : 1 ouvriers. Astuces : Il aussi a besoin 2 bois de chauffage par job done. Bricks et rooftiles sont articles de Construction avec un valeur de 5 chaque. Un lot de batiments va necessite bricks et rooftiles comme batiment materiau."; }

		{ String _name = "NMTMCglassmaker";			String _text = "Verrier"; }
		{ String _name = "NMTMCglassmakerLWR";			String _text = "verrier"; }
		{ String _name = "NMTMCglassmakerTip";			String _text = "Un verre Maker est une zone de travail ou vous pouvez fabrique verre et glassware de sand. Taille : 6x6 cases. Cout : 38 rondins, 32 pierre, 12 fer. Peut fabriquer : 6-8 verre(23 sand) ou 6-9 Glassware(23 sand). Emplois : 1 ouvriers. Astuces : Il aussi a besoin 6 bois de chauffage ou 3 coal par job done. verre est un Construction item avec un valeur de 8. Glassware est un Artisanal item avec un valeur de 7. Un lot de batiments va necessite verre comme batiment materiau. Glassware est necessaire pour production ou batiment materiau."; }

		{ String _name = "NMT30MCironQuarry";			String _text = "Carriere de Fer"; }
		{ String _name = "NMT30MCironQuarryLWR";		String _text = "carriere de Fer"; }
		{ String _name = "NMT30MCironQuarryTip";		String _text = "Un fer Quarry est une zone de travail ou vous pouvez mine fer ou cuivre. Taille : 10x10 cases. Cout : 48 rondins. Peut produire : 2-3 fer Ore ou 2-3 cuivre Ore par travail. Capacite : 2000. Emplois : 1-6 mineurs. Astuces : fer Ore et cuivre Ore sont Minerals avec un valeur de 4. Vous va a besoin un foundry à smelt ces ores. (forgerons peut aussi aide vous dans wait vous ont votre foundry). Une fois deplecated, vous peut renew il 5 times."; }

		{ String _name = "NMT30MCrockQuarry";			String _text = "Carriere de Roche"; }
		{ String _name = "NMT30MCrockQuarryLWR";		String _text = "carriere de Roche"; }
		{ String _name = "NMT30MCrockQuarryTip";		String _text = "Un Rock Quarry est une zone de travail ou vous pouvez mine pierre, Coal ou Salt. Taille : 10x10 cases. Cout : 48 rondins. Peut produire : 1-2 pierre ou 3-4 Coal ou 4-6 Salt par travail. Capacite : 2000. Emplois : 1-6 mineurs. Astuces : pierre est pierre limit avec un valeur de 8. Coal est un Mineral avec un valeur de 4. Et salt est un Mineral avec un valeur de 1. Une fois deplecated, vous peut renew il 5 times."; }

		{ String _name = "NMT30MCrandomQuarry";			String _text = "Carriere Aleatoire"; }
		{ String _name = "NMT30MCrandomQuarryLWR";		String _text = "carriere Aleatoire"; }
		{ String _name = "NMT30MCrandomQuarryTip";		String _text = "Un Aleatoire Quarry est une zone de travail ou vous pouvez mine de tout... aleatoirement. Taille : 10x10 cases. Cout : 48 rondins. Peut produire aleatoirement : 1-2 pierre 3-4 Coal 4-6 Salt 2-3 IronOre 2-3 CopperOre par travail. Capacite : 2000. Emplois : 1-6 mineurs. Astuces : pierre a un valeur de 8. Coal, IronOre et CopperOre sont Minerals avec un valeur de 4. Et salt est un Mineral avec un valeur de 1. Une fois deplecated, vous peut renew il 5 times. Ce aleatoire quarry peut aussi donne vous 1 Gem(valeur 200), 1-2 argent Ores(valeur 11) et 1-2 ou Ores(valeur 22). Ces sont aussi Minerals."; }

		{ String _name = "NMT30MCironQuarryLvl2";		String _text = "Carriere de Fer Niv.2"; }
		{ String _name = "NMT30MCironQuarryLvl2LWR";		String _text = "carriere de Fer Niv.2"; }
		{ String _name = "NMT30MCironQuarryLvl2Tip";		String _text = "Un fer Quarry Lvl2 est une zone de travail ou vous pouvez mine fer ou cuivre."; }

