		{ String _name = "NMT30Foundry";			String _text = "Fonderie"; }
		{ String _name = "NMT30FoundryLWR";			String _text = "fonderie"; }
		{ String _name = "NMT30FoundryTip";			String _text = "Un Foundry est une zone de travail ou vous pouvez smelt de tout. Taille : 8x8 cases. Cout : 24 rondins, 64 pierre, 18 fer, 32 charbon de bois. Peut produire : 1-2 fer, cuivre, silevr ou ou par travail. Emplois : 1-2 forgerons. Astuces : Le Foundry est le maniere à go à smelt de tout dans le jeu et aussi est plus efficient que le simple forgerons batiments. "; }

		{ String _name = "NMT30JewelMaker";			String _text = "Bijoutier"; }
		{ String _name = "NMT30JewelMakerLWR";			String _text = "bijoutier"; }
		{ String _name = "NMT30JewelMakerTip";			String _text = "Un Jewelry Maker prend des metaux precieux et des gemmes pour fabriquer des bagues, colliers et bijoux tres precieux. Taille : 6x6 cases. Cout : 8 rondins, 24 bois de charpente, 16 pierre, 18 brique, 6 verre. Peut fabriquer : jewelries de cutted gems et ou/argent, multiples recipes. Emplois : 1 ouvriers. Astuces : Vous a besoin un gem cutter à cut ces gems et une fois vous determined leur valeur, vous peut utiliser ces à fabrique ou un silvered ou un golden version. Chaque recipes va drop plus que juste one item à temps. Although, non-education est bad pour ce batiment. Le list de recipes est too long à put il ici."; }

		{ String _name = "NMT30GemCutter";			String _text = "Tailleur de Gemmes"; }
		{ String _name = "NMT30GemCutterLWR";			String _text = "tailleur de Gemmes"; }
		{ String _name = "NMT30GemCutterTip";			String _text = "Un Gem Cutter prend des gemmes, les taille, et determine leur qualite et leur valeur. Taille : 6x6 cases. Cout : 8 rondins, 24 bois de charpente, 16 pierre, 18 brique, 6 verre. Peut fabriquer : amethyst(valeur 60) topaze(valeur 80) emerald(valeur 250) sapphire(valeur 300) ruby(valeur 400) diamond(valeur 1000). Emplois : 1 ouvriers. Astuces : Le seulement maniere à obtenir uncut gems est de le aleatoire quarry. De course, superieure values sont un lot plus rare que common ones."; }

		{ String _name = "NMT30CandleMaker";			String _text = "Fabricant de Bougies"; }
		{ String _name = "NMT30CandleMakerLWR";			String _text = "fabricant de Bougies"; }
		{ String _name = "NMT30CandleMakerTip";			String _text = "Un Candle Maker fabrique des Bougies à partir de Cire d'Abeille. Taille : 6x6 cases. Cout : 12 rondins, 24 bois de charpente, 18 pierre, 24 brique, 12 verre. Peut fabriquer : 3-4 candles de 16 beeswax par travail. Emplois : 1 ouvriers. Astuces : Candle a un valeur de 8. Candles sont utilise à upgrade et renew mines et quarries une fois ils sont deplecated."; }

		{ String _name = "NMT30MineUpgradeTip";			String _text = "Ameliorez et renouvelez cette mine/carriere vers un niveau plus profond, ce qui vous permettra de continuer à en tirer des ressources meme epuisee. Il vous faudra du materiel supplementaire comme des bougies pour cela."; }

		{ String _name = "RKGardenWallsGreenHouse";			String _text = "Serre"; }
		{ String _name = "RKGardenWallsGreenHouseLwr";			String _text = "serre"; }
		{ String _name = "RKGardenWallsGreenHouseTip";			String _text = "Un GreenHouse est le fournisseur de nourriture le plus puissant de ce mod. Taille : 5x7 cases. Cout : 20 bois de charpente, 20 pierre, 48 verre. Peut fabriquer : Tout sorte de vegetables dans jeu et certains small Fruit plants, chiffres created sont variable de 16-24 à 20-28. Emplois : 1 botaniste. Astuces : Greenhouse a besoin (2)fertilizer et (2)water au fil du temps par chaque job done. (meilleur source de fertilizer est le stable, pastures avec certains animals va aide un lot too. Le water comes de un water bien ou water tower)."; }

		{ String _name = "RKGardenWallsStables";			String _text = "Ecuries"; }
		{ String _name = "RKGardenWallsStablesLwr";			String _text = "ecuries"; }
		{ String _name = "RKGardenWallsStablesTip";			String _text = "Stables est le meilleur fournisseur d'engrais du jeu. Taille : 9x6 cases. Cout : 20 bois de charpente, 40 pierre. Peut produire : 3-5 fertilizer(valeur 2) de 2 fodder-thatch et 2 water par job done. Emplois : 1-2 palefreniers. Astuces : Vous a besoin un bon source de fodder-thatch qui peut come de clearing ou de le fodder farmer et water de water bien ou water tower. Fertilizer est utilise dans greenhouses(most powerful food generator par case)."; }

		{ String _name = "RKGardenWallsWell";				String _text = "Puits d'Eau"; }
		{ String _name = "RKGardenWallsWellLwr";			String _text = "puits d'Eau"; }
		{ String _name = "RKGardenWallsWellTip";			String _text = "Un Water Bien est une bonne source d'eau fraiche. Taille : 1x1 cases(3x3 avec roads). Cout : 4 bois de charpente, 24 pierre. Peut fabriquer : 12-15 water(valeur 1) par job done. Emplois : 1 ouvriers. Astuces : Ce bien Peut Pas etre utilise pour firefighting. Il est producing water slower que le water tower. Water est un food without nutrients(aucun diet flags) et est necessaire dans beaucoup de industries comme stables, greenhouses, perfumery, apothecary..."; }

		{ String _name = "RKGardenWallsFodderFarmers";			String _text = "Fermiers Fourragers"; }
		{ String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "fermiers Fourragers"; }
		{ String _name = "RKGardenWallsFodderFarmersTip";		String _text = "Un Fodder Farmers plantera de l'herbe et recoltera du fourrage-chaume une fois l'herbe arrivee à maturite (au lieu des arbres). Taille : 5x6 cases. Cout : 32 bois de charpente, 4 pierre. Peut fabriquer : 3-4 fodder-thatch par harvested grass patch. Rayon : 26 cases. Emplois : 1-3 forestiers. Astuces : Working exactement meme comme forestiers lodge mais va plant grass. D abord ils va ont à clear de tout dans leur rayon, remove tout trees et tout ores va aide les alot. et une fois removed, ils va plant un grass patch. Ce grass a besoin à grow, et quand mature, il va etre harvested. Fodder peut etre utilise aussi à fabrique firebundles(bois de chauffage)."; }

		{ String _name = "RKGardenWallsFlorist";			String _text = "Fleuriste"; }
		{ String _name = "RKGardenWallsFloristLwr";			String _text = "fleuriste"; }
		{ String _name = "RKGardenWallsFloristTip";			String _text = "Un Florist errera et tentera de recolter des fleurs. Taille : 5x6 cases. Cout : 32 bois de charpente, 4 pierre. Peut fabriquer : 3-5 flowers par harvested flower patch. Rayon : 32. Emplois : 1 cueilleurs. Astuces : Le florist va agit exactement comme un cueilleurs mais il va search pour flowers et seedlings. Pas intended à etre placed near forestiers/cueilleurs combo (tres bad) mais meant à etre utilise dans combo de le fodder farmer batiment. Grass va spawn tons de flowers. Warning: Ils va pas plant flowers."; }

		{ String _name = "RKGardenWallsPerfumery";			String _text = "Parfumerie"; }
		{ String _name = "RKGardenWallsPerfumeryLwr";			String _text = "parfumerie"; }
		{ String _name = "RKGardenWallsPerfumeryTip";			String _text = "Un Perfumery cree du parfum à partir d'essence de fleurs. Taille : 5x5 cases. Cout : 24 bois de charpente, 24 pierre, 8 cuivre, 12 glassware. Peut fabriquer : 5-8 perfumes (valeur 8) de 8 flower, 2 water, 1 glassware par job done. Emplois : 1 ouvriers. Astuces. One de le meilleur item à vend que utiliser quelque chose nous peut find everywhere: flowers. Ce batiment necessite water et glassware au fil du temps. Water comes de water bien ou water tower et le glassware comes de le verre maker."; }

		{ String _name = "RKGardenWallsCustom5Barn";			String _text = "Grange a Fourrage"; }
		{ String _name = "RKGardenWallsCustom5BarnLwr";			String _text = "grange a Fourrage"; }
		{ String _name = "RKGardenWallsCustom5BarnTip";			String _text = "Ce est un Fodder Barn que seulement permet fodder items et de tout que fall dans que category à etre stored la. Taille : 4x4 cases. Cout : 12 rondins, 28 fodder-thatch. Capacite : 6000 poids. Accepte : Divers Items. Astuces : Fodder est Divers flag, so ce est why il permet tout Divers flag items. Permet alot plus items à etre stored dans un 4x4 que un simple reserve."; }

		{ String _name = "RKGardenWallsTrash";				String _text = "Corbeille"; }
		{ String _name = "RKGardenWallsTrashLwr";			String _text = "corbeille"; }
		{ String _name = "RKGardenWallsTrashTip";			String _text = "Trash ce item et remove il."; }
		{ String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "Trash ce item et remove il."; }

		{ String _name = "OldBarnPub";				String _text = "Vieux Pub de Grange"; }
		{ String _name = "OldBarnPubLWR";			String _text = "vieux Pub de Grange"; }
		{ String _name = "OldBarnPubTip";			String _text = "Un Old Barn Pub est une grange transformee en bar ou pub. Ils serviront des repas et des boissons, et auront une ambiance festive qui apportera du bonheur. Taille : 6x6 cases. Cout : 32 rondins, 16 pierre. Bonheur : Entertainment. Rayon : 40 cases. Emplois : 1-3 brasseurs. Astuces : Ce batiment utilise un nouvel indicateur: Consume. Ce special flag aide à deal avec alcohol et va agit le meme. Le brasseurs va prend tier 2 meat, plus un Legume et un alcohol et va fabrique 12-16 meals (valeur  1). citoyens va pickup meals et obtenir hapiness arriere de il (exactement comme ale) mais cout alot less."; }


		{ String _name = "ClearWildFood";			String _text = "Recolter Nourriture Sauvage"; }
		{ String _name = "ClearWildFoodLwr";			String _text = "recolter Nourriture Sauvage"; }
		{ String _name = "ClearWildFoodTip";			String _text = "Recoltez la nourriture sauvage qui apparait dans la zone selectionnee. Astuces : Wild food sont spawning de trees et alot new food sont spawning de flowers."; }

		{ String _name = "ClearFodder";				String _text = "Recolter Fourrage"; }
		{ String _name = "ClearFodderLwr";			String _text = "recolter Fourrage"; }
		{ String _name = "ClearFodderTip";			String _text = "Recoltez les parcelles de fourrage-chaume dans la zone selectionnee. Astuces : Fodder-thatch est le materiau vous obtenir de harvesting patches de grass vous peut see sur le ground. Fodder peut etre utilise dans le stables, peut etre made dans firebundles(bois de chauffage par woodcutters), peut etre utilise comme batiment materiau(apiary, fenceless pasture, fodder barn...). chaque patch de grass creates 4-6 fodder-thatch (valeur 1). Ces sont stored dans un Construction reserve."; }

		{ String _name = "ClearFlower";				String _text = "Recolter Fleurs"; }
		{ String _name = "ClearFlowerLwr";			String _text = "recolter Fleurs"; }
		{ String _name = "ClearFlowerTip";			String _text = "Recoltez les fleurs qui apparaissent dans la zone selectionnee. Astuces : Flowers ont le miscellaneous flag. Chaque patch de flowers create 3-5 flowers (valeur 1). Fabrique sure vous ont barns que accepte miscellaneous items."; }

		{ String _name = "ClearHerb";				String _text = "Recolter Herbes"; }
		{ String _name = "ClearHerbLwr";			String _text = "recolter Herbes"; }
		{ String _name = "ClearHerbTip";			String _text = "Recoltez les herbes qui apparaissent dans la zone selectionnee. Astuces : Herbes sont utilise à un herbalist (ou bathhouse) à obtenir arriere 1/2 heart par utilise. Chaque patch de Herbes create 2-3 Herbes (valeur 4). Herbes necessite barn type de stockage."; }

		{ String _name = "ClearCopper";				String _text = "Recolter Cuivre"; }
		{ String _name = "ClearCopperLwr";			String _text = "recolter Cuivre"; }
		{ String _name = "ClearCopperTip";			String _text = "Recoltez tout le cuivre et les autres mineraux rares (ou et argent) dans la zone selectionnee. Astuces : cuivre est utilise à fabrique certains tools et aussi comme batiment materiaux. cuivre et le autres rare ores sont Minerals. Fabrique sure vous ont materiau reserve disponible. 2-3 cuivre ores sont extracted (valeur 4), 1-2 argent ores (valeur 11) ou 1-2 ou ores (valeur 22). Fabrique sure vous ont Minerals reserve disponible à store ces. "; }

		{ String _name = "ClearAlmostAll";			String _text = "Recolter Presque Tout"; }
		{ String _name = "ClearAlmostAllLwr";			String _text = "recolter Presque Tout"; }
		{ String _name = "ClearAlmostAllTip";			String _text = "Recoltez tous les minerais et pierres dans la zone selectionnee. Astuces : Ce special tool va gather tout ores et tout stones. Va pas remove le trees et grass et autres valuable wild things. Tres useful à clean haut fast tout le lands around forestiers."; }

		{ String _name = "ClearFirewood";			String _text = "Recolter Bois Mort"; }
		{ String _name = "ClearFirewoodLwr";			String _text = "recolter Bois Mort"; }
		{ String _name = "ClearFirewoodTip";			String _text = "Recoltez tout le bois mort dans la zone selectionnee pour en faire du bois de chauffage. Astuces : Dead Bois sont dead trees fallen. Harvesting dead Bois spawn va create 5-8 bois de chauffage par dead tree."; }

		{ String _name = "BostonHouse";				String _text = "Maison de Boston"; }
		{ String _name = "BostonHouseLwr";			String _text = "maison de Boston"; }
		{ String _name = "BostonHouseTip";			String _text = "Boston House. Chaque citoyen adorerait vivre dans un(e) colore(e) Boston House. Taille : 4x5 cases. Cout : 54 bois de charpente, 6 pierre et 30 verre. Residence : 6 citoyens. Efficacite thermique % : 108. Modeles : 1. Couleurs : 8 variantes. Astuces : Appuyez sur F pour changer de couleur."; }

		{ String _name = "BostonHouse2";			String _text = "Boston House 2"; }
		{ String _name = "BostonHouse2Lwr";			String _text = "boston house 2"; }
		{ String _name = "BostonHouse2Tip";			String _text = "Boston House 2 (differentes textures et modeles). Chaque citoyen adorerait vivre dans un(e) colore(e) Boston House. Taille : 4x5 cases. Cout 54 bois de charpente, 6 pierre et 30 verre. Residence : 6 citoyens. Efficacite thermique % : 108. Modeles : 1. Couleurs : 10 variantes. Astuces : Appuyez sur F pour changer de couleur."; }

		{ String _name = "LittleHouseToolbar";			String _text = "Colorful Petit House Barre d outils"; }
		{ String _name = "LittleHouseToolbarLwr";		String _text = "colorful petit house barre d outils"; }
		{ String _name = "LittleHouseToolbarTip";		String _text = "Ouvrir ce barre d outils à obtenir Colorful Petit House options. Astuces : Ce est un set que contains un d abord floor et un special 2nd floor à go sur haut de le d abord floor pour un second family. Ils va ont 5 occupants et un Heat EFF% de 80. 12 differentes couleurs. Appuyez sur F pour changer de couleur."; }

		{ String _name = "LittleHouse01";			String _text = "Colorful Petit House"; }
		{ String _name = "LittleHouse01Lwr";			String _text = "colorful petit house"; }
		{ String _name = "LittleHouse01Tip";			String _text = "Un Colorful petit house est utilise pour housing votre citoyens. Taille : 3x5 cases. Cout : 24 rondins, 6 pierre. Residence : 5 citoyens. Efficacite thermique % : 80. Modeles : 1. Couleurs : 12 variantes. Astuces : Appuyez sur F pour changer de couleur."; }

		{ String _name = "LittleHouse01floor2";			String _text = "Colorful Petit House 2F"; }
		{ String _name = "LittleHouse01floor2Lwr";		String _text = "colorful petit house 2f"; }
		{ String _name = "LittleHouse01floor2Tip";		String _text = "Un Colorful 2nd floor est utilise pour housing un 2nd family. Taille : 1x5 cases. Cout : 32 rondins, 6 pierre. Residence : 6 citoyens. Efficacite thermique % : 90. Modeles : 1. Couleurs : 12 variantes. Astuces : Il goes à le droite next le d abord floor, fabrique sure vous align le chimneys dans le arriere. il a besoin à perfectly fit sur haut de le 1st floor. Appuyez sur F pour changer de couleur."; }


		{ String _name = "NMT30MultiStoryHousingToolbar";			String _text = "NMT un plusieurs niveaux House Barre d outils"; }
		{ String _name = "NMT30MultiStoryHousingToolbarLwr";			String _text = "nmt un plusieurs niveaux house barre d outils"; }
		{ String _name = "NMT30MultiStoryHousingToolbarTip";			String _text = "NMT un plusieurs niveaux House Barre d outils. Ouvrir ce barre d outils à obtenir NMT un plusieurs niveaux House options. Astuces : un plusieurs niveaux sont 3 batiments un etages. Ils sont disponibles en differentes shapes, costs, textures mais toujours meme Taille : 1x5 + 4x5 + 1x5. Le 2nd floor goes à le droite de le 1st floor, le 3rd floor goes à le gauche de le 1st floor. Ils ont 5-6 occupants Capacite et ont un range de Heat EFF% de 72 à 114."; }

		{ String _name = "NMT3Texture1";			String _text = "NMT un plusieurs niveaux Classic Stones Barre d outils"; }
		{ String _name = "NMT3Texture1Lwr";			String _text = "nmt un plusieurs niveaux barre d outils"; }
		{ String _name = "NMT3Texture1Tip";			String _text = "NMT un plusieurs niveaux Classic Stones Barre d outils. Ouvrir ce barre d outils à obtenir NMT un plusieurs niveaux House options. Astuces : Ils va necessite bois de charpente, pierre, fer, verre et rondins. Heat EFF% de 92 à 96."; }

		{ String _name = "NMT3Texture2";			String _text = "NMT un plusieurs niveaux Old Stones Barre d outils"; }
		{ String _name = "NMT3Texture2Lwr";			String _text = "nmt un plusieurs niveaux barre d outils"; }
		{ String _name = "NMT3Texture2Tip";			String _text = "NMT un plusieurs niveaux Old Stones Barre d outils. Ouvrir ce barre d outils à obtenir NMT un plusieurs niveaux House options. Astuces : Ils va necessite bois de charpente, pierre, fer, verre et rondins. Heat EFF% de 92 à 96."; }

