		{ String _name = "RKEBChapelwood";		String _text = "Petit Bois Chapel"; }
		{ String _name = "RKEBChapelwoodLwr";		String _text = "petit Bois chapel"; }
		{ String _name = "RKEBChapelwoodTip";		String _text = "Fournit happiness pour le devout et un place à meet et worship. Taille : 4x7. Cout : 24 rondins, 54 bois de charpente. Capacite : 100 Citizen. Rayon : 24 cases. Emplois : 1 clerc. Astuces : Appuyez sur F pour changer de couleur."; }

