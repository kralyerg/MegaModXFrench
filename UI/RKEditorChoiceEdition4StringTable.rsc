		{ String _name = "NMTFishingDockSet";			String _text = "Quai de Pêche"; }
		{ String _name = "NMTFishingDockSetLwr";		String _text = "quai de pêche"; }
		{ String _name = "NMTFishingDockSetTip";		String _text = "Quai de Pêche des Quais NMT : un lieu de travail où le poisson est pêché. Taille : 4x7. Coût : 30 rondins. Rayon de la zone de travail : 14. Emploie 1 à 3 pêcheurs. Astuce : le chevauchement des zones de travail de deux quais de pêche ou la présence de structures dans une zone réduit la quantité de poisson pêché. Veuillez garder l'avant de ce bâtiment libre pour ses caisses de poisson et ne pas l'utiliser comme quai de promenade."; }

		{ String _name = "NMTFishingStoneDockSet";		String _text = "Quai de Pêche"; }
		{ String _name = "NMTFishingStoneDockSetLwr";		String _text = "quai de pêche"; }
		{ String _name = "NMTFishingStoneDockSetTip";		String _text = "Quai de Pêche des Quais de Pierre NMT : un lieu de travail où le poisson est pêché. Taille : 4x7. Coût : 30 rondins. Rayon de la zone de travail : 14. Emploie 1 à 3 pêcheurs. Astuce : le chevauchement des zones de travail de deux quais de pêche ou la présence de structures dans une zone réduit la quantité de poisson pêché. Veuillez garder l'avant de ce bâtiment libre pour ses caisses de poisson et ne pas l'utiliser comme quai de promenade."; }

		{ String _name = "NMTWatermillDock";			String _text = "Moulin à Eau"; }
		{ String _name = "NMTWatermillDockLwr";			String _text = "moulin à eau"; }
		{ String _name = "NMTWatermillDockTip";			String _text = "Moulin à Eau des Quais NMT : un lieu de travail où le grain est moulu en farine. Taille : 7x5. Coût : 48 rondins, 8 fer. Emploie 1 à 3 meuniers. Astuce : nécessite 16 grains (orge, maïs, avoine, riz, seigle, sorgho ou blé) et produit 24 farines (non éduqué) / 32 farines (éduqué). Veuillez garder l'avant de ce bâtiment libre pour ses sacs de farine et ne pas l'utiliser comme quai de promenade."; }

		{ String _name = "NMTWatermillStoneDock";		String _text = "Moulin à Eau"; }
		{ String _name = "NMTWatermillStoneDockLwr";		String _text = "moulin à eau"; }
		{ String _name = "NMTWatermillStoneDockTip";		String _text = "Moulin à Eau des Quais de Pierre NMT : un lieu de travail où le grain est moulu en farine. Taille : 7x5. Coût : 48 pierre, 8 fer. Emploie 1 à 3 meuniers. Astuce : nécessite 16 grains (orge, maïs, avoine, riz, seigle, sorgho ou blé) et produit 24 farines (non éduqué) / 32 farines (éduqué). Veuillez garder l'avant de ce bâtiment libre pour ses sacs de farine et ne pas l'utiliser comme quai de promenade."; }

		{ String _name = "NMTSeafoodFarm";			String _text = "Ferme de Fruits de Mer"; }
