		{ String _name = "NMTSeafoodFarmTip";			String _text = "Ferme de Fruits de Mer des Quais NMT : un lieu de travail qui produit le fruit de mer de votre choix. Taille : 5x7, Coût : 32 rondins. Emploie 1 à 3 pêcheurs. Astuce : choisissez un produit à fabriquer : écrevisses, crabes, crevettes, homards, huîtres, palourdes ou coquilles Saint-Jacques. Veuillez garder l'avant de ce bâtiment libre pour ses caisses de nourriture et ne pas l'utiliser comme quai de promenade."; }

		{ String _name = "NMTSeafoodFarmRNG";			String _text = "Ferme de Fruits de Mer Aléatoire"; }
		{ String _name = "NMTSeafoodFarmRNGLwr";		String _text = "ferme de fruits de mer aléatoire"; }
		{ String _name = "NMTSeafoodFarmRNGTip";		String _text = "Ferme de Fruits de Mer Aléatoire des Quais NMT : un lieu de travail qui produit divers fruits de mer. Taille : 5x7, Coût : 32 rondins. Emploie 1 à 3 pêcheurs. Astuce : produit une variété aléatoire d'écrevisses, de crabes, de crevettes, de homards, d'huîtres, de palourdes, de coquilles Saint-Jacques et occasionnellement une perle. Veuillez garder l'avant de ce bâtiment libre pour ses caisses de nourriture et ne pas l'utiliser comme quai de promenade."; }

