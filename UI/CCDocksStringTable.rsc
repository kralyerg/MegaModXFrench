		{ String _name = "BayouEasyDesc";		String _text = "Bayou est fourni avec tout ce dont vous avez besoin pour démarrer une Ville des Quais. Un peu de riz, d'outils, de vêtements et de bois de chauffage sont fournis. Des poulets se trouvent aussi à proximité."; }

		{ String _name = "CCAdamEve";			String _text = "[CC] Adam et Ève"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Commencez avec seulement 2 personnes. Une petite quantité de nourriture, de bois de chauffage et de vêtements est fournie dans un petit chariot de stockage. Aucune structure n'a été construite, aucune graine ni bétail n'est disponible au depart - vous devrez survivre et tout acquérir."; }

