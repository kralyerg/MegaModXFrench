StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "La fonte au bas fourneau est démarrée par les ouvriers du village qui dégageront la zone, puis livreront les minerais, le charbon de bois et l'argile sur le site.";
		}
		{
			String _name = "text2";
			String _text = "Après quoi, un bâtisseur construira le bas fourneau à partir de l'argile. Dans le fourneau, ils ajouteront le minerai et le charbon de bois en couches alternées. Le fourneau est allumé tôt pendant l'ajout des couches ; les bâtisseurs effectueront la majeure partie du travail, en perçant un trou pour laisser s'échapper les scories indésirables, et une fois terminé, ils commenceront la démolition.";
		}
		{
			String _name = "text3";
			String _text = "Une fois cela terminé, un forgeron extraira la loupe";
		}
		{
			String _name = "text4";
			String _text = "du fourneau, et la travaillera pour créer le produit fini.";
		}
		{
			String _name = "text5";
			String _text = "Un bas fourneau devra être démoli une fois que le forgeron aura terminé de transformer le fer.";
		}
		{
			String _name = "text5copper";
			String _text = "Un bas fourneau devra être démoli une fois que le forgeron aura terminé de transformer le cuivre.";
		}
		{
			String _name = "IronRequire";
			String _text = "Fer - le plus commun et le plus utilisé des métaux ; le fer possède sa propre limite pour contrôler la production. Utilisé principalement comme matériau pour produire des outils, il sert également à la construction de bâtiments.";
		}
		{
			String _name = "CopperRequire";
			String _text = "Cuivre - produit sous la limite des métaux, alliages et objets forgés pour contrôler la production. Il est principalement utilisé dans la construction de bâtiments, mais peut aussi servir à fabriquer des outils et des articles en cuivre.";
		}
		{
			String _name = "BronzeRequire";
			String _text = "Bronze - produit sous la limite des métaux, alliages et objets forgés pour contrôler la production. Utilisé comme produit précoce pour fabriquer des outils, également utilisé dans la construction.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Appuyez pour démolir et commencer le nettoyage du site.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "Le bas fourneau est épuisé ; le nettoyage du site a maintenant commencé. Une fois terminé, vous pourrez retirer l'ancienne base du fourneau.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Arrêter le retrait des ressources et arrêter la destruction de ce bas fourneau.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Retirer";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Maintenant que vous êtes enfin prêt à retirer et nettoyer après le bas fourneau :";
		}
		{
			String _name = "text6";
			String _text = "Oups ! les bâtisseurs ont laissé derrière eux la base du bas fourneau épuisé, appuyez sur le bouton pour la retirer.";
		}
	]

}
