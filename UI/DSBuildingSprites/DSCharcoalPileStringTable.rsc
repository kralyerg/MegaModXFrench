StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "La carbonisation est démarrée par les ouvriers du village ; ils dégageront la zone, puis livreront les rondins sur le site.";
		}
		{
			String _name = "text2";
			String _text = "Après quoi, un bâtisseur préparera et disposera les rondins en une grande pile de bois, recouvrira le tout de terre, et avant de refermer complètement, ils allumeront la meule.";
		}
		{
			String _name = "text3";
			String _text = "Une fois le processus de carbonisation terminé, un charbonnier";
		}
		{
			String _name = "text4";
			String _text = "s'assurera que la meule est éteinte et en extraira le charbon de bois.";
		}
		{
			String _name = "text5";
			String _text = "Les meules à charbon sont dangereuses, malodorantes et fumantes. Elles sont mieux adaptées en dehors des villages, en forêt ou à l'écart des autres bâtiments.";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "Charbon de bois [Rondins]";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Appuyez pour démolir et commencer le nettoyage du site.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "La meule à charbon est épuisée ; le nettoyage du site a maintenant commencé. Une fois terminé, vous pourrez retirer les cendres restantes indésirables.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Arrêter le retrait des ressources et arrêter la destruction de cette meule à charbon.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Retirer";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Maintenant que vous êtes enfin prêt à retirer et nettoyer après la meule à charbon :";
		}
		{
			String _name = "text6";
			String _text = "Oups ! les bâtisseurs ont laissé derrière eux les cendres épuisées de la meule à charbon, appuyez sur le bouton pour les retirer.";
		}
	]

}
