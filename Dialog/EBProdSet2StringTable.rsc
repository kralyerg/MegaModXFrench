		{ String _name = "EBApothecaryTip";							String _text = "L'Apothicaire produit des Articles de Santé à partir de Racines, Herbes, Vin, Huile de Graines, Eau et Verrerie. Jusqu'à 2 Apothicaires peuvent être employés pour produire 3 à 4 Bouillon Curatif, Huile Curative ou Thé aux Herbes. Cycle de Construction : 60."; }
		
		{ String _name = "EBHerbalist";								String _text = "Herboriste"; }
