			String _name = "column2text13";
			String _text = "1 coke ou charbon de bois";
		}
		{
			String _name = "Lime01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 19-20 (charbon de bois-coke). Le travailleur non éduqué réalisera un profit de 5-6 (coke-charbon de bois), soit 1-1,2 par portion de chaux ; pendant ce temps, un travailleur éduqué réalisera un profit total de 20-21, soit 2,5-2,63 par portion de chaux.";
		}
		{
			String _name = "column2text14";
			String _text = "1 pierre + ";
		}
