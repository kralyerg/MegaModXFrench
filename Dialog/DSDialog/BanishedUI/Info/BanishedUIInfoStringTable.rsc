StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "Santé et bonheur";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "Santé et bonheur";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "- des maladies et affections qui frappent les villageois, et de leur bonheur et de leur dépression -";
		}
		{
			String _name = "column1text01";
			String _text = "La santé et le bonheur dans Banished sont affichés au joueur par l'utilisation d'icônes (voir à droite), présentées soit comme une statistique moyenne de la ville, soit individuellement lors de la sélection et de la consultation de l'interface d'un citoyen.";
		}
		{
			String _name = "column1text02";
			String _text = "En jouant à Banished, il peut parfois être facile d'avoir un village avec des cœurs ou des étoiles pleins (pour les niveaux de santé ou de bonheur respectivement).";
		}
		{
			String _name = "column1text03";
			String _text = "Mais en utilisant les mods DS*, les citoyens seront influencés plus souvent, et dans une plus grande mesure, par ce qui les rend malsains et malheureux. Cela offre au joueur une expérience de jeu plus stimulante et interactive.";
		}
		{
			String _name = "column1text04";
			String _text = "*(ceci ne sera en vigueur que lorsque certains mods DS sont placés au-dessus d'autres mods qui peuvent aussi modifier le fichier du citoyen).";
		}
		{
			String _name = "column1text05";
			String _text = "Il devient désormais nécessaire d'assurer une nutrition adéquate, ainsi que des besoins spirituels et autres fournis aux citoyens, tout en accordant une importance accrue à l'urbanisme pour combattre les influences négatives sur le bonheur.";
		}
		{
			String _name = "column1text06";
			String _text = "Maladies";
		}
		{
			String _name = "column1text07";
			String _text = "Outre les changements apportés à la santé et au bonheur des citoyens, il y a des changements";
		}
		{
			String _name = "column1text07add";
			String _text = "dans la probabilité et les types de maladies que les citoyens peuvent contracter. Lorsqu'un citoyen est atteint de l'une d'elles, il aura besoin des soins d'un hôpital et d'un médecin.";
		}
		{
			String _name = "column1text08";
			String _text = "une liste des maladies et affections :";
		}
		{
			String _name = "column1text09";
			String _text = "Apoplexie (accident vasculaire cérébral)";
		}
		{
			String _name = "column1text10";
			String _text = "Atrophie (fonte musculaire)";
		}
		{
			String _name = "column1text11";
			String _text = "Bilieux";
		}
		{
			String _name = "column1text12";
			String _text = "Fièvre noire (parasitaire)";
		}
		{
			String _name = "column1text13";
			String _text = "Empoisonnement du sang (septicémie)";
		}
		{
			String _name = "column1text14";
			String _text = "Os brisé";
		}
		{
			String _name = "column1text15";
			String _text = "Varicelle";
		}
		{
			String _name = "column1text16";
			String _text = "Choléra";
		}
		{
			String _name = "column1text17";
			String _text = "Diarrhée";
		}
		{
			String _name = "column1text18";
			String _text = "Diphtérie";
		}
		{
			String _name = "column1text19";
			String _text = "Dysenterie (le flux sanglant)";
		}
		{
			String _name = "column1text20";
			String _text = "Endocardite (maladie de l'elfe des eaux)";
		}
		{
			String _name = "column1text21";
			String _text = "Ergotisme (le feu de saint Antoine)";
		}
		{
			String _name = "column1text22";
			String _text = "Gonorrhée";
		}
		{
			String _name = "column1text23";
			String _text = "Grippe (la suette)";
		}
		{
			String _name = "column1text24";
			String _text = "Lèpre";
		}
		{
			String _name = "column1text25";
			String _text = "Malaria (la fièvre)";
		}
		{
			String _name = "column1text26";
			String _text = "Rougeole";
		}
		{
			String _name = "column1text27";
			String _text = "Oreillons";
		}
		{
			String _name = "column1text28";
			String _text = "Peste (la mort noire)";
		}
		{
			String _name = "column1text29";
			String _text = "Pneumonie";
		}
		{
			String _name = "column1text30";
			String _text = "Scarlatine";
		}
		{
			String _name = "column1text31";
			String _text = "Scrofule (le mal du roi)";
		}
		{
			String _name = "column1text32";
			String _text = "Scorbut";
		}
		{
			String _name = "column1text33";
			String _text = "Variole (la peste rouge)";
		}
		{
			String _name = "column1text34";
			String _text = "Tuberculose";
		}
		{
			String _name = "column1text35";
			String _text = "Fièvre typhoïde (typhus)";
		}
		{
			String _name = "column1text36";
			String _text = "Coqueluche";
		}
		{
			String _name = "column1text37";
			String _text = "Fièvre jaune";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "probabilité de décès : improbable";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "probabilité de décès : possible";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "probabilité de décès : commune";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "probabilité d'acquisition : très faible";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "probabilité d'acquisition : faible";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "probabilité d'acquisition : occasionnelle";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "probabilité d'acquisition : commune";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "probabilité d'acquisition : élevée";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "probabilité d'acquisition : très élevée";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "peut être transmise ? non";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "peut être transmise ? oui";
		}
		{
			String _name = "column2text01";
			String _text = "Icônes de santé :";
		}
		{
			String _name = "column2text02";
			String _text = "La santé d'un citoyen est déterminée par de nombreux facteurs :";
		}
		{
			String _name = "column2text03";
			String _text = "Avoir un régime alimentaire complet comprenant de nombreux aliments de toutes les catégories : fruits, céréales, protéines et légumes.";
		}
		{
			String _name = "column2text04";
			String _text = "Des herboristes avec des réserves abondantes d'herbes et de médicaments.";
		}
		{
			String _name = "column2text05";
			String _text = "Des médecins et une capacité de traitement des patients adéquate pour la prévention rapide des maladies.";
		}
		{
			String _name = "column2text06";
			String _text = "Les bateaux marchands et les nomades comportent un risque élevé d'apporter des maladies aux villages. Cela peut réduire considérablement la santé des citoyens si des contrôles préventifs ne sont pas en place.";
		}
		{
			String _name = "column2text07";
			String _text = "De même, un manque d'herboristes pour administrer des soins, ou un approvisionnement inadéquat en herbes et médicaments, signifiera que les maladies courantes seront répandues parmi les villageois. Cela devient préoccupant avec des citoyens trop malsains qui sont susceptibles d'abriter et de transmettre des maladies mortelles.";
		}
		{
			String _name = "column2text08";
			String _text = "Il est extrêmement important de garder vos citoyens au chaud à mesure que les températures baissent. Cela signifie non seulement un approvisionnement prêt en carburants pour un foyer, mais aussi des chemins et des routes adéquats pour que les citoyens puissent atteindre rapidement des lieux de chaleur.";
		}
		{
			String _name = "column2text09";
			String _text = "Les bâtiments qui offrent de la santé aux citoyens se distinguent par les couleurs de leur rayon :";
		}
		{
			String _name = "column2text10";
			String _text = "Les herboristes sont connus pour cueillir, préparer et administrer des herbes médicinales pour les nombreux maux mineurs qui frappent les citoyens tout au long de leur vie.";
		}
		{
			String _name = "column2text11";
			String _text = "Les hôpitaux et médecins sont nécessaires pour le traitement des maladies de nature infectieuse et mortelle, ainsi que des affections compliquées comme les os brisés (voir la liste à gauche).";
		}
		{
			String _name = "column3text01";
			String _text = "Icônes de bonheur :";
		}
		{
			String _name = "column3text02";
			String _text = "Le bonheur d'un citoyen est divisé selon les catégories positives suivantes données par les bâtiments, elles sont facilement reconnaissables par les couleurs de rayon correspondantes :";
		}
		{
			String _name = "column3text03";
			String _text = "Sécurité";
		}
		{
			String _name = "column3text04";
			String _text = "Biens";
		}
		{
			String _name = "column3text05";
			String _text = "Esprit";
		}
		{
			String _name = "column3text06";
			String _text = "Divertissement";
		}
		{
			String _name = "column3text07";
			String _text = "Alcool";
		}
		{
			String _name = "column3text08";
			String _text = "Autre";
		}
		{
			String _name = "column3text09";
			String _text = "En outre, il existe aussi un aspect négatif parfois donné par les bâtiments bruyants, malodorants ou dangereux :";
		}
		{
			String _name = "column3text10";
			String _text = "Détraction";
		}
		{
			String _name = "column3text11";
			String _text = "La dépression devient bien réelle pour les citoyens malheureux, ils flâneront plus souvent et deviendront moins productifs.";
		}
		{
			String _name = "column3text12";
			String _text = "Et comme dans une spirale descendante : moins ils accomplissent de travail, plus ils deviennent malheureux.";
		}
		{
			String _name = "column3text13";
			String _text = "Faire en sorte que vos citoyens se sentent en sécurité au moyen de puits de lutte contre les incendies, ou même de tours de garde et de murs.";
		}
		{
			String _name = "column3text14";
			String _text = "Les marchés, marchands et comptoirs commerciaux, ainsi que certains bâtiments de production, peuvent apporter le bonheur des biens aux citoyens.";
		}
		{
			String _name = "column3text15";
			String _text = "S'assurer que leurs besoins spirituels sont comblés par des chapelles et des lieux de culte et de prière, mais aussi par des cimetières et des lieux où les citoyens peuvent pleurer leurs disparus.";
		}
		{
			String _name = "column3text16";
			String _text = "Le bonheur du divertissement est divisé en deux catégories, définies par les couleurs de leur rayon :";
		}
		{
			String _name = "column3text17";
			String _text = "Alcool, auberges et tavernes. Les citoyens aiment consommer de l'alcool et la vie de taverne. Gardez les caves et les maisons de bière pleines.";
		}
		{
			String _name = "column3text18";
			String _text = "Le bonheur d'autre divertissement peut venir de théâtres, de monuments ou d'autres bâtiments sans rapport avec l'alcool.";
		}
		{
			String _name = "column3text19";
			String _text = "Le rayon des bâtiments avec une détraction influencera négativement tout citoyen se trouvant à l'intérieur. Grâce à l'urbanisme et à la construction d'influences positives autour de ces bâtiments de production, vous pouvez vous assurer que les travailleurs ne deviendront pas trop malheureux.";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "Combustibles domestiques";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "Combustibles domestiques";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "- des combustibles que les citoyens utiliseront pour le chauffage de leurs maisons -";
		}
		{
			String _name = "column1text01a";
			String _text = "Le chauffage d'une maison est aussi important que le toit et les murs qui en retiennent la chaleur. Le foyer d'une maison est ce qui en fait un vrai chez-soi, c'est là que les citoyens se tiendront au chaud et cuisineront leurs repas.";
		}
		{
			String _name = "column1text01b";
			String _text = "Selon le type de logement, leur besoin en carburant n'apparaît qu'en dessous d'une certaine température. Par exemple, les maisons vanilla en bois et en pierre nécessiteront un carburant pour garder les citoyens au chaud à 50degF et en dessous (cela représente la qualité de l'isolation des maisons, leur capacité à résister à des températures plus basses).";
		}
		{
			String _name = "column1text01c";
			String _text = "La variation dans la chaleur des logements vanilla provient de la quantité de chaleur et du temps disponibles à partir d'un combustible domestique (l'efficacité du foyer/feu). Une maison en bois donnera une cote de chaleur de 60, tandis que la maison en pierre donnera une cote de chaleur de 90, obtenant ainsi plus de chaleur avec moins de carburant.";
		}
		{
			String _name = "valueTip";
			String _text = "Valeur du produit";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valeur du produit, ce produit a une valeur fluctuante ; ainsi, les marchands peuvent offrir ou acheter à un prix compris dans cette fourchette";
		}
		{
			String _name = "weightTip";
			String _text = "Poids du produit";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantité de produit produite par des travailleurs éduqués ou non éduqués";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "est fabriqué à partir de :";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou :";
		}
		{
			String _name = "Firewood00";
			String _text = "Bois de chauffage";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "Le bois de chauffage est produit et stocké sous la limite Carburant : domestique. 6 sont fabriqués à partir d'une bûche par les bûcherons non éduqués et éduqués.";
		}
		{
			String _name = "Firewood01";
			String _text = "1 Bûche";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "Il y a un coût d'entrée par cycle de 5 pour la bûche unique. Les travailleurs non éduqués et éduqués réaliseront un profit total de 7, soit 1,17 par bois de chauffage.";
		}
		{
			String _name = "Firewood02";
			String _text = "2 Bois de construction";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "Il y a un coût d'entrée par cycle de 8 pour le bois de construction. Les travailleurs non éduqués et éduqués réaliseront un profit total de 4, soit 0,67 par bois de chauffage.";
		}
		{
			String _name = "FirewoodQty";
			String _text = "Production : 6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "Charbon de bois";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "Le charbon de bois, créé par une réaction thermique appelée pyrolyse, est produit sous la limite des combustibles : métallurgiques pour contrôler la production. Le charbon de bois est aussi un combustible qui sera utilisé par les citoyens pour chauffer leurs maisons s'il est disponible à proximité.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Bûches";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 105. Le travailleur non éduqué réalisera un profit de 133, soit 3,91 par pièce de charbon de bois ; pendant ce temps, un travailleur éduqué réalisera un profit total de 280, soit 5,09 par pièce de charbon de bois.";
		}
		{
			String _name = "CharcoalQty";
			String _text = "Production : 34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

