			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoPotteryGlass
{
	Entry _strings
	[
		{
			String _name = "PotteryGlass";
			String _text = "Poterie et verre";
		}
		{
			String _name = "PotteryGlassTitle1";
			String _text = "Poterie, briques, tuiles et fabrication du verre";
		}
		{
			String _name = "PotteryGlassTitle2";
			String _text = "- des matériaux de terre bruts, en tant que récipients et verre à vitres -";
		}
		{
			String _name = "column1text01";
			String _text = "La poterie est un bien travaillé et un ustensile important, utilisé dans la vie quotidienne par les citoyens. Comme de nombreux objets différents : une simple lampe, elle est utilisée comme article de construction essentiel (notamment dans les mines), et comme récipients pour le mélange, le stockage et la conservation des articles.";
		}
		{
			String _name = "column1text02";
			String _text = "Il est indéniable que l'utilisation des briques et des tuiles de toit dans la construction de bâtiments est importante. Dans la plupart des cas, elles sont plus légères et plus durables que leurs équivalents en pierre, en bois et en chaume. Et lorsqu'elles sont utilisées dans la construction de résidences, elles augmenteront et donneront une meilleure rétention de la chaleur et de la chaleur.";
		}
		{
			String _name = "column1text03";
			String _text = "Le verre est une création merveilleuse ; le verre à vitres, celui utilisé pour les fenêtres des bâtiments, présente de nombreux avantages : en laissant entrer plus de lumière, il permet aux maisons d'utiliser moins de combustible, car nous ne vivons plus dans des taudis de pierre sombres et humides. Utile dans les bâtiments de production, plus de lumière permet d'accomplir le travail plus rapidement et avec une meilleure qualité.";
		}
		{
			String _name = "column1text04";
			String _text = "La verrerie, comme la poterie, est fabriquée et utilisée comme récipients pour le mélange et le stockage des articles, elle est aussi utilisée par une raffinerie pour produire des amulettes.";
		}
		{
			String _name = "column1text05";
			String _text = "Illustrant davantage les usages incroyables du matériau : la chaux ; elle peut aussi être utilisée dans la production de la poterie et du verre. Dans la production de la poterie, elle remplace, avec le sable, l'argile dans la recette. Dans la production du verre, elle agit d'une manière très similaire en étant un liant pour un verre plus solide, mais elle permet aussi d'utiliser moins de sable.";
		}
		{
			String _name = "column2AreMadeFrom";
			String _text = "sont fabriqués à partir de :";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "est fabriqué à partir de :";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou :";
		}
		{
			String _name = "valueTip";
			String _text = "Valeur du produit";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valeur du produit, ce produit a une valeur fluctuante ; ainsi, les marchands peuvent offrir ou acheter à un prix compris dans cette fourchette";
		}
		{
			String _name = "weightTip";
			String _text = "Poids du produit";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantité de produit produite par des travailleurs éduqués ou non éduqués";
		}
		{
			String _name = "column2text01";
			String _text = "Poterie";
		}
		{
			String _name = "Pottery00Tip";
			String _text = "Un bien travaillé largement utilisé, la poterie offre de nombreuses fonctions aux citoyens dans la production et la construction. Utilise la limite des biens travaillés et ustensiles pour contrôler la production.";
		}
		{
			String _name = "column2text02";
			String _text = "4 argile + ";
		}
		{
			String _name = "column2text03";
			String _text = "1 coke ou charbon de bois";
		}
		{
			String _name = "Pottery01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 19-20 (charbon de bois-coke). Le travailleur non éduqué réalisera un profit total de 4-5 (coke-charbon de bois) car seulement 3 pièces de poterie seront fabriquées ; pendant ce temps, un travailleur éduqué fabriquera 4 pièces de poterie avec un profit total de 12-13, soit 3-3,25 par pièce de poterie.";
		}
		{
			String _name = "column2text04";
			String _text = "2 sable + ";
