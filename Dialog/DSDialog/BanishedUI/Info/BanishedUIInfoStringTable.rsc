StringTable InfoMiningSmelting
{
	Entry _strings
	[
		{
			String _name = "MiningSmelting";
			String _text = "Mines et fonderie";
		}
		{
			String _name = "MiningSmeltingTitle1";
			String _text = "Extraction minière, essai et métallurgie";
		}
		{
			String _name = "MiningSmeltingTitle2";
			String _text = "- des minerais, minéraux, pierres et matériaux de terre brute -";
		}
		{
			String _name = "MiningSmeltingTitle3";
			String _text = "- et des combustibles et fondants pour la métallurgie -";
		}
		{
			String _name = "column1text01";
			String _text = "Le fer, c'est-à-dire le fer natif pur, s'il en existe dans le règne minéral, est en effet d'une rareté extrême. Il n'est plus disponible en tant que métal extrait ou récolté à la surface. À la place, le minerai de fer est extrait ; la plupart du temps il est disponible dans les mines, mais il existe aussi une petite quantité finie de minerai que l'on peut trouver à la surface de la carte au début d'une partie. Ceci est un changement réaliste dans le processus de production du fer.";
		}
		{
			String _name = "column1text01a";
			String _text = "L'extraction minière (et la taille de la pierre) est typiquement une occupation dangereuse dans le jeu ; ceci est maintenant atténué dans une certaine mesure par un coût supplémentaire. L'extraction minière est coûteuse, avec au minimum un coût d'une bûche ou d'un morceau de bois de construction pour chaque cycle. Les mines plus profondes et plus grandes peuvent aussi nécessiter de l'huile de lampe ou des bougies pour fonctionner.";
		}
		{
			String _name = "column1text01b";
			String _text = "Bien que la pierre puisse être prélevée en surface par n'importe quel ouvrier avec des outils normaux, la pierre extraite en carrière nécessitera désormais l'utilisation d'ustensiles spécialisés à chaque cycle : 'Outils : tailleur de pierre', un bien travaillé et un ustensile, fabriqué chez les forgerons. Comme pour les mineurs, les tailleurs de pierre ont désormais aussi une probabilité réduite de mort accidentelle.";
		}
		{
			String _name = "column1text02";
			String _text = "Le minerai de fer doit être fondu dans un four très chaud pour éliminer les impuretés et être transformé en l'un des métaux les plus rigides : le fer.";
		}
		{
			String _name = "column1text02a";
			String _text = "Minerai de fer";
		}
		{
			String _name = "column1text02b";
			String _text = "Principalement miné, bien qu'une petite quantité se trouve en surface. Le minerai de fer n'a pas de forme certaine ; étant tout à fait irrégulier, le plus souvent d'une couleur rouillée. C'est cette couleur qui trahit la quantité de fer qu'il contient, étant du minerai de fer le plus fusible.";
		}
		{
			String _name = "column1text02c";
			String _text = "Extrait en quantités de 3 à 5 minerai de fer.";
		}
		{
			String _name = "column1text02copper";
			String _text = "Le minerai de cuivre nécessite aussi un four d'une grande chaleur pour être fondu en une forme métallique solide de cuivre.";
		}
		{
			String _name = "column1text02coppera";
			String _text = "Minerai de cuivre";
		}
		{
			String _name = "column1text02copperb";
			String _text = "Principalement miné, bien qu'une grande quantité se trouve en surface. Le minerai de cuivre, parfois lorsqu'il est fraîchement extrait, est d'un rouge-bleu très sombre, mais avant même d'atteindre la surface, il s'oxyde et prend les plus belles couleurs de bleu et de vert.";
		}
		{
			String _name = "column1text02copperc";
			String _text = "Extrait en cycles de 3 à 5 minerai de cuivre.";
		}
		{
			String _name = "column1text02tin";
			String _text = "Le minerai d'étain nécessitera un four pour être fondu en une forme métallique solide d'étain, bien qu'il soit aussi utilisé avec le minerai de cuivre pour forger le bronze.";
		}
		{
			String _name = "column1text02tina";
			String _text = "Minerai d'étain";
		}
		{
			String _name = "column1text02tinb";
			String _text = "Miné, bien que des quantités se trouvent en surface. Le minerai d'étain le plus riche est d'une couleur noire ou sombre, de forme polyédrique, mais tout à fait irrégulière, souvent sa surface est très brillante. On le trouve couramment dans des dépôts alluviaux le long des berges de rivières.";
		}
		{
			String _name = "column1text02tinc";
			String _text = "Extrait en cycles de 3 à 5 minerai d'étain.";
		}
		{
			String _name = "column1text03";
			String _text = "Le minerai d'argent doit aussi être fondu, mais à une température plus lente et plus basse dans un four d'affinage pour extraire l'argent proprement dit.";
		}
		{
			String _name = "column1text02silvera";
			String _text = "Minerai d'argent";
		}
		{
			String _name = "column1text02silverb";
			String _text = "Le minerai d'argent n'est que miné, et bien qu'il soit parfois trouvé sous sa forme la plus pure et native, le considérer comme tel n'a aucune valeur. Car il contient certainement du soufre et de l'arsenic. Ainsi, tout l'argent d'une mine doit être fondu avec les minerais les moins purs.";
		}
		{
			String _name = "column1text02silverc";
			String _text = "Extrait en cycles de 3 à 5 minerai d'argent.";
		}
		{
			String _name = "column1text03Gold1";
			String _text = "L'or ; de tous les autres métaux, c'est celui que l'on trouve le plus fréquemment à l'état natif, exempt de soufre et d'arsenic. Je ne connais aucun minerai dans lequel l'or constituerait la plus grande partie métallique. Il existe en effet plusieurs minerais vendus sous ce nom, mais après un examen rigoureux, on constate qu'ils ne le sont pas. Il est parfois arrivé que de nombreuses personnes, trompées par la couleur rouge-jaunâtre de ces minerais, pensant qu'il y avait de l'or dedans, les aient pris pour des minerais d'or. Mais je n'ai jamais vu personne s'enrichir grâce à eux, ni à partir du peu d'or que l'on pourrait en fondre.";
		}
		{
			String _name = "column1text04";
			String _text = "Pour qu'un four ou une forge de forgeron atteigne une température suffisante pour fondre et extraire les minerais, il faut des combustibles capables de brûler à une température plus élevée, et plus longtemps que le bois de chauffage ou le charbon (tous deux ont trop d'impuretés, brûlent irrégulièrement et trop vite). L'utilisation d'un combustible métallurgique est désormais essentielle dans tous les aspects de la métallurgie :";
		}
		{
			String _name = "column1text05";
			String _text = "Charbon de bois";
		}
		{
			String _name = "column1text05a";
			String _text = "Produit à partir de bûches, le charbon de bois est fabriqué de manière primitive dans un tas de charbon de bois, ou dans un four à charbon de bois (bientôt disponible).";
		}
		{
			String _name = "column1text05b";
			String _text = "Les bûches sont chauffées en l'absence d'oxygène, la pyrolyse ou la carbonisation commence, ceci élimine les impuretés et à partir de là, environ 34 à 55 charbon de bois est produit pour chaque entrée de 21 bûches.";
		}
		{
			String _name = "column1text06";
			String _text = "Coke";
		}
		{
			String _name = "column1text06a";
			String _text = "Produit à partir du charbon, le coke est 'cuit', un peu comme le charbon de bois ; de manière primitive dans un foyer de charbon empilé (bientôt disponible), où le charbon est empilé et recouvert de terre, ou dans un four à coke en forme de ruche, il est produit plus rapidement.";
		}
		{
			String _name = "column1text06b";
			String _text = "Le processus nécessite 21 charbon miné pour produire environ 21 à 34 coke.";
		}
		{
			String _name = "column1text08";
			String _text = "Le forgeage des métaux est rapide et se fait dans des conditions très chaudes, ce qui signifie qu'il y a souvent beaucoup de gaspillage dans la quantité de minerai utilisée par rapport à ce qui est finalement produit.";
		}
		{
			String _name = "column1text09";
			String _text = "L'introduction d'un fondant dans un four avec le minerai et le combustible permet d'utiliser la moitié de la quantité de minerai tout en maintenant la même production :";
		}
		{
			String _name = "column1text10";
			String _text = "Chaux (aussi appelée chaux vive)";
		}
		{
			String _name = "column1text10a";
			String _text = "Produite dans un four de forme similaire à un four à coke, la chaux est le produit de pierre plus tendre (plus riche en calcium). La pierre est empilée dans un four où elle est chauffée avec un combustible jusqu'à ce qu'elle réagisse et devienne une poudre blanc-gris.";
		}
		{
			String _name = "column1text10b";
			String _text = "Un seul gros morceau de pierre avec l'ajout d'un combustible produira probablement environ 5 à 8 chaux.";
		}
		{
			String _name = "column1text10c";
			String _text = "L'utilisation de la chaux dans le four lors de la fonte des métaux réagit avec les minerais en aidant à séparer les impuretés. La chaux est aussi utilisée comme matériau de construction, agissant comme un liant solide et augmentant aussi l'isolation thermique d'un bâtiment.";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "est fabriqué à partir de :";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou :";
		}
		{
			String _name = "valueTip";
			String _text = "Valeur du produit";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valeur du produit, ce produit a une valeur fluctuante ; ainsi, les marchands peuvent offrir ou acheter à un prix compris dans cette fourchette";
		}
		{
			String _name = "weightTip";
			String _text = "Poids du produit";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantité de produit produite par des travailleurs éduqués ou non éduqués";
		}
		{
			String _name = "column2text01";
			String _text = "Fer";
		}
		{
			String _name = "Iron00Tip";
			String _text = "Le plus commun et le plus utilisé de tous les métaux ; le fer a sa propre limite pour contrôler la production. Utilisé de manière importante comme matériau pour produire des outils, il est aussi utilisé dans la construction de bâtiments.";
		}
		{
			String _name = "column2text02";
			String _text = "5 minerai de fer + ";
		}
		{
			String _name = "column2text03";
			String _text = "2 coke ou charbon de bois";
		}
		{
			String _name = "Iron01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 34-36 (charbon de bois-coke). Le travailleur non éduqué fera une perte de 2 avec le coke, ou sera à l'équilibre avec le charbon de bois, car une seule pièce de fer sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 32-34 (coke-charbon de bois), soit 16-17 par pièce de fer.";
		}
		{
			String _name = "column2text04";
			String _text = "3 minerai de fer + ";
		}
		{
			String _name = "column2text05";
			String _text = "1 chaux + ";
		}
		{
			String _name = "column2text06";
			String _text = "2 coke ou charbon de bois";
		}
		{
			String _name = "Iron02Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 31-33 (charbon de bois-coke). Le travailleur non éduqué réalisera un profit de 1-3 (coke-charbon de bois) car une seule pièce de fer sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 35-37, soit 17,5-18,5 par pièce de fer. Comme le coke est à la chaux ce que le charbon de bois est, la chaux est potentiellement un matériau moins cher à produire que le minerai de fer, les profits totaux de bout en bout sont probablement plus élevés.";
		}
		{
			String _name = "IronQty";
			String _text = "Production : 1-2";
		}
		{
			String _name = "IronValue";
			String _text = "34";
		}
		{
			String _name = "IronWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01c";
			String _text = "Cuivre";
		}
		{
			String _name = "Copper00Tip";
			String _text = "Le cuivre est produit sous la limite des métaux, alliages et forgeage pour contrôler la production. Les usages sont principalement dans la construction de bâtiments, bien qu'il puisse aussi être utilisé pour fabriquer des outils et d'autres objets en cuivre.";
		}
		{
			String _name = "column2text02c";
			String _text = "5 minerai de cuivre + ";
		}
		{
			String _name = "Copper01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 34-36 (charbon de bois-coke). Le travailleur non éduqué fera une perte de 4-6 car une seule pièce de cuivre sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 24-26 (coke-charbon de bois), soit 12-13 par pièce de cuivre.";
		}
		{
			String _name = "column2text04c";
			String _text = "3 minerai de cuivre + ";
		}
		{
			String _name = "Copper02Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 31-33 (charbon de bois-coke). Le travailleur non éduqué fera une perte de 1-3 car une seule pièce de cuivre sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 27-29 (coke-charbon de bois), soit 13,5-14,5 par pièce de cuivre. Comme le coke est à la chaux ce que le charbon de bois est, la chaux est potentiellement un matériau moins cher à produire que le minerai de cuivre, les profits totaux de bout en bout sont probablement plus élevés.";
		}
		{
			String _name = "CopperQty";
			String _text = "Production : 1-2";
		}
		{
			String _name = "CopperValue";
			String _text = "30";
		}
		{
			String _name = "CopperWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cTin";
			String _text = "Étain";
		}
		{
			String _name = "Tin00Tip";
			String _text = "L'étain est produit sous la limite des métaux, alliages et forgeage pour contrôler la production. Les usages sont dans la fabrication d'articles en étain et en tant que bien précieux dans le commerce.";
		}
		{
			String _name = "column2text02cTin";
			String _text = "5 minerai d'étain + ";
		}
		{
			String _name = "Tin01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 39-41 (charbon de bois-coke). Le travailleur non éduqué fera une perte de 3-5 car une seule pièce d'étain sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 31-33 (coke-charbon de bois), soit 15,5-16,5 par pièce d'étain.";
		}
		{
			String _name = "column2text04cTin";
			String _text = "3 minerai d'étain + ";
		}
		{
			String _name = "Tin02Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 34-36 (charbon de bois-coke). Le travailleur non éduqué sera à l'équilibre avec le coke, ou réalisera un profit de 2 avec le charbon de bois ; pendant ce temps, un travailleur éduqué réalisera un profit total de 36-38 (coke-charbon de bois), soit 18-19 par pièce d'étain. Comme le coke est à la chaux ce que le charbon de bois est, la chaux est potentiellement un matériau moins cher à produire que le minerai d'étain, les profits totaux de bout en bout sont probablement plus élevés.";
		}
		{
			String _name = "TinQty";
			String _text = "Production : 1-2";
		}
		{
			String _name = "TinValue";
			String _text = "36";
		}
		{
			String _name = "TinWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cBronze";
			String _text = "Bronze";
		}
		{
			String _name = "Bronze00Tip";
			String _text = "Le bronze est produit sous la limite des métaux, alliages et forgeage pour contrôler la production. Les usages sont dans les outils et la construction de bâtiments.";
		}
		{
			String _name = "column2text02cBronze";
			String _text = "7 minerai de cuivre + ";
		}
		{
			String _name = "Bronze01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 47-49 (charbon de bois-coke). Le travailleur non éduqué réalisera un profit de 11-13 car une seule pièce de bronze sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 41-43 (coke-charbon de bois), soit 13,67-14,33 par pièce de bronze.";
		}
		{
			String _name = "column2text04cBronze";
			String _text = "1 minerai d'étain + ";
		}
		{
			String _name = "BronzeQty";
			String _text = "Production : 2-3";
		}
		{
			String _name = "BronzeValue";
			String _text = "30";
		}
		{
			String _name = "BronzeWeight";
			String _text = "25";
		}
		{
			String _name = "column2text16";
			String _text = "Argent";
		}
		{
			String _name = "Silver00Tip";
			String _text = "L'argent merveilleux, couramment utilisé comme monnaie, étant un article de grande valeur et de faible poids, est produit sous sa propre limite pour contrôler la production/accumulation.";
		}
		{
			String _name = "column2text17";
			String _text = "2 minerai d'argent + ";
		}
		{
			String _name = "column2text18";
			String _text = "1 coke ou charbon de bois";
		}
		{
			String _name = "Silver01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 23-24 (charbon de bois-coke). Le travailleur non éduqué fera une perte de 2-3 car une seule pièce d'argent sera fabriquée ; pendant ce temps, un travailleur éduqué réalisera un profit total de 18-19 (coke-charbon de bois), soit 9-9,5 par pièce d'argent.";
		}
		{
			String _name = "SilverQty";
			String _text = "Production : 1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
			String _name = "SilverWeight";
			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "Lingot d'argent";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "Un artisan qualifié est capable de forger avec succès un lingot d'argent, en utilisant moins de combustible pour une plus grande masse d'argent, de plus grande valeur, utilisé comme monnaie, il est produit sous la limite de l'argent pour contrôler la production/accumulation.";
		}
		{
			String _name = "column2text20";
			String _text = "6 minerai d'argent + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 coke ou charbon de bois";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "Cette méthode a un coût d'entrée par cycle de 55-56 (charbon de bois-coke). Le travailleur non éduqué subira une perte de 5-6 car il ne pourra pas maintenir la chaleur du four avec une si petite quantité de combustible, et ne produira qu'1 lingot d'argent ; pendant ce temps, un travailleur éduqué qualifié réalisera un profit total de 44-45 (coke-charbon de bois), soit 22-22,5 par lingot d'argent.";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "Production : 1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
		{
			String _name = "SilverIngotWeight";
			String _text = "50";
		}
		{
			String _name = "GoldTitle";
			String _text = "Or";
		}
		{
			String _name = "Gold00Tip";
			String _text = "L'or, bien qu'il ne soit pas miné intentionnellement, ni trouvé en quantités suffisantes pour cela, se trouve sous sa forme pure native et est parfois extrait dans des mines d'argent ou tamisé le long des rivières et des ruisseaux. Utilisé comme monnaie, l'or a aussi sa propre limite pour contrôler la production/accumulation.";
		}
		{
			String _name = "GoldQty";
			String _text = "Production : 1";
		}
		{
			String _name = "Gold01Tip";
			String _text = "L'or est un métal rare et précieux, la probabilité de le trouver est faible, une chance sur 21.";
		}
		{
			String _name = "GoldValue";
			String _text = "252";
		}
		{
			String _name = "GoldWeight";
			String _text = "21";
		}
		{
			String _name = "IronOreTitle";
			String _text = "Minerai de fer";
		}
		{
			String _name = "IronOre00Tip";
			String _text = "Le minerai de fer est produit sous la limite des minerais et minéraux pour contrôler la production.";
		}
		{
			String _name = "IronOreQty";
			String _text = "Production : 3-5";
		}
		{
