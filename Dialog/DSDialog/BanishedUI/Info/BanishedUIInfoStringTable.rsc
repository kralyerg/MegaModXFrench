StringTable InfoToolsCrafted
{
	Entry _strings
	[
		{
			String _name = "ToolsCrafted";
			String _text = "Outils et ustensiles";
		}
		{
			String _name = "Title1";
			String _text = "Outils, biens travaillés et ustensiles";
		}
		{
			String _name = "Title2";
			String _text = "- des outils et ustensiles, ceux utilisés par tous les citoyens ou par les qualifiés -";
		}
		{
			String _name = "column1text01";
			String _text = "Les outils jouent un rôle très important pour aider à bâtir une ville prospère. Les outils, c'est-à-dire du type utilisé par tous les citoyens (outils en bronze, outils en fer, outils en acier, etc.), sont nécessaires pour les besoins économiques et pratiques. Utilisés pour entreprendre les tâches les plus essentielles : coupe du bois, défrichage, semis et récolte des champs, extraction minière, forge, tous nécessitent l'utilisation d'outils.";
		}
		{
			String _name = "column1text02";
			String _text = "Une tâche, ou un bâtiment, se voit attribuer un nombre de temps de travail, c'est l'unité de temps consacrée à entreprendre la tâche et achever le cycle/la production. Mais avec cela vient aussi un nombre de travail requis, ce nombre représente la quantité physique réelle de travail requise pour chaque cycle. Et c'est ce nombre qui influence directement, et qui est influencé par les outils.";
		}
		{
			String _name = "column1text03";
			String _text = "Sur la droite, vous verrez la liste des outils disponibles, sous le nom de chaque outil se trouve le symbole :";
		}
		{
			String _name = "column1text04";
			String _text = "Ce symbole, et le nombre à côté, représentent la qualité de l'outil et le nombre d'unités de travail qu'il est capable d'accomplir avant de 'se casser'.";
		}
		{
			String _name = "column1text05";
			String _text = "Non seulement un citoyen sans outil sera probablement très lent dans la production de biens, mais il sera aussi entravé dans la collecte et la récolte de nourriture, l'abattage d'arbres et la coupe de bois de chauffage. La construction de bâtiments est aussi sérieusement entravée si un constructeur n'a pas d'outil.";
		}
		{
			String _name = "column1text06";
			String _text = "Les changements apportés au jeu avec les mods DS actifs ont rendu la production de fer non plus aussi simple que de le collecter à la surface, ou d'avoir une mine qui le produise facilement avec un coût limité.";
		}
		{
			String _name = "column1text07";
			String _text = "un aperçu des changements :";
		}
		{
			String _name = "column1text08";
			String _text = "-Le fer natif n'est plus disponible à la surface de la carte, à la place il existe de petites quantités de minerai de fer, de minerai de cuivre et de minerai d'étain trouvées à travers le paysage.";
		}
		{
			String _name = "column1text08a";
			String _text = "-Le cuivre et l'étain sont les minerais les plus répandus trouvés en surface. Le minerai de fer se trouve en plus petites quantités.";
		}
		{
			String _name = "column1text09";
			String _text = "-Les mines ne produiront désormais que des minerais (ainsi que du charbon) au lieu des métaux natifs (fer, cuivre, etc.).";
		}
		{
			String _name = "column1text09a";
			String _text = "-La production minière aura désormais un coût soit en bûches ou en bois de construction, et en huile de lampe ou en bougies.";
		}
		{
			String _name = "column1text10";
			String _text = "-Le minerai de fer devra être fondu dans un four avec un combustible métallurgique (coke ou charbon de bois) pour produire du fer. Il en va de même pour le cuivre et les autres métaux et alliages.";
		}
		{
			String _name = "column1text10a";
			String _text = "-La production de coke provient de l'extraction et de la 'cuisson' du charbon. Le charbon de bois provient de la carbonisation des bûches.";
		}
		{
			String _name = "column1text10b";
			String _text = "-L'introduction du minerai de cuivre en surface permet la production d'un outil facile à produire en début de partie, un outil en cuivre peut être fondu en utilisant uniquement du bois de chauffage (voir la liste à droite).";
		}
		{
			String _name = "column1text10c";
			String _text = "-La production d'outils de meilleure qualité nécessitant un forgeage supplémentaire pour la résistance (outils en acier et trempés) nécessitera l'utilisation d'un combustible métallurgique.";
		}
		{
			String _name = "column1text11a";
			String _text = "Les outils peuvent être traités et aiguisés davantage pour devenir des versions 'affûtées' d'eux-mêmes à une meule. Ces outils sont désignés par un astérisque (*) après leur nom. Ces outils auront une meilleure durabilité de 25 unités de travail par rapport à leurs versions normales.";
		}
		{
			String _name = "column1text11b";
			String _text = "S'ils sont aussi traités et 'huilés', avec l'utilisation d'huile de lin, ces outils bénéficieront d'une durabilité accrue de 50 unités de travail. Ces outils sont désignés par un astérisque et un accent circonflexe (*^) après leur nom.";
		}
		{
			String _name = "column1text12";
			String _text = "Il existe d'autres types d'outils, de la variété des biens travaillés et ustensiles ; ils sont utilisés par diverses professions, soit pour la production de biens, soit pour la construction de bâtiments.";
		}
		{
			String _name = "column1text13a";
			String _text = "Outils : tailleur de pierre";
		}
		{
			String _name = "column1text13b";
			String _text = "Requis comme coût de production pour extraire la pierre des carrières, l'introduction des outils de tailleur de pierre a aussi réduit le risque élevé et la probabilité de mort accidentelle auxquels les tailleurs de pierre étaient confrontés. Aussi utilisé comme coût de construction dans certains grands bâtiments en pierre.";
		}
		{
			String _name = "column1text14a";
			String _text = "Outils : pêcheur";
		}
		{
			String _name = "column1text14b";
			String _text = "Requis comme coût de construction pour bâtir des lieux de pêche, ceux-ci étaient auparavant appelés équipement de pêche dans les anciens mods DS.";
		}
		{
			String _name = "column1text15a";
			String _text = "Outils : chasseur";
		}
		{
			String _name = "column1text15b";
			String _text = "Requis comme coût de construction pour bâtir des lieux de chasse, ceux-ci étaient auparavant appelés équipement de chasse dans les anciens mods DS.";
		}
		{
			String _name = "column1text16a";
			String _text = "Panier de cueillette";
		}
		{
			String _name = "column1text16b";
			String _text = "Requis comme coût de construction pour bâtir des lieux de cueillette, ainsi que comme coût de production pour la collecte des glands.";
		}
		{
			String _name = "column1text17";
			String _text = "En plus de ce qui précède, les biens travaillés suivants jouent des rôles importants dans l'extraction minière, la construction et l'amélioration des outils :";
		}
		{
			String _name = "column1text17a";
			String _text = "Huile de lampe";
		}
		{
			String _name = "column1text17b";
			String _text = "Utilisée comme coût de production pour extraire les minerais et minéraux des mines, aussi utilisée dans le coût de construction des tunnels.";
		}
		{
			String _name = "column1text18a";
			String _text = "Bougies";
		}
		{
			String _name = "column1text18b";
			String _text = "Utilisées comme coût de production pour extraire les minerais et minéraux des mines, aussi utilisées dans le coût de construction des tunnels et des lieux de culte.";
		}
		{
			String _name = "column1text19a";
			String _text = "Huile de lin";
		}
		{
			String _name = "column1text19b";
			String _text = "Utilisée à une meule pour améliorer les unités de travail des nouveaux outils, l'huile de lin augmente la durabilité du manche. En plus des 25 unités de travail gagnées grâce à l'aiguisage de l'outil, il gagne un 25 supplémentaire lorsque ce processus additionnel est aussi effectué.";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "est fabriqué à partir de :";
		}
		{
			String _name = "column2MadeFromEither";
			String _text = "l'un ou l'autre de ceux-ci";
		}
		{
			String _name = "column2MadeFromEitherAnd";
			String _text = "et en utilisant :";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou :";
		}
		{
			String _name = "column2ToolsTITLE";
			String _text = "Outils (utilisés par tous les citoyens) :";
		}
		{
			String _name = "column2CraftedTITLE";
			String _text = "Biens travaillés et ustensiles :";
		}
		{
			String _name = "column2Usedby";
			String _text = "Ce qui précède est utilisé par :";
		}
		{
			String _name = "valueTip";
			String _text = "Valeur du produit";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valeur du produit, ce produit a une valeur fluctuante ; ainsi, les marchands peuvent offrir ou acheter à un prix compris dans cette fourchette";
		}
		{
			String _name = "weightTip";
			String _text = "Poids du produit";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantité de produit produite par des travailleurs éduqués ou non éduqués";
		}
		{
			String _name = "qualityTip";
			String _text = "Qualité de l'outil et durée de vie utile, plus le nombre est élevé, meilleure est la qualité et plus longue est la durée de vie utile de l'outil.";
		}
		{
			String _name = "CopperTool01";
			String _text = "Outil en cuivre";
		}
		{
			String _name = "CopperTool00Tip";
			String _text = "Les outils en cuivre peuvent être fabriqués simplement, en contournant la fonte du cuivre, un forgeron peut fabriquer des outils en cuivre directement à partir de minerai de cuivre, d'une bûche et de bois de chauffage dans certains bâtiments.";
