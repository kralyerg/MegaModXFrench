			String _text = "Chaux";
		}
		{
			String _name = "Lime00Tip";
			String _text = "La chaux, fabriquée en exposant de la pierre tendre à la chaleur, utilise la limite matériaux bruts pour contrôler la production. Incroyablement utile pour de nombreuses applications différentes.";
		}
		{
			String _name = "column2text12";
