	Entry _strings
	[	
		//buildings
		{ String _name = "EBSVTannery";									String _text = "Tannerie du Village";	}
		{ String _name = "EBSVTanneryLwr";								String _text = "tannerie du village";	}
		{ String _name = "EBSVTanneryTip";								String _text = "La Tannerie du Village produit du Cuir Tanné. 1 Tanneur peut être employé pour produire 1 Cuir Tanné à partir de 1 Cuir, 1 Eau et 3 Sel. Cycles de Construction : 50. 2 Variations de Couleur (Touche F).";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "Mine de Sel du Village";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "mine de sel du village";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "La Mine de Sel du Village extrait du Sel d'un gisement de sel. Jusqu'à 2 Travailleurs peuvent être employés pour extraire et traiter le Sel. Production : 8 à 12 Sel. Cycles de Construction : 52. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVWaterWell";								String _text = "Puits du Village";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "puits du village";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "Le Puits du Village contient de l'eau. 1 Travailleur peut être employé pour recueillir 12 à 16 Eau du Puits. Cycles de Construction : 42. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVShoemaker";								String _text = "Cordonnerie du Village";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "cordonnerie du village";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "La Cordonnerie du Village produit des Chaussures. 1 Cordonnier peut être employé pour produire divers types de chaussures à partir de Cuir, d'Huile de Lin et de Cuir Tanné. Cycles de Construction : 50. 2 Variations de Couleur (Touche F).";  }
		
		{ String _name = "EBSVOilPress";								String _text = "Pressoir à Huile du Village";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "pressoir à huile du village";	}
		{ String _name = "EBSVOilPressTip";								String _text = "Le Pressoir à Huile du Village produit 14 à 18 Huile Végétale à partir de 25 Graines de Tournesol et 1 Amphore, 14 à 18 Huile de Pépins à partir de 25 Noix de Pécan, ou 25 Noix et 1 Amphore, ou 14 à 18 Huile de Lin à partir de 25 Lin et 1 Amphore. Jusqu'à 2 Presseurs peuvent être employés pour produire 18 à 24 Huile de Pépins à partir de Noix de Pécan ou de Noix, produire 18 à 24 Huile Végétale à partir de 50 Graines de Tournesol, produire 18 à 24 Huile de Lin à partir de 50 Lin. Cycles de Construction : 48. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVSandPit";									String _text = "Carrière de Sable du Village"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "carrière de sable du village"; }
		{ String _name = "EBSVSandPitTip";								String _text = "La Carrière de Sable du Village produit du Sable. Jusqu'à 3 Travailleurs peuvent être employés pour produire 5 à 7 Sable. Cycles de Construction : 36. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVPottery";									String _text = "Poterie du Village";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "poterie du village";	}
		{ String _name = "EBSVPotteryTip";								String _text = "La Poterie du Village produit des Amphores. 1 Potier peut être employé pour produire 3 à 4 Amphores à partir de 4 Argile et 1 Charbon ou 1 Charbon de Bois. Cycles de Construction : 50. 2 Variations de Couleur (Touche F).";  }
		
		{ String _name = "EBSVKiln";									String _text = "Four du Village";	}
		{ String _name = "EBSVKilnLwr";									String _text = "four du village";	}
		{ String _name = "EBSVKilnTip";									String _text = "Le Four du Village produit des Briques. 1 Travailleur peut être employé pour produire des Briques à partir d'Argile et de Combustible. Cycles de Construction : 50. 2 Variations de Couleur (Touche F).";  }
		
		{ String _name = "EBSVClayPit";									String _text = "Carrière d'Argile du Village"; }
		{ String _name = "EBSVClayPitLwr";								String _text = "carrière d'argile du village"; }
		{ String _name = "EBSVClayPitTip";								String _text = "La Carrière d'Argile du Village produit de l'Argile. Jusqu'à 3 Travailleurs peuvent être employés pour produire 5 à 7 Argile. Cycles de Construction : 36. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVApiary";									String _text = "Rucher du Village"; }
		{ String _name = "EBSVApiaryLwr";								String _text = "rucher du village"; }
		{ String _name = "EBSVApiaryTip";								String _text = "Un Rucher du Village est utilisé pour élever des abeilles et produire du miel. Jusqu'à 2 Apiculteurs peuvent être employés pour produire 16 à 22 Miel. Cycles de Construction : 46. 2 Variations de Couleur (Touche F)."; }
		
		{ String _name = "EBSVPreservist";								String _text = "Conservateur du Village"; }
		{ String _name = "EBSVPreservistLwr";							String _text = "conservateur du village"; }
		{ String _name = "EBSVPreservistTip";							String _text = "Le Conservateur du Village produit de la Viande en Conserve ou des Fruits en Conserve. Jusqu'à 2 Conservateurs peuvent être employés pour produire 12 à 14 Viande en Conserve à partir de 7 Venaison, Mouton, Bœuf ou Poulet, 2 Sel et 1 Amphore, ou 10 à 14 Fruits en Conserve à partir de 7 Prunes, Poires ou Pêches, 2 Miel et 1 Amphore. Cycles de Construction : 52. 2 Variations de Couleur (Touche F)."; }
		
